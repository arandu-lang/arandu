//! Memory-ordered atomic synchronization types and operations.
//!
//! ## Overview
//!
//! `std.core.atomic` provides fundamental atomic types for low-level
//! synchronization across threads and signal handlers:
//! - `AtomicBool`
//! - `AtomicInt` (32-bit signed)
//! - `AtomicUint` (32-bit unsigned)
//! - `AtomicUsize` (pointer-sized unsigned integer)
//! - `AtomicI64` (64-bit signed)
//! - `AtomicU64` (64-bit unsigned)
//! - `AtomicPtr<T>` (raw pointer)
//!
//! Operations take a `MemoryOrder` specifying synchronization semantics:
//! - `Relaxed`: No ordering constraints; only atomicity is guaranteed.
//! - `Acquire`: Synchronizes with `Release` writes; subsequent reads/writes cannot be reordered before this read.
//! - `Release`: Synchronizes with `Acquire` reads; prior reads/writes cannot be reordered after this write.
//! - `AcqRel`: Combines `Acquire` and `Release` on read-modify-write operations.
//! - `SeqCst`: Globally consistent total ordering across all threads.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.atomic as atomic
//!
//! let mut counter = atomic.AtomicUsize.new(0)
//! counter.fetchAdd(1, atomic.MemoryOrder.Release)
//! let current = counter.load(atomic.MemoryOrder.Acquire)
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! C, Cranelift and Wasm lower operations to real atomic instructions/builtins.
//! This implementation strengthens all admitted orders to SeqCst. The Wasm
//! module still owns unshared memory; these APIs do not enable shared-memory
//! threads or an OS thread runtime. Wasm engines must support atomic opcodes.
//!
//! Writes retain exclusive receivers. Copying/moving a wrapper is permitted
//! only under ordinary borrow rules, without a live exclusive borrow. Shared
//! mutable access is reserved for audited unsafe internals (for example Arc).
//! Invalid load/store/CAS/fence orders trap before accessing memory.
//!
//! ## See also
//! - `std.core.cell` — interior mutability without thread safety
//! - `std.runtime.mutex` — high-level cooperative mutex
module std.core.atomic

import std.core.intrinsics as intrinsics

/// Memory synchronization ordering for atomic operations.
public enum MemoryOrder {
    /// Relaxed ordering: guarantees atomicity, but no memory barriers.
    Relaxed,
    /// Acquire ordering: acquires a release sequence, ensuring subsequent accesses see prior writes.
    Acquire,
    /// Release ordering: releases prior writes to acquiring threads.
    Release,
    /// Acquire-Release ordering: both acquires and releases on read-modify-write.
    AcqRel,
    /// Sequentially Consistent ordering: total global execution order across all threads.
    SeqCst,
}

func requireLoad(order: MemoryOrder): void {
    match order {
        MemoryOrder.Relaxed => { return }
        MemoryOrder.Acquire => { return }
        MemoryOrder.SeqCst => { return }
        _ => { unsafe { intrinsics.abort() } }
    }
}

func requireStore(order: MemoryOrder): void {
    match order {
        MemoryOrder.Relaxed => { return }
        MemoryOrder.Release => { return }
        MemoryOrder.SeqCst => { return }
        _ => { unsafe { intrinsics.abort() } }
    }
}

func requireFence(order: MemoryOrder): void {
    match order {
        MemoryOrder.Relaxed => { unsafe { intrinsics.abort() } }
        _ => { return }
    }
}

func requireCompareExchange(success: MemoryOrder, failure: MemoryOrder): void {
    match failure {
        MemoryOrder.Relaxed => { return }
        MemoryOrder.Acquire => {
            match success {
                MemoryOrder.Acquire => { return }
                MemoryOrder.AcqRel => { return }
                MemoryOrder.SeqCst => { return }
                _ => { unsafe { intrinsics.abort() } }
            }
        }
        MemoryOrder.SeqCst => {
            match success {
                MemoryOrder.SeqCst => { return }
                _ => { unsafe { intrinsics.abort() } }
            }
        }
        _ => { unsafe { intrinsics.abort() } }
    }
}

/// Hardware fence. Relaxed is invalid and traps.
public func fence(order: MemoryOrder): void {
    requireFence(order)
    unsafe { intrinsics.atomicFence() }
}

/// Compiler fence; Cranelift/Wasm conservatively strengthen it to hardware.
public func compilerFence(order: MemoryOrder): void {
    requireFence(order)
    unsafe { intrinsics.atomicCompilerFence() }
}

func encodeBool(value: bool): u8 { if value { return 1 as u8 }; return 0 as u8 }

/// Naturally aligned atomic storage; fields cannot be accessed non-atomically.
public struct AtomicBool { private val: u8 }

/// Creates independently owned atomic storage.
public func AtomicBool.new(val: bool): AtomicBool {
    unsafe { return AtomicBool { val: encodeBool(val) } }
}

/// Loads atomically. Release and AcqRel are invalid.
public func AtomicBool.load(self: ref AtomicBool, order: MemoryOrder): bool {
    requireLoad(order)
    unsafe { return (intrinsics.atomicLoad8(ref self.val) != (0 as u8)) }
}

/// Stores atomically. Acquire and AcqRel are invalid.
public func AtomicBool.store(self: mut ref AtomicBool, val: bool, order: MemoryOrder): void {
    requireStore(order)
    unsafe { intrinsics.atomicStore8(mut ref self.val, encodeBool(val)) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicBool.swap(self: mut ref AtomicBool, val: bool, order: MemoryOrder): bool {
    unsafe { return (intrinsics.atomicSwap8(mut ref self.val, encodeBool(val)) != (0 as u8)) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicBool.fetchAnd(self: mut ref AtomicBool, val: bool, order: MemoryOrder): bool {
    unsafe { return (intrinsics.atomicFetchAnd8(mut ref self.val, encodeBool(val)) != (0 as u8)) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicBool.fetchOr(self: mut ref AtomicBool, val: bool, order: MemoryOrder): bool {
    unsafe { return (intrinsics.atomicFetchOr8(mut ref self.val, encodeBool(val)) != (0 as u8)) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicBool.fetchXor(self: mut ref AtomicBool, val: bool, order: MemoryOrder): bool {
    unsafe { return (intrinsics.atomicFetchXor8(mut ref self.val, encodeBool(val)) != (0 as u8)) }
}

/// Strong compare-and-exchange. Failure order cannot exceed success order.
public func AtomicBool.compareExchange(self: mut ref AtomicBool, expected: bool, desired: bool, success: MemoryOrder, failure: MemoryOrder): Result<bool, bool> {
    requireCompareExchange(success, failure)
    unsafe {
        let observed = intrinsics.atomicCompareExchange8(mut ref self.val, encodeBool(expected), encodeBool(desired))
        if observed == encodeBool(expected) { return Result.Ok((observed != (0 as u8))) }
        return Result.Err((observed != (0 as u8)))
    }
}

/// Weak CAS uses the permitted non-spurious strong implementation.
public func AtomicBool.compareExchangeWeak(self: mut ref AtomicBool, expected: bool, desired: bool, success: MemoryOrder, failure: MemoryOrder): Result<bool, bool> {
    return self.compareExchange(expected, desired, success, failure)
}

/// Naturally aligned atomic storage; fields cannot be accessed non-atomically.
public struct AtomicInt { private val: u32 }

/// Creates independently owned atomic storage.
public func AtomicInt.new(val: int): AtomicInt {
    unsafe { return AtomicInt { val: (val as u32) } }
}

/// Loads atomically. Release and AcqRel are invalid.
public func AtomicInt.load(self: ref AtomicInt, order: MemoryOrder): int {
    requireLoad(order)
    unsafe { return (intrinsics.atomicLoad32(ref self.val) as int) }
}

/// Stores atomically. Acquire and AcqRel are invalid.
public func AtomicInt.store(self: mut ref AtomicInt, val: int, order: MemoryOrder): void {
    requireStore(order)
    unsafe { intrinsics.atomicStore32(mut ref self.val, (val as u32)) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.swap(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicSwap32(mut ref self.val, (val as u32)) as int) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.fetchAdd(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicFetchAdd32(mut ref self.val, (val as u32)) as int) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.fetchSub(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicFetchSub32(mut ref self.val, (val as u32)) as int) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.fetchAnd(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicFetchAnd32(mut ref self.val, (val as u32)) as int) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.fetchOr(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicFetchOr32(mut ref self.val, (val as u32)) as int) }
}

/// Atomically updates storage and returns its previous value.
public func AtomicInt.fetchXor(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    unsafe { return (intrinsics.atomicFetchXor32(mut ref self.val, (val as u32)) as int) }
}

/// Strong compare-and-exchange. Failure order cannot exceed success order.
public func AtomicInt.compareExchange(self: mut ref AtomicInt, expected: int, desired: int, success: MemoryOrder, failure: MemoryOrder): Result<int, int> {
    requireCompareExchange(success, failure)
    unsafe {
        let observed = intrinsics.atomicCompareExchange32(mut ref self.val, (expected as u32), (desired as u32))
        if observed == (expected as u32) { return Result.Ok((observed as int)) }
        return Result.Err((observed as int))
    }
}

/// Weak CAS uses the permitted non-spurious strong implementation.
public func AtomicInt.compareExchangeWeak(self: mut ref AtomicInt, expected: int, desired: int, success: MemoryOrder, failure: MemoryOrder): Result<int, int> {
    return self.compareExchange(expected, desired, success, failure)
}

