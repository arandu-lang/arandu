//! Portable 128-bit SIMD vector primitives.
//!
//! ## Overview
//!
//! Prototype scalar lane operations. F32x4 currently stores four `float`
//! values (target-dependent width), and U8x16 stores sixteen bytes. Neither
//! representation has a compiler-enforced 16-byte alignment or vector ABI.
//! No direct SSE/NEON/v128 lowering is implemented by this module yet.
//!
//! ## Examples
//!
//! ```arandu
//! import std.core.simd as simd
//!
//! let a = simd.F32x4.splat(2.0)
//! let b = simd.F32x4.splat(3.0)
//! let c = a.add(b) // [5.0, 5.0, 5.0, 5.0]
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
module std.core.simd

/// Prototype of four scalar float lanes; not yet a hardware f32x4 type.
public struct F32x4 {
    lane0: float,
    lane1: float,
    lane2: float,
    lane3: float,
}

/// Creates a `F32x4` with individual lane values.
public func F32x4.new(x: float, y: float, z: float, w: float): F32x4 {
    return F32x4 {
        lane0: x,
        lane1: y,
        lane2: z,
        lane3: w,
    }
}

/// Broadcasts `val` across all four lanes.
public func F32x4.splat(val: float): F32x4 {
    return F32x4 {
        lane0: val,
        lane1: val,
        lane2: val,
        lane3: val,
    }
}

/// Lane-wise addition: `self + other`.
public func F32x4.add(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: self.lane0 + other.lane0,
        lane1: self.lane1 + other.lane1,
        lane2: self.lane2 + other.lane2,
        lane3: self.lane3 + other.lane3,
    }
}

/// Lane-wise subtraction: `self - other`.
public func F32x4.sub(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: self.lane0 - other.lane0,
        lane1: self.lane1 - other.lane1,
        lane2: self.lane2 - other.lane2,
        lane3: self.lane3 - other.lane3,
    }
}

/// Lane-wise multiplication: `self * other`.
public func F32x4.mul(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: self.lane0 * other.lane0,
        lane1: self.lane1 * other.lane1,
        lane2: self.lane2 * other.lane2,
        lane3: self.lane3 * other.lane3,
    }
}

/// Lane-wise division: `self / other`.
public func F32x4.div(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: self.lane0 / other.lane0,
        lane1: self.lane1 / other.lane1,
        lane2: self.lane2 / other.lane2,
        lane3: self.lane3 / other.lane3,
    }
}

/// Lane-wise negation: `-self`.
public func F32x4.neg(self: F32x4): F32x4 {
    return F32x4 {
        lane0: -self.lane0,
        lane1: -self.lane1,
        lane2: -self.lane2,
        lane3: -self.lane3,
    }
}

/// Lane-wise minimum.
public func F32x4.min(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: if self.lane0 < other.lane0 { self.lane0 } else { other.lane0 },
        lane1: if self.lane1 < other.lane1 { self.lane1 } else { other.lane1 },
        lane2: if self.lane2 < other.lane2 { self.lane2 } else { other.lane2 },
        lane3: if self.lane3 < other.lane3 { self.lane3 } else { other.lane3 },
    }
}

/// Lane-wise maximum.
public func F32x4.max(self: F32x4, other: F32x4): F32x4 {
    return F32x4 {
        lane0: if self.lane0 > other.lane0 { self.lane0 } else { other.lane0 },
        lane1: if self.lane1 > other.lane1 { self.lane1 } else { other.lane1 },
        lane2: if self.lane2 > other.lane2 { self.lane2 } else { other.lane2 },
        lane3: if self.lane3 > other.lane3 { self.lane3 } else { other.lane3 },
    }
}

/// Computes the 4-dimensional dot product of two vectors: `x0*y0 + x1*y1 + x2*y2 + x3*y3`.
public func F32x4.dot(self: F32x4, other: F32x4): float {
    return self.lane0 * other.lane0 +
           self.lane1 * other.lane1 +
           self.lane2 * other.lane2 +
           self.lane3 * other.lane3
}

/// Extracts a single lane by index (0..3).
public func F32x4.extractLane(self: F32x4, index: int): float {
    if index == 0 { return self.lane0 }
    if index == 1 { return self.lane1 }
    if index == 2 { return self.lane2 }
    return self.lane3
}

/// Returns a copy of `self` with lane at `index` replaced by `val`.
public func F32x4.replaceLane(self: F32x4, index: int, val: float): F32x4 {
    return F32x4 {
        lane0: if index == 0 { val } else { self.lane0 },
        lane1: if index == 1 { val } else { self.lane1 },
        lane2: if index == 2 { val } else { self.lane2 },
        lane3: if index == 3 { val } else { self.lane3 },
    }
}

// ── U8x16 (16 x 8-bit unsigned integers) ───────────────────────────────────

/// A 128-bit vector of sixteen 8-bit unsigned integers.
public struct U8x16 {
    b0: u8, b1: u8, b2: u8, b3: u8,
    b4: u8, b5: u8, b6: u8, b7: u8,
    b8: u8, b9: u8, b10: u8, b11: u8,
    b12: u8, b13: u8, b14: u8, b15: u8,
}

/// Broadcasts `val` across all 16 lanes.
public func U8x16.splat(val: u8): U8x16 {
    return U8x16 {
        b0: val, b1: val, b2: val, b3: val,
        b4: val, b5: val, b6: val, b7: val,
        b8: val, b9: val, b10: val, b11: val,
        b12: val, b13: val, b14: val, b15: val,
    }
}

/// Lane-wise addition with 8-bit wrapping.
public func U8x16.add(self: U8x16, other: U8x16): U8x16 {
    return U8x16 {
        b0: self.b0 + other.b0, b1: self.b1 + other.b1,
        b2: self.b2 + other.b2, b3: self.b3 + other.b3,
        b4: self.b4 + other.b4, b5: self.b5 + other.b5,
        b6: self.b6 + other.b6, b7: self.b7 + other.b7,
        b8: self.b8 + other.b8, b9: self.b9 + other.b9,
        b10: self.b10 + other.b10, b11: self.b11 + other.b11,
        b12: self.b12 + other.b12, b13: self.b13 + other.b13,
        b14: self.b14 + other.b14, b15: self.b15 + other.b15,
    }
}

/// Lane-wise subtraction with 8-bit wrapping.
public func U8x16.sub(self: U8x16, other: U8x16): U8x16 {
    return U8x16 {
        b0: self.b0 - other.b0, b1: self.b1 - other.b1,
        b2: self.b2 - other.b2, b3: self.b3 - other.b3,
        b4: self.b4 - other.b4, b5: self.b5 - other.b5,
        b6: self.b6 - other.b6, b7: self.b7 - other.b7,
        b8: self.b8 - other.b8, b9: self.b9 - other.b9,
        b10: self.b10 - other.b10, b11: self.b11 - other.b11,
        b12: self.b12 - other.b12, b13: self.b13 - other.b13,
        b14: self.b14 - other.b14, b15: self.b15 - other.b15,
    }
}

/// Extracts a single byte lane by index (0..15).
public func U8x16.extractLane(self: U8x16, index: int): u8 {
    if index == 0 { return self.b0 }
    if index == 1 { return self.b1 }
    if index == 2 { return self.b2 }
    if index == 3 { return self.b3 }
    if index == 4 { return self.b4 }
    if index == 5 { return self.b5 }
    if index == 6 { return self.b6 }
    if index == 7 { return self.b7 }
    if index == 8 { return self.b8 }
    if index == 9 { return self.b9 }
    if index == 10 { return self.b10 }
    if index == 11 { return self.b11 }
    if index == 12 { return self.b12 }
    if index == 13 { return self.b13 }
    if index == 14 { return self.b14 }
    return self.b15
}

/// Returns a copy of `self` with lane at `index` replaced by `val`.
public func U8x16.replaceLane(self: U8x16, index: int, val: u8): U8x16 {
    return U8x16 {
        b0: if index == 0 { val } else { self.b0 },
        b1: if index == 1 { val } else { self.b1 },
        b2: if index == 2 { val } else { self.b2 },
        b3: if index == 3 { val } else { self.b3 },
        b4: if index == 4 { val } else { self.b4 },
        b5: if index == 5 { val } else { self.b5 },
        b6: if index == 6 { val } else { self.b6 },
        b7: if index == 7 { val } else { self.b7 },
        b8: if index == 8 { val } else { self.b8 },
        b9: if index == 9 { val } else { self.b9 },
        b10: if index == 10 { val } else { self.b10 },
        b11: if index == 11 { val } else { self.b11 },
        b12: if index == 12 { val } else { self.b12 },
        b13: if index == 13 { val } else { self.b13 },
        b14: if index == 14 { val } else { self.b14 },
        b15: if index == 15 { val } else { self.b15 },
    }
}
