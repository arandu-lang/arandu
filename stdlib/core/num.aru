public func i32.overflowingAdd(self: i32, other: i32): (i32, bool) {
    return intrinsics.addWithOverflowI32(self, other)
}

/// Wrapping difference and overflow flag.
public func i32.overflowingSub(self: i32, other: i32): (i32, bool) {
