//! Compiler-mapped builtins: fatal traps, memory access and conversions.
//!
//! ## Overview
//!
//! `std.core.intrinsics` exposes operations with no Arandu implementation —
//! they are emitted directly as native instructions by the compiler through
//! the `extern "arandu-intrinsic"` mechanism. No heap allocation happens here.
//!
//! ## Safety
//!
//! Most functions in this module require `unsafe {}`. Misuse causes
//! undefined behavior or an immediate trap. Do not use directly in application
//! code — prefer the safe abstractions in `std.core.mem`, `std.core.slice`
//! and `std.core.str`.
//!
//! The following intrinsics are **safe** (no `unsafe {}` required):
//! - `bitCountOnes*`, `bitLeadingZeros*`, `bitTrailingZeros*`, `bitReverse*` — pure integer operations.
//! - `sliceLen` — reads the `len` field of an already-validated fat-pointer.
//! - `strBytes` — reinterprets a `str` fat-pointer as `[]u8`; no deref occurs.
//! - `sizeOf` — compile-time constant; no runtime memory access.
//! - `alignOf` — compile-time constant; no runtime memory access.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Mapped per target: UD2, LOCK and SSE on x86-64; BRK and LDAXR on aarch64;
//! `unreachable` and `memory.*` on wasm32.
//!
//! ## See also
//!
//! - `std.core.mem` — safe wrapper over memory intrinsics
//! - `std.core.pointer` — raw-pointer utilities
//! - `std.core.slice` — bounds-checked slices
module std.core.intrinsics

extern "arandu-intrinsic" {
    /// Number of set bits; pure, safe, allocation-free.
    func bitCountOnes32(value: u32): u32
    func bitCountOnes64(value: u64): u32
    /// Leading zeros; zero returns 32 or 64.
    func bitLeadingZeros32(value: u32): u32
    func bitLeadingZeros64(value: u64): u32
    /// Trailing zeros; zero returns 32 or 64.
    func bitTrailingZeros32(value: u32): u32
    func bitTrailingZeros64(value: u64): u32
    /// Reverses every bit, including leading zeros.
    func bitReverse32(value: u32): u32
    func bitReverse64(value: u64): u64

    /// Unconditional fatal trap (out-of-bounds, failed assertions, etc.).
    func abort(): void

    /// Generational ref mismatch trap: slot was recycled (use-after-free detected).
    /// Used by `std.alloc.gen_arena` verification paths and compiler-lowered `GenGet` nodes.
    func abortGenerationalMismatch(): void
    /// Builds a slice view from a raw pointer and length. The memory must
    /// stay valid for as long as the slice is used.
    func sliceFromRaw<Owner, T>(owner: ref Owner, data: ptr[T], len: usize): []T
    /// Returns the element count of a slice without reading its contents.
    ///
    /// **Safe**: only reads the `len` field of the fat-pointer descriptor;
    /// the element data is never dereferenced.
    func sliceLen<T>(source: []T): usize
    /// Returns the raw pointer to a slice's first element, if any.
    func sliceData<T>(source: []T): ptr[T]
    /// Builds a sub-view over a slice range. Out-of-range bounds trap.
    func sliceSubslice<T>(source: []T, start: usize, len: usize): []T
    /// Borrows the UTF-8 storage of `source` as bytes without allocating.
    ///
    /// **Safe**: reinterprets the `str` fat-pointer descriptor as `[]u8`;
    /// the byte data is not dereferenced and no invariant can be violated.
    func strBytes(source: str): []u8
    /// Borrows `source` as an immutable `str` view tied to its owner.
    func strView<Owner>(owner: ref Owner): ref str

    /// Runs the destructor of `*p` in-place without deallocating `p`.
    func dropInPlace<T>(p: ptr[T]): void

    /// Exposes the address behind an exclusive reference to low-level
    /// container implementations. Dereferencing or retaining the pointer
    /// beyond the exclusive borrow requires `unsafe`.
    func addressOf<T>(value: mut ref T): ptr[T]
}
