import std.alloc.string as strings
import std.core.mem as mem
import std.core.slice as slice
import std.core.str as core_str

func main(): int {
    let mut text = strings.String.new()
    if !text.pushStr("Arandu") {
        return -1
    }
    if text.len() != 6 as usize {
        return -2
    }
    let bytes = text.asBytes()
    let first_byte = unsafe { mem.ptrRead<u8>(slice.asPtr<u8>(bytes)) }
    if first_byte != 65 as u8 {
        return 100 as int + first_byte as int
    }
    if core_str.len(text.asStr()) != 6 as usize {
        return -9
    }
    if !core_str.startsWith(text.asStr(), "Aran") {
        return -10
    }
    if !core_str.contains(text.asStr(), "and") {
        return -11
    }
    if !core_str.endsWith(text.asStr(), "du") {
        return -12
    }

    text.pushScalar('é')
    if text.len() != 8 as usize {
        return -3
    }
    text.pushScalar('🦀')
    if text.len() != 12 as usize {
        return -4
    }
    let grown_bytes = text.asBytes()
    if slice.len<u8>(grown_bytes) != 12 as usize {
        return -13
    }
    if core_str.len(text.asStr()) != 12 as usize
        || !core_str.endsWith(text.asStr(), "🦀")
    {
        return -14
    }

    text.truncate(7 as usize)
    if text.len() != 12 as usize {
        return -5
    }
    text.truncate(8 as usize)
    if text.len() != 8 as usize {
        return -6
    }

    let old_capacity = text.capacity()
    if text.tryReserve(2147483647 as usize) || text.capacity() != old_capacity {
        return -7
    }
    text.clear()
    if !text.isEmpty() || text.len() != 0 as usize || text.capacity() != old_capacity {
        return -8
    }

    return 0
}
