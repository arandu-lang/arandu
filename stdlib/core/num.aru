/// Parses a signed 32-bit decimal integer from a UTF-8 string view.
/// Returns `Option.None` if `s` is empty, contains non-digit characters, or overflows `int`.
public func parse(s: str): Option<int> {
    let bytes = intrinsics.strBytes(s)
    let n = bytes.len
    if n == 0 {
        return Option.None
    }
    let mut i: usize = 0
    let mut negative = false
    if bytes[0] == b'-' {
        negative = true
        i = 1
    } else if bytes[0] == b'+' {
        i = 1
    }
    if i >= n {
        return Option.None
    }
    let mut acc: int = 0
    while i < n {
        let ch = bytes[i]
        if ch < b'0' || ch > b'9' {
            return Option.None
        }
        let digit = (ch - b'0') as int
        let .Some(scaled) = checkedMul(acc, 10) else {
            return Option.None
        }
        if negative {
            let .Some(next) = checkedSub(scaled, digit) else {
                return Option.None
            }
            acc = next
        } else {
            let .Some(next) = checkedAdd(scaled, digit) else {
                return Option.None
            }
            acc = next
        }
        i = i + 1
    }
    return Option.Some(acc)
}

/// Parses a signed 32-bit decimal integer (`int.parse(s)`).
public func int.parse(s: str): Option<int> {
    return parse(s)
}

/// Checked integer addition.
public func i32.checkedAdd(self: i32, other: i32): Option<i32> {
    let pair = intrinsics.addWithOverflowI32(self, other)
    if pair.1 { return Option.None }
    return Option.Some(pair.0)
}

/// Checked integer subtraction.
public func i32.checkedSub(self: i32, other: i32): Option<i32> {
    let pair = intrinsics.subWithOverflowI32(self, other)
    if pair.1 { return Option.None }
    return Option.Some(pair.0)
}

/// Checked integer multiplication.
public func i32.checkedMul(self: i32, other: i32): Option<i32> {
    let pair = intrinsics.mulWithOverflowI32(self, other)
    if pair.1 { return Option.None }
    return Option.Some(pair.0)
}

