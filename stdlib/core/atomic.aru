// ── AtomicPtr<T> ───────────────────────────────────────────────────────────

/// An atomic raw pointer wrapper.
public struct AtomicPtr<T> {
    val: ptr[T]
}

/// Creates a new `AtomicPtr`.
public func AtomicPtr.new<T>(val: ptr[T]): AtomicPtr<T> {
    return AtomicPtr<T> { val: val }
}

/// Reads the stored pointer with the given memory ordering.
public func AtomicPtr.load<T>(self: ref AtomicPtr<T>, order: MemoryOrder): ptr[T] {
    return self.val
}

/// Writes the stored pointer with the given memory ordering.
public func AtomicPtr.store<T>(self: mut ref AtomicPtr<T>, val: ptr[T], order: MemoryOrder): void {
    self.val = val
}

/// Atomically swaps the pointer, returning the previous address.
public func AtomicPtr.swap<T>(self: mut ref AtomicPtr<T>, val: ptr[T], order: MemoryOrder): ptr[T] {
    let old = self.val
    self.val = val
    return old
}
