//! Checked and saturating integer arithmetic.
//!
//! ## Overview
//!
//! `std.core.num` exposes arithmetic operations that detect overflow instead of
//! silencing it. Every `checked*` function returns `Option<T>` — `Some(value)`
//! on success and `None` on overflow — enabling explicit handling without
//! resorting to undefined behavior. The `saturating*` variants clamp to the
//! type bounds instead.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.num as num
//!
//! let r = num.checkedAdd(2147483647, 1)
//! // r == Option.None  (overflow detected)
//!
//! let s = num.saturatingAdd(2147483647, 1)
//! // s == 2147483647  (saturated at the bound)
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Behaves identically on 32- and 64-bit targets.
//!
//! ## See also
//!
//! - `std.core.fixed` — FPU-free fixed-point arithmetic
//! - `std.core.cmp` — comparison and ordering
module std.core.num

import std.core.intrinsics as intrinsics

func intMax(): int {
    return 2147483647
}

func intMin(): int {
    return -2147483647 - 1
}

/// Checked integer addition.
///
/// Returns `Option.Some(a + b)` if the operation does not overflow the target integer bounds,
/// or `Option.None` on arithmetic overflow or underflow.
///
/// # Examples
/// ```arandu
/// num.checkedAdd(10, 20) // Some(30)
/// num.checkedAdd(-5, 2)  // Some(-3)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedAdd(a: int, b: int): Option<int> {
    if (b > 0 && a > intMax() - b) || (b < 0 && a < intMin() - b) {
        return Option.None
    }
    return Option.Some(a + b)
}

/// Checked integer subtraction.
///
/// Returns `Option.Some(a - b)` if the operation does not overflow or underflow,
/// or `Option.None` on arithmetic overflow.
///
/// # Examples
/// ```arandu
/// num.checkedSub(20, 10) // Some(10)
/// num.checkedSub(5, 10)  // Some(-5)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedSub(a: int, b: int): Option<int> {
    if (b > 0 && a < intMin() + b) || (b < 0 && a > intMax() + b) {
        return Option.None
    }
    return Option.Some(a - b)
}

/// Checked integer multiplication.
///
/// Returns `Option.Some(a * b)` if the operation does not overflow,
/// or `Option.None` on arithmetic overflow.
///
/// # Examples
/// ```arandu
/// num.checkedMul(6, 7) // Some(42)
/// num.checkedMul(0, 100) // Some(0)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedMul(a: int, b: int): Option<int> {
    if a == 0 || b == 0 {
        return Option.Some(0)
    }
    let max = intMax()
    let min = intMin()
    if (a == -1 && b == min) || (b == -1 && a == min) {
        return Option.None
    }
    if (a > 0 && b > 0 && a > max / b)
    || (a > 0 && b < 0 && b < min / a)
    || (a < 0 && b > 0 && a < min / b)
    || (a < 0 && b < 0 && a < max / b) {
        return Option.None
    }
    return Option.Some(a * b)
}

/// Saturating integer addition.
///
/// Computes `a + b`, clamping to `intMax()` on positive overflow or `intMin()` on negative overflow.
///
/// # Examples
/// ```arandu
/// num.saturatingAdd(10, 20) // 30
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func saturatingAdd(a: int, b: int): int {
    match checkedAdd(a, b) {
        Some(v) => {
            return v
        }
        None => {
            if b > 0 {
                return intMax()
            }
            return intMin()
        }
    }
}

/// Saturating integer subtraction.
///
/// Computes `a - b`, clamping to `intMax()` on positive overflow or `intMin()` on negative underflow.
///
/// # Examples
/// ```arandu
/// num.saturatingSub(20, 10) // 10
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func saturatingSub(a: int, b: int): int {
    match checkedSub(a, b) {
        Some(v) => {
            return v
        }
        None => {
            if b > 0 {
                return intMin()
            }
            return intMax()
        }
    }
}

/// Returns the magnitude; traps for the unrepresentable magnitude of intMin().
public func abs(value: int): int {
    if value == intMin() { unsafe { intrinsics.abort() } }
    if value < 0 {
        return -value
    }
    return value
}

/// Counts set bits. Pure and allocation-free.
public func countOnes(value: u32): u32 {
    unsafe { return intrinsics.bitCountOnes32(value) }
}

/// Counts set bits. Pure and allocation-free.
public func countOnes64(value: u64): u32 {
    unsafe { return intrinsics.bitCountOnes64(value) }
}

/// Counts leading zero bits; zero returns 32. Pure and allocation-free.
public func leadingZeros(value: u32): u32 {
    unsafe { return intrinsics.bitLeadingZeros32(value) }
}

/// Counts leading zero bits; zero returns 64. Pure and allocation-free.
public func leadingZeros64(value: u64): u32 {
    unsafe { return intrinsics.bitLeadingZeros64(value) }
}

/// Counts trailing zero bits; zero returns 32. Pure and allocation-free.
public func trailingZeros(value: u32): u32 {
    unsafe { return intrinsics.bitTrailingZeros32(value) }
}

/// Counts trailing zero bits; zero returns 64. Pure and allocation-free.
public func trailingZeros64(value: u64): u32 {
    unsafe { return intrinsics.bitTrailingZeros64(value) }
}

/// Reverses all 32 bits. Pure and allocation-free.
public func reverseBits(value: u32): u32 {
    unsafe { return intrinsics.bitReverse32(value) }
}

/// Reverses all 64 bits. Pure and allocation-free.
public func reverseBits64(value: u64): u64 {
    unsafe { return intrinsics.bitReverse64(value) }
}

/// Rotates 32 bits left; `amount` is taken modulo 32. Pure and allocation-free.
public func rotateLeft(value: u32, amount: u32): u32 {
    unsafe { return intrinsics.bitRotateLeft32(value, amount) }
}

/// Rotates 64 bits left; `amount` is taken modulo 64. Pure and allocation-free.
public func rotateLeft64(value: u64, amount: u32): u64 {
    unsafe { return intrinsics.bitRotateLeft64(value, amount) }
}

/// Rotates 32 bits right; `amount` is taken modulo 32. Pure and allocation-free.
public func rotateRight(value: u32, amount: u32): u32 {
    unsafe { return intrinsics.bitRotateRight32(value, amount) }
}

/// Rotates 64 bits right; `amount` is taken modulo 64. Pure and allocation-free.
public func rotateRight64(value: u64, amount: u32): u64 {
    unsafe { return intrinsics.bitRotateRight64(value, amount) }
}

/// Reverses the 4 bytes of `value`. Pure and allocation-free.
public func swapBytes(value: u32): u32 {
    unsafe { return intrinsics.bitSwapBytes32(value) }
}

/// Reverses the 8 bytes of `value`. Pure and allocation-free.
public func swapBytes64(value: u64): u64 {
    unsafe { return intrinsics.bitSwapBytes64(value) }
}

/// Converts `value` to big-endian byte order (network byte order).
public func toBigEndian(value: u32): u32 {
    return swapBytes(value)
}

/// Converts `value` from big-endian byte order (network byte order).
public func fromBigEndian(value: u32): u32 {
    return swapBytes(value)
}

/// Converts `value` to little-endian byte order.
public func toLittleEndian(value: u32): u32 {
    return value
}

/// Converts `value` from little-endian byte order.
public func fromLittleEndian(value: u32): u32 {
    return value
}

/// Reinterprets 64-bit IEEE float bits as an unsigned 64-bit integer (zero-cost bitcast).
public func f64ToBits(value: f64): u64 {
    return intrinsics.f64ToBits(value)
}

/// Reinterprets an unsigned 64-bit integer as a 64-bit IEEE float (zero-cost bitcast).
public func f64FromBits(bits: u64): f64 {
    return intrinsics.f64FromBits(bits)
}

/// Reinterprets 32-bit IEEE float bits as an unsigned 32-bit integer (zero-cost bitcast).
public func f32ToBits(value: f32): u32 {
    return intrinsics.f32ToBits(value)
}

/// Reinterprets an unsigned 32-bit integer as a 32-bit IEEE float (zero-cost bitcast).
public func f32FromBits(bits: u32): f32 {
    return intrinsics.f32FromBits(bits)
}

/// Converts `value` to big-endian byte order (network byte order).
public func toBigEndian64(value: u64): u64 {
    return swapBytes64(value)
}

/// Converts `value` from big-endian byte order (network byte order).
public func fromBigEndian64(value: u64): u64 {
    return swapBytes64(value)
}

/// Converts `value` to little-endian byte order.
public func toLittleEndian64(value: u64): u64 {
    return value
}

/// Converts `value` from little-endian byte order.
public func fromLittleEndian64(value: u64): u64 {
    return value
}

/// Returns None when the magnitude cannot be represented in int.
public func checkedAbs(value: int): Option<int> {
    if value == intMin() { return Option.None }
    if value < 0 { return Option.Some(-value) }
    return Option.Some(value)
}

// ── Inherent methods on `int` ───────────────────────────────────────────────

/// Returns the magnitude; traps for the unrepresentable magnitude of intMin().
public func int.abs(self: int): int {
    return abs(self)
}

/// Checked integer addition.
public func int.checkedAdd(self: int, other: int): Option<int> {
    return checkedAdd(self, other)
}

/// Checked integer subtraction.
public func int.checkedSub(self: int, other: int): Option<int> {
    return checkedSub(self, other)
}

/// Checked integer multiplication.
public func int.checkedMul(self: int, other: int): Option<int> {
    return checkedMul(self, other)
}

/// Wrapping integer addition and overflow flag.
public func int.overflowingAdd(self: int, other: int): (int, bool) {
    let pair = intrinsics.addWithOverflowI32(self as i32, other as i32)
    return (pair.0 as int, pair.1)
}

/// Wrapping integer subtraction and overflow flag.
public func int.overflowingSub(self: int, other: int): (int, bool) {
    let pair = intrinsics.subWithOverflowI32(self as i32, other as i32)
    return (pair.0 as int, pair.1)
}

/// Wrapping integer multiplication and overflow flag.
public func int.overflowingMul(self: int, other: int): (int, bool) {
    let pair = intrinsics.mulWithOverflowI32(self as i32, other as i32)
    return (pair.0 as int, pair.1)
}

/// Saturating integer addition.
public func int.saturatingAdd(self: int, other: int): int {
    return saturatingAdd(self, other)
}

/// Saturating integer subtraction.
public func int.saturatingSub(self: int, other: int): int {
    return saturatingSub(self, other)
}

