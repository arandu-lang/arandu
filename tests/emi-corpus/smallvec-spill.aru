import std.alloc.smallvec as smallvec

func main(): int {
    let mut values = smallvec.SmallVec4<int>.new()
    values.push(10)
    values.push(20)
    values.push(30)
    values.push(40)
    if values.isHeap() || values.len() != 4 as usize || values.capacity() != 4 as usize {
        return -1
    }

    values.push(50)
    if !values.isHeap() || values.len() != 5 as usize || values.capacity() != 8 as usize {
        return -2
    }

    values.push(60)
    values.push(70)
    values.push(80)
    values.push(90)
    if values.len() != 9 as usize || values.capacity() != 16 as usize {
        return -7
    }

    let fifth = match values.get(4 as usize) {
        Some(value) => value
        None => -3
    }
    let tail = match values.get(8 as usize) {
        Some(value) => value
        None => -8
    }
    let popped = match values.pop() {
        Some(value) => value
        None => -4
    }
    let first = match values.get(0 as usize) {
        Some(value) => value
        None => -5
    }
    let valid = fifth == 50 && popped == 90 && first == 10 && tail == 90 && values.len() == 8 as usize
    if valid { return 0 }
    return -6
}
