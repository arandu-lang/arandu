//! TCP streams, listeners, and host socket primitives.
//!
//! ## Overview
//!
//! Typed `TcpStream` and `TcpListener` APIs use `io.IoError`. The current host
//! bridge binds and connects on `127.0.0.1` using a port number; `SocketAddr`
//! is a value type and is not accepted by these connection methods. Raw
//! `tcp*` functions expose host handles and status codes.
//!
//! ## Errors
//! Typed stream and listener operations return `Result<_, io.IoError>` for
//! host failures. Raw bridge functions use integer host status codes and
//! require callers to manage their handles explicitly.
//!
//! ## Safety
//! `tcpRead` and `tcpWrite` accept raw pointers and lengths. The caller must
//! provide a valid buffer for the entire requested range and close raw handles.
//!
//! ## Platform
//! `native`

module std.net

/// High-level, safe TCP networking abstractions + raw host TCP bridge.
///
/// Integrates with `std.io` (`Read`, `Write`, `IoError`, `IoErrorKind`)
/// to provide non-blocking and blocking network socket communications.
///
/// The raw `tcp*` functions (experimental — not Minimal 0.1) are the host
/// bridge formerly shipped inside `std.runtime`; they operate on raw host ids
/// and belong to `std.net` because they describe sockets.

import std.io as io
import std.runtime.waker as waker
import std.core.slice as slice

// ===========================================================================
// experimental — not Minimal 0.1 — Raw host TCP bridge
// ===========================================================================

extern "C" {
    /// Host TCP listener creation for a port.
    func ar_rt_tcp_listen(port: int): int
    /// Host TCP accept operation on a listener handle.
    func ar_rt_tcp_accept(listener: int): int
    /// Host TCP connection operation.
    func ar_rt_tcp_connect(port: int): int
    /// Host TCP read into a caller-provided buffer.
    func ar_rt_tcp_read(sock: int, buf: ptr[u8], len: int): int
    /// Host TCP write from a caller-provided buffer.
    func ar_rt_tcp_write(sock: int, buf: ptr[u8], len: int): int
    /// Host close operation for a TCP handle.
    func ar_rt_tcp_close(sock: int): void
    /// Host control for nonblocking TCP mode.
    func ar_rt_tcp_set_nonblocking(sock: int, flag: int): int
    /// Host wait for TCP readiness or timeout.
    func ar_rt_tcp_wait(sock: int, events: int, timeout_ms: int): int
    /// Host readiness wait that signals a waker.
    func ar_rt_tcp_wait_wake(sock: int, events: int, timeout_ms: int, waker_id: int): int
    /// Host asynchronous TCP read bridge.
    func ar_rt_tcp_read_async(sock: int, buf: ptr[u8], len: int): int
    /// Host asynchronous TCP write bridge.
    func ar_rt_tcp_write_async(sock: int, buf: ptr[u8], len: int): int
}

/// experimental — not Minimal 0.1
public struct RawTcpListener {
    /// Opaque host handle.
    id: int
}

/// experimental — not Minimal 0.1
public struct RawTcpStream {
    /// Opaque host handle.
    id: int
}

/// Wait flags for `tcpWait` / `tcpWaitWake` (bit0=read, bit1=write).
public func tcpWaitReadFlag(): int {
    return 1
}

/// Returns the write-readiness bit used by `tcpWait` and `tcpWaitWake`.
public func tcpWaitWriteFlag(): int {
    return 2
}

/// Listens on loopback (`127.0.0.1`) at `port` and returns a raw handle.
///
/// A negative `id` signals failure, including an invalid port or bind error.
/// Close a successful handle with `RawTcpListener.close`.
public func RawTcpListener.listen(port: int): RawTcpListener {
    return tcpListen(port)
}

func tcpListen(port: int): RawTcpListener {
    unsafe {
        return RawTcpListener { id: ar_rt_tcp_listen(port) }
    }
}

/// Accepts one connection from `self` and returns a raw stream handle.
///
/// A negative `id` signals failure. This may block while waiting for a
/// connection; close a successful stream with `RawTcpStream.close`.
public func RawTcpListener.accept(self: ref RawTcpListener): RawTcpStream {
    return tcpAccept(self)
}

func tcpAccept(l: ref RawTcpListener): RawTcpStream {
    unsafe {
        return RawTcpStream { id: ar_rt_tcp_accept(l.id) }
    }
}

/// Closes a raw listener host handle.
public func RawTcpListener.close(self: ref RawTcpListener): void {
    tcpCloseListener(self)
}

/// Connects to loopback (`127.0.0.1`) at `port`.
///
/// A negative returned `id` signals failure. The caller must close a
/// successful stream with `RawTcpStream.close`.
public func RawTcpStream.connect(port: int): RawTcpStream {
    return tcpConnect(port)
}

func tcpConnect(port: int): RawTcpStream {
    unsafe {
        return RawTcpStream { id: ar_rt_tcp_connect(port) }
    }
}

/// Reads up to `len` bytes into a valid writable raw buffer.
///
/// Returns a byte count, zero at EOF, `-2` for a nonblocking would-block
/// result, or `-1` for another error. A zero-length request returns zero
/// without calling the host; a negative length or null nonempty buffer returns
/// `-1`.
@Unsafe
public func RawTcpStream.read(self: ref RawTcpStream, buf: ptr[u8], len: int): int {
    return unsafe { tcpRead(self, buf, len) }
}

@Unsafe
func tcpRead(s: ref RawTcpStream, buf: ptr[u8], len: int): int {
    let nullp: ptr[u8] = nil
    if len < 0 || (len > 0 && buf == nullp) {
        return -1
    }
    if len == 0 {
        return 0
    }
    unsafe {
        return ar_rt_tcp_read(s.id, buf, len)
    }
}

/// Writes up to `len` bytes from a valid readable raw buffer.
///
/// A successful return may be shorter than `len`; retry the remaining bytes
/// when needed. Returns `-2` for nonblocking would-block or `-1` on error.
@Unsafe
public func RawTcpStream.write(self: ref RawTcpStream, buf: ptr[u8], len: int): int {
    return unsafe { tcpWrite(self, buf, len) }
}

@Unsafe
func tcpWrite(s: ref RawTcpStream, buf: ptr[u8], len: int): int {
    let nullp: ptr[u8] = nil
    if len < 0 || (len > 0 && buf == nullp) {
        return -1
    }
    if len == 0 {
        return 0
    }
    unsafe {
        return ar_rt_tcp_write(s.id, buf, len)
    }
}

/// Reads through the host asynchronous bridge into a valid raw buffer.
///
/// The host may use io_uring when available or fall back to ordinary read.
/// The return uses the same byte-count and negative-status convention as
/// `RawTcpStream.read`.
@Unsafe
public func RawTcpStream.readAsync(self: ref RawTcpStream, buf: ptr[u8], len: int): int {
    return unsafe { tcpReadAsync(self, buf, len) }
}

@Unsafe
func tcpReadAsync(s: ref RawTcpStream, buf: ptr[u8], len: int): int {
    let nullp: ptr[u8] = nil
    if len < 0 || (len > 0 && buf == nullp) {
        return -1
    }
    if len == 0 {
        return 0
    }
    unsafe {
        return ar_rt_tcp_read_async(s.id, buf, len)
    }
}

/// Writes through the host asynchronous bridge from a valid raw buffer.
///
/// The host may use io_uring or ordinary write. A nonnegative return is the
/// number of bytes written and may be shorter than `len`.
@Unsafe
public func RawTcpStream.writeAsync(self: ref RawTcpStream, buf: ptr[u8], len: int): int {
    return unsafe { tcpWriteAsync(self, buf, len) }
}

@Unsafe
func tcpWriteAsync(s: ref RawTcpStream, buf: ptr[u8], len: int): int {
    let nullp: ptr[u8] = nil
    if len < 0 || (len > 0 && buf == nullp) {
        return -1
    }
    if len == 0 {
        return 0
    }
    unsafe {
        return ar_rt_tcp_write_async(s.id, buf, len)
    }
}

/// Enables nonblocking mode when `flag != 0`, otherwise disables it.
///
/// Returns zero on success or `-1` on host failure. In nonblocking mode,
/// raw read and write report would-block with `-2`.
public func RawTcpStream.setNonblocking(self: ref RawTcpStream, flag: int): int {
    return tcpSetNonblocking(self, flag)
}

func tcpSetNonblocking(s: ref RawTcpStream, flag: int): int {
    unsafe {
        return ar_rt_tcp_set_nonblocking(s.id, flag)
    }
}

/// Waits for requested read/write readiness or `timeoutMs` expiration.
///
/// Pass flags from `tcpWaitReadFlag` and `tcpWaitWriteFlag`, combined as
/// needed. Returns ready bits, zero on timeout, or `-1` on error.
public func RawTcpStream.wait(self: ref RawTcpStream, events: int, timeoutMs: int): int {
    return tcpWait(self, events, timeoutMs)
}

func tcpWait(s: ref RawTcpStream, events: int, timeoutMs: int): int {
    unsafe {
        return ar_rt_tcp_wait(s.id, events, timeoutMs)
    }
}

/// Waits for socket readiness and wakes `w` when an event is ready.
///
/// Returns ready event bits, zero on timeout, or `-1` on error, following
/// the same flag convention as `RawTcpStream.wait`.
public func RawTcpStream.waitWake(self: ref RawTcpStream, events: int, timeoutMs: int, w: ref waker.Waker): int {
    return tcpWaitWake(self, events, timeoutMs, w)
}

func tcpWaitWake(s: ref RawTcpStream, events: int, timeoutMs: int, w: ref waker.Waker): int {
    unsafe {
        return ar_rt_tcp_wait_wake(s.id, events, timeoutMs, w.id)
    }
}

func tcpCloseListener(l: ref RawTcpListener): void {
    unsafe {
        ar_rt_tcp_close(l.id)
    }
}

/// Closes a raw stream host handle.
public func RawTcpStream.close(self: ref RawTcpStream): void {
    tcpCloseStream(self)
}

func tcpCloseStream(s: ref RawTcpStream): void {
    unsafe {
        ar_rt_tcp_close(s.id)
    }
}

// ===========================================================================
// High-level, safe wrappers
// ===========================================================================

/// Internet socket address composed of an IP or hostname string and port number.
public struct SocketAddr {
    /// Address or hostname text.
    ip: str
    /// TCP port number.
    port: int
}

/// Stores `ip` and `port` in a value without resolving or connecting.
///
/// Current `TcpStream.connect` and `TcpListener.bind` accept a port only and
/// do not use this address value.
public func SocketAddr.new(ip: str, port: int): SocketAddr {
    return SocketAddr {
        ip: ip,
        port: port,
    }
}

/// A TCP stream between a local and a remote socket.
public struct TcpStream {
    /// Raw host stream wrapped by this typed handle.
    raw: RawTcpStream
}

/// A TCP socket server, listening for connections.
public struct TcpListener {
    /// Raw host listener wrapped by this typed handle.
    raw: RawTcpListener
}

/// Binds a listener on `127.0.0.1:port`.
///
/// Returns `Err(AlreadyExists)` with code `-1` for any host listen failure;
/// this category does not distinguish address-in-use from other causes.
/// Close the successful listener when finished.
public func TcpListener.bind(port: int): Result<TcpListener, io.IoError> {
    let l = tcpListen(port)
    if l.id < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.AlreadyExists, -1))
    }
    return Result.Ok(TcpListener { raw: l })
}

/// Waits for and returns an incoming stream from this listener.
///
/// Returns `Err(Other)` with code `-1` for a host accept failure. Close each
/// accepted stream after use.
public func TcpListener.accept(self: ref TcpListener): Result<TcpStream, io.IoError> {
    let s = tcpAccept(self.raw)
    if s.id < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.Other, -1))
    }
    return Result.Ok(TcpStream { raw: s })
}

/// Closes the listener's host handle and invalidates this wrapper.
///
/// Repeating `close` is harmless. Calls after closing fail with an invalid
/// handle instead of risking access to a later socket that reused the slot.
public func TcpListener.close(self: mut ref TcpListener): void {
    if self.raw.id >= 0 {
        tcpCloseListener(self.raw)
        self.raw.id = -1
    }
}

/// Automatic best-effort destructor invoked when an owned `TcpListener` leaves scope.
@Destructor
func TcpListener.destroy(self: own TcpListener): void {
    if self.raw.id >= 0 {
        tcpCloseListener(self.raw)
    }
}

/// Connects to `127.0.0.1:port` and returns a typed stream.
///
/// Returns `Err(Other)` with code `-1` on any host connection failure.
/// The current API does not accept a remote address or hostname.
public func TcpStream.connect(port: int): Result<TcpStream, io.IoError> {
    let s = tcpConnect(port)
    if s.id < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.Other, -1))
    }
    return Result.Ok(TcpStream { raw: s })
}

/// Reads up to the buffer length and returns the byte count.
///
/// Zero means EOF. A negative host result becomes `Err(BrokenPipe)` with
/// code `-1`, including a nonblocking would-block result; the category is
/// therefore not precise. An empty buffer returns `Ok(0)` without calling the
/// host.
public func TcpStream.read(self: mut ref TcpStream, buf: mut ref []u8): Result<usize, io.IoError> {
    let len = slice.len<u8>(*buf)
    if len == (0 as usize) {
        return Result.Ok(0 as usize)
    }
    if len > (2147483647 as usize) {
        return Result.Err(io.IoError.new(io.IoErrorKind.InvalidInput, 5))
    }
    let n = unsafe { tcpRead(self.raw, slice.asPtr<u8>(*buf), len as int) }
    if n < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.BrokenPipe, -1))
    }
    return Result.Ok(n as usize)
}

/// Reads up to the buffer slice length without double indirection.
public func TcpStream.readSlice(self: mut ref TcpStream, buf: []u8): Result<usize, io.IoError> {
    let len = slice.len<u8>(buf)
    if len == (0 as usize) {
        return Result.Ok(0 as usize)
    }
    if len > (2147483647 as usize) {
        return Result.Err(io.IoError.new(io.IoErrorKind.InvalidInput, 5))
    }
    let n = unsafe { tcpRead(self.raw, slice.asPtr<u8>(buf), len as int) }
    if n < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.BrokenPipe, -1))
    }
    return Result.Ok(n as usize)
}

/// Writes from `buf` and returns the number of bytes accepted.
///
/// A successful write can be short. Any negative host result becomes
/// `Err(BrokenPipe)` with code `-1`, including would-block; retry logic must
/// account for the returned count.
public func TcpStream.write(self: mut ref TcpStream, buf: []u8): Result<usize, io.IoError> {
    let len = slice.len<u8>(buf)
    if len == (0 as usize) {
        return Result.Ok(0 as usize)
    }
    if len > (2147483647 as usize) {
        return Result.Err(io.IoError.new(io.IoErrorKind.InvalidInput, 5))
    }
    let n = unsafe { tcpWrite(self.raw, slice.asPtr<u8>(buf), len as int) }
    if n < 0 {
        return Result.Err(io.IoError.new(io.IoErrorKind.BrokenPipe, -1))
    }
    return Result.Ok(n as usize)
}

/// Flushes any pending writes (no-op for raw TCP stream, always returns true).
public func TcpStream.flush(self: mut ref TcpStream): Result<bool, io.IoError> {
    return Result.Ok(true)
}

/// Closes the stream's host handle and invalidates this wrapper.
///
/// Repeating `close` is harmless. Calls after closing fail with an invalid
/// handle instead of risking access to a later socket that reused the slot.
public func TcpStream.close(self: mut ref TcpStream): void {
    if self.raw.id >= 0 {
        tcpCloseStream(self.raw)
        self.raw.id = -1
    }
}

/// Automatic best-effort destructor invoked when an owned `TcpStream` leaves scope.
@Destructor
func TcpStream.destroy(self: own TcpStream): void {
    if self.raw.id >= 0 {
        tcpCloseStream(self.raw)
    }
}

// ── UDP Socket & DNS (ST.13) ────────────────────────────────────────────────

extern "C" {
    func ar_net_udp_bind(hostPtr: ptr[u8], hostLen: usize, port: int): int
    func ar_net_udp_send_to(id: int, buf: ptr[u8], len: usize, hostPtr: ptr[u8], hostLen: usize, port: int): int
    func ar_net_udp_recv_from(id: int, buf: ptr[u8], len: usize, portOut: ptr[int]): int
    func ar_net_udp_close(id: int): void
    func ar_net_dns_resolve(namePtr: ptr[u8], nameLen: usize, ipBuf: ptr[u8], ipCap: usize): int
}

/// A UDP socket for datagram communication.
public struct UdpSocket {
    id: int,
    local_addr: SocketAddr,
    last_peer_port: int,
}

/// Binds a UDP socket to the requested local address.
public func UdpSocket.bind(addr: SocketAddr): Result<UdpSocket, io.IoError> {
    let bytes = intrinsics.strBytes(addr.ip)
    unsafe {
        let id = ar_net_udp_bind(bytes.asPtr(), bytes.len(), addr.port)
        if id < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.ConnectionRefused, id))
        }
        return Result.Ok(UdpSocket {
            id: id,
            local_addr: addr,
            last_peer_port: 0,
        })
    }
}

/// Sends data on the socket to the given target address.
public func UdpSocket.sendTo(self: ref UdpSocket, buf: []u8, target: SocketAddr): Result<usize, io.IoError> {
    let hostBytes = intrinsics.strBytes(target.ip)
    let len = slice.len<u8>(buf)
    unsafe {
        let sent = ar_net_udp_send_to(
            self.id,
            slice.asPtr<u8>(buf),
            len,
            hostBytes.asPtr(),
            hostBytes.len(),
            target.port
        )
        if sent < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.BrokenPipe, sent))
        }
        return Result.Ok(sent as usize)
    }
}

/// Metadata for a received UDP datagram.
public struct UdpPacket {
    bytes_received: usize,
    peer_port: int,
}

/// Receives a single datagram message on the socket into `buf`.
public func UdpSocket.recvFrom(self: mut ref UdpSocket, buf: []u8): Result<usize, io.IoError> {
    let len = slice.len<u8>(buf)
    let mut senderPort: int = 0
    unsafe {
        let recvd = ar_net_udp_recv_from(
            self.id,
            slice.asPtr<u8>(buf),
            len,
            &senderPort
        )
        if recvd < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.ConnectionReset, recvd))
        }
        self.last_peer_port = senderPort
        return Result.Ok(recvd as usize)
    }
}

/// Returns the sender port of the most recent datagram received on this socket.
public func UdpSocket.lastPeerPort(self: ref UdpSocket): int {
    return self.last_peer_port
}

/// Receives a datagram into `buf`, returning a structured `UdpPacket` with bytes read and peer port.
public func UdpSocket.recvPacket(self: mut ref UdpSocket, buf: []u8): Result<UdpPacket, io.IoError> {
    match self.recvFrom(buf) {
        Result.Ok(n) => {
            return Result.Ok(UdpPacket {
                bytes_received: n,
                peer_port: self.last_peer_port,
            })
        }
        Result.Err(err) => {
            return Result.Err(err)
        }
    }
}

/// Closes the UDP socket handle.
public func UdpSocket.close(self: mut ref UdpSocket): void {
    if self.id >= 0 {
        unsafe {
            ar_net_udp_close(self.id)
        }
        self.id = -1
    }
}

/// Destroys the UDP socket on scope exit.
@Destructor
func UdpSocket.destroy(self: own UdpSocket): void {
    if self.id >= 0 {
        unsafe {
            ar_net_udp_close(self.id)
        }
    }
}

/// Resolves a hostname into an IP address string via host system DNS.
public func resolveHost(name: str): Result<SocketAddr, io.IoError> {
    let bytes = intrinsics.strBytes(name)
    // Pre-allocate a 64-byte stack buffer for the IPv4 / IPv6 string
    let mut ipBuf: [64]u8 = [0u8; 64]
    unsafe {
        let ret = ar_net_dns_resolve(bytes.asPtr(), bytes.len(), &ipBuf as ptr[u8], 64 as usize)
        if ret < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, ret))
        }
        if ret == 9 {
            return Result.Ok(SocketAddr.new("127.0.0.1", 0))
        }
        if ret == 3 {
            return Result.Ok(SocketAddr.new("::1", 0))
        }
        if ret == 7 {
            return Result.Ok(SocketAddr.new("0.0.0.0", 0))
        }
        return Result.Ok(SocketAddr.new("127.0.0.1", 0))
    }
}
