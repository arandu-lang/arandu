//! Atomic-style value wrappers with a reserved memory-ordering API.
//!
//! ## Overview
//!
//! The current implementation provides `AtomicBool`, `AtomicInt`,
//! `AtomicUint`, and `AtomicPtr<T>`. Their methods access an ordinary stored
//! field. `MemoryOrder` arguments are accepted but ignored; these methods do
//! not provide atomic instructions or cross-thread synchronization. Use them
//! only where access is already serialized. No heap allocation occurs.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.atomic as atomic
//!
//! let mut flag = atomic.atomicBoolNew(false)
//! flag.store(true, atomic.MemoryOrder.Release)
//! let v = flag.load(atomic.MemoryOrder.Acquire)
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! The current implementation uses ordinary field reads and writes on all
//! targets; target-specific atomic instruction support is not yet wired in.
//!
//! ## See also
//!
//! - `std.core.cell` — interior mutability without atomicity
//! - `std.runtime.mutex` — high-level async mutex

module std.core.atomic


/// Ordering names reserved for a future atomic implementation.
///
/// Current load, store, swap, and fetch methods ignore this argument. These
/// variants do not currently select a memory barrier or synchronization mode.
public enum MemoryOrder {
    /// Reserved relaxed ordering name; currently ignored by methods.
    Relaxed,
    /// Reserved acquire ordering name; currently ignored by methods.
    Acquire,
    /// Reserved release ordering name; currently ignored by methods.
    Release,
    /// Reserved acquire-release ordering name; currently ignored by methods.
    AcqRel,
    /// Reserved sequential-consistency name; currently ignored by methods.
    SeqCst,
}

/// Boolean wrapper with atomic-style methods but ordinary field access.
///
/// Sharing it across concurrent writers is not made safe by these methods.
public struct AtomicBool {
    /// Stored ordinary boolean value.
    val: bool
}

/// Creates a new `AtomicBool`.
public func atomicBoolNew(val: bool): AtomicBool {
    return AtomicBool {
        val: val,
    }
}

/// Reads the stored boolean. `order` is currently ignored.
public func AtomicBool.load(self: ref AtomicBool, order: MemoryOrder): bool {
    return self.val
}

/// Writes the stored boolean. `order` is currently ignored.
public func AtomicBool.store(self: mut ref AtomicBool, val: bool, order: MemoryOrder): void {
    self.val = val
}

/// Replaces the boolean and returns its previous value.
///
/// This is an ordinary read followed by a write; `order` is ignored.
public func AtomicBool.swap(self: mut ref AtomicBool, val: bool, order: MemoryOrder): bool {
    let old = self.val
    self.val = val
    return old
}

/// Signed integer wrapper with atomic-style methods but ordinary field access.
///
/// Operations on this value do not synchronize concurrent threads.
public struct AtomicInt {
    /// Stored ordinary signed integer value.
    val: int
}

/// Creates a new `AtomicInt`.
public func atomicIntNew(val: int): AtomicInt {
    return AtomicInt {
        val: val,
    }
}

/// Reads the stored signed integer. `order` is currently ignored.
public func AtomicInt.load(self: ref AtomicInt, order: MemoryOrder): int {
    return self.val
}

/// Writes the stored signed integer. `order` is currently ignored.
public func AtomicInt.store(self: mut ref AtomicInt, val: int, order: MemoryOrder): void {
    self.val = val
}

/// Replaces the signed integer and returns its previous value.
///
/// This is an ordinary read followed by a write; `order` is ignored.
public func AtomicInt.swap(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    let old = self.val
    self.val = val
    return old
}

/// Adds `val` and returns the previous signed value.
///
/// This is not an atomic read-modify-write operation; `order` is ignored.
public func AtomicInt.fetchAdd(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    let old = self.val
    self.val = self.val + val
    return old
}

/// Subtracts `val` and returns the previous signed value.
///
/// This is not an atomic read-modify-write operation; `order` is ignored.
public func AtomicInt.fetchSub(self: mut ref AtomicInt, val: int, order: MemoryOrder): int {
    let old = self.val
    self.val = self.val - val
    return old
}

/// Compares the stored value with `expected` and conditionally writes `desired`.
///
/// Returns `Ok(expected)` on a match or `Err(currentValue)` otherwise.
/// This is not a hardware CAS; `success` and `failure` are both ignored.
public func AtomicInt.compareExchange(self: mut ref AtomicInt, expected: int, desired: int, success: MemoryOrder, failure: MemoryOrder): Result<int, int> {
    if self.val == expected {
        self.val = desired
        return Result.Ok(expected)
    }
    return Result.Err(self.val)
}

/// Unsigned integer wrapper with atomic-style methods but ordinary field access.
///
/// Operations on this value do not synchronize concurrent threads.
public struct AtomicUint {
    /// Stored ordinary unsigned integer value.
    val: uint
}

/// Creates a new `AtomicUint`.
public func atomicUintNew(val: uint): AtomicUint {
    return AtomicUint {
        val: val,
    }
}

/// Reads the stored unsigned integer. `order` is currently ignored.
public func AtomicUint.load(self: ref AtomicUint, order: MemoryOrder): uint {
    return self.val
}

/// Writes the stored unsigned integer. `order` is currently ignored.
public func AtomicUint.store(self: mut ref AtomicUint, val: uint, order: MemoryOrder): void {
    self.val = val
}

/// Adds `val` and returns the previous unsigned value.
///
/// This is not an atomic read-modify-write operation; `order` is ignored.
public func AtomicUint.fetchAdd(self: mut ref AtomicUint, val: uint, order: MemoryOrder): uint {
    let old = self.val
    self.val = self.val + val
    return old
}

/// Subtracts `val` and returns the previous unsigned value.
///
/// This is not an atomic read-modify-write operation; `order` is ignored.
public func AtomicUint.fetchSub(self: mut ref AtomicUint, val: uint, order: MemoryOrder): uint {
    let old = self.val
    self.val = self.val - val
    return old
}

/// Pointer wrapper with atomic-style methods but ordinary field access.
///
/// It does not manage the pointee's lifetime or synchronize concurrent use.
public struct AtomicPtr<T> {
    /// Stored ordinary pointer value.
    val: ptr[T]
}

/// Creates a new `AtomicPtr`.
public func atomicPtrNew<T>(val: ptr[T]): AtomicPtr<T> {
    return AtomicPtr<T> {
        val: val,
    }
}

/// Reads the stored pointer. `order` is currently ignored.
public func AtomicPtr.load<T>(self: ref AtomicPtr<T>, order: MemoryOrder): ptr[T] {
    return self.val
}

/// Writes the stored pointer. `order` is currently ignored.
public func AtomicPtr.store<T>(self: mut ref AtomicPtr<T>, val: ptr[T], order: MemoryOrder): void {
    self.val = val
}
