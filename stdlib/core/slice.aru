//! Borrowed views over contiguous element sequences (`[]T`).
//!
//! ## Overview
//!
//! A slice `[]T` is a fat-pointer view (pointer + length) over a contiguous
//! memory block. It does not own the data — it only references it. This makes
//! slices the canonical way to pass arrays and buffer parts across functions
//! without copying anything.
//!
//! `std.core.slice` provides the fundamental operations: length, subslicing,
//! checked index access, linear search and comparison. Every checked index
//! access validates bounds and traps on violation via `intrinsics.abort()`.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.slice as slice
//!
//! let arr = [10, 20, 30, 40, 50]
//! let n = slice.len<i32>(arr)               // 5
//! let sub = slice.subslice<i32>(arr, 1, 2)  // Some([20, 30])
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Zero overhead versus a raw pointer on every supported platform.
//!
//! ## See also
//!
//! - `std.core.str` — specialized slice for UTF-8 bytes
//! - `std.core.mem` — byte access and memory layout

module std.core.slice

import std.core.intrinsics as intrinsics
import std.core.mem as mem
import std.core.marker as marker

/// Returns the number of elements in the borrowed view `[]T`.
///
/// # Examples
/// ```arandu
/// let arr = [10, 20, 30]
/// slice.len<int>(arr) // 3
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func len<T>(s: []T): usize {
    return intrinsics.sliceLen<T>(s)
}

/// Returns the raw pointer to the underlying buffer of the slice `[]T`.
///
/// # Examples
/// ```arandu
/// let arr = [10, 20, 30]
/// let p = slice.asPtr<int>(arr)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func asPtr<T>(s: []T): ptr[T] {
    unsafe {
        return intrinsics.sliceData<T>(s)
    }
}

/// Returns `true` if the slice contains no elements (`len == 0`).
///
/// # Examples
/// ```arandu
/// slice.isEmpty<int>([])    // true
/// slice.isEmpty<int>([10])  // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isEmpty<T>(s: []T): bool {
    return len<T>(s) == 0
}

/// Returns a shared reference to the element at `index`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [10, 20, 30]
/// slice.get<int>(s, 1) // Some(ref 20)
/// slice.get<int>(s, 5) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func get<T>(s: []T, index: usize): Option<ref T> {
    if index >= len<T>(s) {
        return Option.None
    }
    return Option.Some(ref s[index])
}

/// Returns a shared reference to the first element, or `Option.None` if the slice is empty.
///
/// # Examples
/// ```arandu
/// slice.first<int>([10, 20]) // Some(ref 10)
/// slice.first<int>([])       // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func first<T>(s: []T): Option<ref T> {
    return get<T>(s, 0)
}

/// Returns a shared reference to the last element, or `Option.None` if the slice is empty.
///
/// # Examples
/// ```arandu
/// slice.last<int>([10, 20, 30]) // Some(ref 30)
/// slice.last<int>([])           // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func last<T>(s: []T): Option<ref T> {
    let count = len<T>(s)
    if count == 0 {
        return Option.None
    }
    return get<T>(s, count - 1)
}

/// Returns a checked subview starting at `start` with length `count`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [10, 20, 30, 40, 50]
/// slice.subslice<int>(s, 1, 3) // Some([20, 30, 40])
/// slice.subslice<int>(s, 4, 3) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func subslice<T>(s: []T, start: usize, count: usize): Option<[]T> {
    let total = len<T>(s)
    if start > total || count > total - start {
        return Option.None
    }
    unsafe {
        return Option.Some(intrinsics.sliceSubslice<T>(s, start, count))
    }
}

/// Minimal allocation-free iterator over shared element borrows.
public struct Iterator<T> {
    /// Borrowed slice being traversed.
    view: []T
    /// Next slice index to return.
    index: usize
}

/// Creates an iterator over the slice elements.
///
/// # Examples
/// ```arandu
/// let mut it = slice.iter<int>([1, 2])
/// it.next() // Some(ref 1)
/// it.next() // Some(ref 2)
/// it.next() // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func iter<T>(s: []T): Iterator<T> {
    return Iterator<T> { view: s, index: 0 }
}

/// Advances the iterator and returns the next element reference.
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func Iterator.next<T>(self: mut ref Iterator<T>): Option<ref T> {
    let item = get<T>(self.view, self.index)
    if self.index < len<T>(self.view) {
        self.index = self.index + 1
    }
    return item
}

/// Result of splitting a slice into two contiguous subviews.
public struct Split<T> {
    /// Borrowed elements before the split index.
    public left: []T
    /// Borrowed elements from the split index onward.
    public right: []T
}

/// Splits the slice at `mid`.
/// Returns `Option.Some(Split { left, right })` if `mid <= len(s)`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [1, 2, 3, 4]
/// let res = slice.splitAt<int>(s, 2)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func splitAt<T>(s: []T, mid: usize): Option<Split<T>> {
    let total = len<T>(s)
    if mid > total {
        return Option.None
    }
    unsafe {
        let left = intrinsics.sliceSubslice<T>(s, 0, mid)
        let right = intrinsics.sliceSubslice<T>(s, mid, total - mid)
        return Option.Some(Split<T> { left: left, right: right })
    }
}

/// An exclusive borrowed view. Unlike []T, this value cannot be copied: its
/// owner is mutably borrowed until the view and all element borrows expire.
/// This representation does not allocate and does not own/drop the elements.
public struct MutableSlice<Owner, T> {
    private owner: mut ref Owner,
    private data: ptr[T],
    private count: usize,
}

/// Builds an exclusive view tied to an owner borrow.
/// Safety: data points to count initialized, scalar-aligned T elements wholly
/// owned by owner. No other accesses may alias these elements for the view's
/// lifetime. The full byte range and every element offset must fit isize.
/// A zero-length view may use null; no element access is then permitted.
@Unsafe
public func MutableSlice.fromRaw<Owner, T>(owner: mut ref Owner, data: ptr[T], count: usize): MutableSlice<Owner, T> {
    return MutableSlice<Owner, T> { owner: owner, data: data, count: count }
}

/// Returns the initialized element count without accessing the buffer.
public func MutableSlice.len<Owner, T>(self: ref MutableSlice<Owner, T>): usize {
    return self.count
}

/// Borrows one element while keeping its exclusive view borrowed.
public func MutableSlice.get<Owner, T>(self: ref MutableSlice<Owner, T>, index: usize): Option<ref T> {
    if index >= self.count { return Option.None }
    unsafe {
        let sharedView = intrinsics.sliceFromRaw<MutableSlice<Owner, T>, T>(self, self.data, self.count)
        return get<T>(sharedView, index)
    }
}

/// Replaces a Copy element. A rejected index performs no memory access.
public func MutableSlice.set<Owner, T: marker.Copy>(self: mut ref MutableSlice<Owner, T>, index: usize, value: T): bool {
    if index >= self.count { return false }
    unsafe {
        let element = mem.ptrOffset<T>(self.data, index as isize)
        mem.ptrWrite<T>(element, value)
    }
    return true
}

// =========================================================================
// Inherent methods on `[]T` (`slice.*`)
// =========================================================================

/// Returns the number of elements in the slice (`s.len()`).
public func slice.len<T>(self: []T): usize {
    return len<T>(self)
}

/// Returns `true` if the slice contains no elements (`s.isEmpty()`).
public func slice.isEmpty<T>(self: []T): bool {
    return isEmpty<T>(self)
}

/// Returns the raw pointer to the underlying buffer of the slice (`s.asPtr()`).
public func slice.asPtr<T>(self: []T): ptr[T] {
    return asPtr<T>(self)
}

/// Returns a shared reference to the element at `index`, or `Option.None` if out of bounds (`s.get(index)`).
public func slice.get<T>(self: []T, index: usize): Option<ref T> {
    return get<T>(self, index)
}

/// Returns a shared reference to the first element, or `Option.None` if the slice is empty (`s.first()`).
public func slice.first<T>(self: []T): Option<ref T> {
    return first<T>(self)
}

/// Returns a shared reference to the last element, or `Option.None` if the slice is empty (`s.last()`).
public func slice.last<T>(self: []T): Option<ref T> {
    return last<T>(self)
}

/// Returns a checked subview starting at `start` with length `count`, or `Option.None` if out of bounds (`s.subslice(start, count)`).
public func slice.subslice<T>(self: []T, start: usize, count: usize): Option<[]T> {
    return subslice<T>(self, start, count)
}

/// Reads a little-endian `u16` at byte offset `offset`, or returns `Option.None` if out of bounds.
public func readU16Le(bytes: []u8, offset: usize): Option<u16> {
    if offset > bytes.len || bytes.len - offset < 2 {
        return Option.None
    }
    let b0 = bytes[offset] as u16
    let b1 = (bytes[offset + 1] as u16) << (8 as u16)
    return Option.Some(b0 | b1)
}

/// Reads a little-endian `u32` at byte offset `offset`, or returns `Option.None` if out of bounds.
public func readU32Le(bytes: []u8, offset: usize): Option<u32> {
    if offset > bytes.len || bytes.len - offset < 4 {
        return Option.None
    }
    let b0 = bytes[offset] as u32
    let b1 = (bytes[offset + 1] as u32) << (8 as u32)
    let b2 = (bytes[offset + 2] as u32) << (16 as u32)
    let b3 = (bytes[offset + 3] as u32) << (24 as u32)
    return Option.Some(b0 | b1 | b2 | b3)
}

/// Reads a little-endian `u64` at byte offset `offset`, or returns `Option.None` if out of bounds.
public func readU64Le(bytes: []u8, offset: usize): Option<u64> {
    if offset > bytes.len || bytes.len - offset < 8 {
        return Option.None
    }
    let b0 = bytes[offset] as u64
    let b1 = (bytes[offset + 1] as u64) << (8 as u64)
    let b2 = (bytes[offset + 2] as u64) << (16 as u64)
    let b3 = (bytes[offset + 3] as u64) << (24 as u64)
    let b4 = (bytes[offset + 4] as u64) << (32 as u64)
    let b5 = (bytes[offset + 5] as u64) << (40 as u64)
    let b6 = (bytes[offset + 6] as u64) << (48 as u64)
    let b7 = (bytes[offset + 7] as u64) << (56 as u64)
    return Option.Some(b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7)
}

/// Reads a little-endian `u16` at byte offset `offset` (`bytes.readU16Le(offset)`).
public func slice.readU16Le(self: []u8, offset: usize): Option<u16> {
    return readU16Le(self, offset)
}

/// Reads a little-endian `u32` at byte offset `offset` (`bytes.readU32Le(offset)`).
public func slice.readU32Le(self: []u8, offset: usize): Option<u32> {
    return readU32Le(self, offset)
}

/// Reads a little-endian `u64` at byte offset `offset` (`bytes.readU64Le(offset)`).
public func slice.readU64Le(self: []u8, offset: usize): Option<u64> {
    return readU64Le(self, offset)
}
