//! Inline cells and the explicit boundary for unsafe interior mutability.
//!
//! ## Overview
//!
//! `Cell<T>` exposes mutation through exclusive references. `UnsafeCell<T>`
//! additionally permits obtaining a raw pointer from a shared reference, in
//! an unsafe block. The caller must enforce aliasing and synchronization.
//! UnsafeCell is never Copy or Sync; it is Send only when its value is Send.
//! Neither type provides mutual exclusion or atomic operations.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.cell as cell
//!
//! let c = cell.UnsafeCell.new(42)
//! let v = c.intoInner()  // 42, consumes c
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Zero overhead on every supported platform.
//!
//! ## See also
//!
//! - `std.core.atomic` — compiler-lowered scalar atomics
//! - `std.runtime.mutex` — async mutex

module std.core.cell

import std.core.intrinsics as intrinsics

/// Inline value wrapper without synchronization.
///
/// get() is an unsafe raw-pointer boundary, not a safe mutation permission.
/// Concurrent access requires external synchronization.
public struct UnsafeCell<T> {
    /// Stored value.
    private value: T
}

/// Returns the contained value's raw address without creating a mutable borrow.
///
/// Safety: the caller must enforce exclusivity of every write, synchronize
/// concurrent accesses and keep this cell stationary until all uses finish.
/// Merely obtaining the pointer grants no permission to dereference it.
@Unsafe
public func UnsafeCell.get<T>(self: ref UnsafeCell<T>): ptr[T] {
    // The canonical cell has exactly one field, at offset zero and aligned as T.
    unsafe { return intrinsics.addressOfShared(self) as ptr[T] }
}

/// Creates a new `UnsafeCell` containing `val`.
public func UnsafeCell.new<T>(val: T): UnsafeCell<T> {
    return UnsafeCell<T> {
        value: val,
    }
}

/// Exclusively borrows the stored value; an exclusive cell borrow rules out
/// every concurrent cell access, so this operation needs no unsafe boundary.
public func UnsafeCell.getMut<T>(self: mut ref UnsafeCell<T>): mut ref T {
    return mut ref self.value
}

/// Unwraps and returns the contained value.
public func UnsafeCell.intoInner<T>(self: own UnsafeCell<T>): T {
    return self.value
}

/// A mutable memory location for copyable types.
public struct Cell<T> {
    /// Stored value.
    value: T
}

/// Creates a new `Cell` containing `val`.
public func Cell.new<T>(val: T): Cell<T> {
    return Cell<T> {
        value: val,
    }
}

/// Returns a copy of the contained value.
public func Cell.get<T>(self: ref Cell<T>): T {
    return self.value
}

/// Sets the contained value.
public func Cell.set<T>(self: mut ref Cell<T>, val: T): void {
    self.value = val
}

/// Replaces the contained value with `val`, returning the old value.
public func Cell.replace<T>(self: mut ref Cell<T>, val: T): T {
    let old = self.value
    self.value = val
    return old
}

/// Unwraps and returns the contained value.
public func Cell.intoInner<T>(self: own Cell<T>): T {
    return self.value
}
