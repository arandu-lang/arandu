module borrowedStringEquality

func equal(left: ref str, right: ref str): bool { return left == right }
func different(left: ref str, right: ref str): bool { return left != right }

public func main(): int {
    let first = "same bytes"
    let second = "same bytes"
    let other = "same BYTEs"
    let empty = ""
    if !equal(ref first, ref second) { return 1 }
    if different(ref first, ref second) { return 2 }
    if equal(ref first, ref other) { return 3 }
    if !different(ref first, ref other) { return 4 }
    if equal(ref first, ref empty) { return 5 }
    if !equal(ref empty, ref empty) { return 6 }
    let borrowed = ref first
    if borrowed != "same bytes" { return 7 }
    if "same bytes" != borrowed { return 8 }
    if borrowed == "different" { return 9 }
    let mut mutable = "same bytes"
    let exclusive = mut ref mutable
    if exclusive != "same bytes" { return 10 }
    if "same bytes" != exclusive { return 11 }
    return 0
}
