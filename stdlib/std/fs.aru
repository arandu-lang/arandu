//! Filesystem reads and directory listings through the host operating system.
//!
//! ## Overview
//!
//! `readToString` reads a whole file into an owned buffer; `readDir` returns a
//! directory snapshot whose names borrow its storage. `fileExists` performs a
//! boolean existence check. `OpenOptions`, `File`, and `Metadata` describe
//! handles and file properties, but this module does not yet expose public
//! functions to open, write, create, remove, or query metadata.
//!
//! Reading operations report host errors as `Result<T, io.IoError>`. The
//! boolean `fileExists` does not distinguish a missing path from other host
//! failures. The owned `String` returned by `readToString` stores bytes without
//! checking whether they are valid UTF-8.
//!
//! This module requires filesystem host functions. For in-memory I/O without
//! an operating system, use `std.core.io`.
//!
//! ## Example
//!
//! ```arandu
//! import std.fs as fs
//! import std.io as io
//!
//! let content = fs.readToString("config.toml")
//! match content {
//!     Ok(_) => {
//!         io.println("config found")
//!     }
//!     Err(_) => {
//!         io.println("no config file")
//!     }
//! }
//! ```
//!
//! ## Platform
//! `native` (executables linked to an OS-backed Arandu runtime)
//!
//! Linux, macOS and Windows. wasm32 works only with WASI or host imports;
//! bare-metal is unsupported (no OS) — use `std.core.io` there.
//!
//! ## See also
//!
//! - `std.io` — `Read`/`Write` traits and error types
//! - `std.path` — path manipulation without disk access
//! - `std.core.io` — OS-free freestanding I/O
module std.fs

import std.io as io

import std.core.mem as mem

import std.core.intrinsics as intrinsics

import std.alloc.string as strings

import std.alloc.vec as vec

import std.core.slice as slice

/// Open flags consumed by Dir.openFile (append is not yet supported).
public struct OpenOptions {
    /// Request read access.
    read: bool
    /// Request write access.
    write: bool
    /// Request file creation.
    create: bool
    /// Request truncation when opening.
    truncate: bool
    /// Request append mode.
    append: bool
}

/// Creates `OpenOptions` with all flags disabled.
public func OpenOptions.new(): OpenOptions {
    return OpenOptions {
        read: false,
        write: false,
        create: false,
        truncate: false,
        append: false,
    }
}

func readOnly(): OpenOptions {
    return OpenOptions {
        read: true,
        write: false,
        create: false,
        truncate: false,
        append: false,
    }
}

/// Creates `OpenOptions` with only `read` enabled.
///
/// All other flags are false. Accepted by Dir.openFile.
public func OpenOptions.readOnly(): OpenOptions {
    return readOnly()
}

func writeOnly(): OpenOptions {
    return OpenOptions {
        read: false,
        write: true,
        create: true,
        truncate: true,
        append: false,
    }
}

/// Creates `OpenOptions` with `write`, `create`, and `truncate` enabled.
///
/// read and append are false. Accepted by Dir.openFile.
public func OpenOptions.writeOnly(): OpenOptions {
    return writeOnly()
}

/// Wraps an OS file descriptor.
public struct File {
    /// Host descriptor; `close` sets it to `-1`.
    private fd: int
}

func File.fromRaw(fd: int): File {
    return File { fd: fd }
}

/// Reads up to `count` bytes into `buf` from this file. Returns the number of bytes read, or negative on error.
public func File.read(self: ref File, buf: ptr[u8], count: usize): int {
    if self.fd < 0 { return -1 }
    unsafe {
        return ar_fs_read(self.fd, buf, count)
    }
}

/// Writes up to `count` bytes from `buf` to this file. Returns the number of bytes written, or negative on error.
public func File.write(self: ref File, buf: ptr[u8], count: usize): int {
    if self.fd < 0 { return -1 }
    unsafe {
        return ar_fs_write(self.fd, buf, count)
    }
}

/// Closes this file descriptor.
public func File.close(self: mut ref File): void {
    if self.fd >= 0 {
        unsafe {
            ar_fs_close(self.fd)
        }
        self.fd = -1
    }
}

/// Destroys the file descriptor on scope exit if not already closed.
@Destructor
func File.destroy(self: own File): void {
    if self.fd >= 0 {
        unsafe {
            ar_fs_close(self.fd)
        }
    }
}

extern "C" {
    /// Host existence probe used by `fileExists`; returns a boolean only.
    func exists(path: str): bool
    /// Host file-open bridge reserved for future public file operations.
    func ar_fs_open(path: str, flags: int, mode: int): int
    /// Host read bridge for a descriptor and caller-owned buffer.
    func ar_fs_read(fd: int, buf: ptr[u8], count: usize): int
    /// Host write bridge for a descriptor and caller-owned buffer.
    func ar_fs_write(fd: int, buf: ptr[u8], count: usize): int
    /// Host descriptor-close bridge used by `File.close`.
    func ar_fs_close(fd: int): int
    /// Reads the whole file; on success fills `outBuf`/`outLen`/`outCap`
    /// (owned buffer, adopt via `strings.adoptOwned`). Any error zeroes the
    /// out-params; `err` carries a portable `IoErrorKind` code.
    func ar_fs_read_all(path: str, outBuf: mut ref ptr[u8], outLen: mut ref usize, outCap: mut ref usize, err: mut ref isize): void
    /// Reads a directory into one owned blob (see `readDir`/`DirListing`).
    func ar_fs_readdir(path: str, outBuf: mut ref ptr[u8], outCount: mut ref usize, outCap: mut ref usize, err: mut ref isize): void
    /// Frees buffers returned by `ar_fs_read_all`/`ar_fs_readdir`.
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
}

/// Returns the host's boolean existence result for `path`.
///
/// This API does not report why a path is unavailable. Existence can change
/// immediately after the check, so do not use it as a permission or safety
/// check before opening a file.
public func fileExists(path: str): bool {
    unsafe {
        return exists(path)
    }
}

/// Reads the entire contents of `path` into an owned `String` without copying.
///
/// The host allocates the exact-size buffer; the returned `String` **adopts**
/// it (`capacity == len`). The returned bytes are not UTF-8 validated, despite
/// the function name. This call has `FileRead` and `Foreign` effects.
///
/// ## Errors
/// Returns `Err(io.IoError)` when the host cannot open or read the path,
/// including missing files and permission failures. Invalid UTF-8 is not
/// reported as an error.
///
/// ## Allocations
/// The host allocates a buffer for the file contents. The returned `String`
/// takes ownership of that buffer without making a second copy.
///
/// ## Safety
/// Before treating the result as text, the caller must ensure its bytes are
/// valid UTF-8. The `String` owns the buffer and releases it on destruction.
@Effects(FileRead, Foreign)
public func readToString(path: str): Result<strings.String, io.IoError> {
    let mut buf: ptr[u8] = nil
    let mut len: usize = 0
    let mut cap: usize = 0
    let mut errCode: isize = 0
    unsafe {
        ar_fs_read_all(path, buf, len, cap, errCode)
    }
    if errCode != 0 {
        return Result.Err(io.IoError.fromPlatform(errCode as int))
    }
    return Result.Ok(unsafe { strings.adoptOwned(buf, cap, len) })
}

/// Reads a whole file into an owned byte vector without UTF-8 interpretation.
///
/// The vector adopts the host buffer without an intermediate String or a
/// second byte allocation. Empty files return an empty vector; read failures
/// return the same portable error categories as `readToString`.
@Effects(FileRead, Foreign)
public func readToBytes(path: str): Result<vec.Vec<u8>, io.IoError> {
    let mut buf: ptr[u8] = nil
    let mut len: usize = 0
    let mut cap: usize = 0
    let mut errCode: isize = 0
    unsafe {
        ar_fs_read_all(path, buf, len, cap, errCode)
    }
    if errCode != 0 {
        return Result.Err(io.IoError.fromPlatform(errCode as int))
    }
    return Result.Ok(unsafe { vec.adoptBytes(buf, cap, len) })
}

/// An owned snapshot of a directory listing in one contiguous allocation.
///
/// Names are **views** into the listing blob (`name(i) -> []u8`), never
/// copies; `isDir(i)` uses the cheap type the OS provided during readdir (no
/// per-entry stat). Each name has a stable string descriptor, so multiple
/// borrowed name views can coexist. Ordering is the host filesystem order (unspecified, like
/// POSIX `readdir`). The destructor releases the blob; borrowed names cannot
/// outlive this listing.
public struct DirListing {
    // The first two fields form a stable empty `str` descriptor for invalid indexes.
    /// Pointer for the empty out-of-range name view.
    emptyData: ptr[u8]
    /// Zero length of the empty out-of-range name view.
    emptyLen: usize
    /// Pointer to the owned listing blob.
    data: ptr[u8]
    /// Number of entries in the snapshot.
    count: usize
    /// Allocated blob capacity in bytes.
    capacity: usize
}

// Fat `str` descriptor stored once per entry inside the owned listing blob.
struct DirNameDescriptor {
    data: ptr[u8]
    len: usize
}

/// Reads the directory at `path` into an owned `DirListing` (one allocation).
///
/// Directory contents are not sorted; order matches the host filesystem.
/// The host is foreign code, so calling this function requires the `FileRead`
/// and `Foreign` effects.
///
/// ## Errors
/// Returns `Err(io.IoError)` if the host cannot read the directory, including
/// a missing path, a non-directory path, or insufficient permissions.
///
/// ## Allocations
/// The returned listing owns one blob containing entry metadata and names.
/// `name` and `nameStr` return views into that blob without copying names.
@Effects(FileRead, Foreign)
public func readDir(path: str): Result<DirListing, io.IoError> {
    let mut buf: ptr[u8] = nil
    let mut count: usize = 0
    let mut cap: usize = 0
    let mut errCode: isize = 0
    unsafe {
        ar_fs_readdir(path, buf, count, cap, errCode)
    }
    if errCode != 0 {
        return Result.Err(io.IoError.fromPlatform(errCode as int))
    }
    return Result.Ok(DirListing {
        emptyData: nil,
        emptyLen: 0,
        data: buf,
        count: count,
        capacity: cap,
    })
}

/// Reads the `u32` entry field at `byteOff` from the blob (little-endian).
func readU32At(base: ptr[u8], byteOff: usize): u32 {
    unsafe {
        let p = mem.ptrOffset<u8>(base, byteOff as isize)
        return mem.ptrRead<u32>(p as ptr[u32])
    }
}

/// Returns the number of entries in the listing.
///
/// The count reflects the snapshot taken by `readDir`, not later changes to
/// the directory. This operation takes O(1) time and does not allocate.
public func DirListing.count(self: ref DirListing): usize {
    return self.count
}

/// Returns the number of entries in the listing.
public func DirListing.len(self: ref DirListing): usize {
    return self.count
}

/// Returns `true` when the entry at `index` is a directory. Out-of-range
/// indexes return `false`.
///
/// The value comes from the entry type supplied during the listing; this
/// method does not perform a separate filesystem query.
public func DirListing.isDir(self: ref DirListing, index: usize): bool {
    if index >= self.count {
        return false
    }
    unsafe {
        let p = mem.ptrOffset<u8>(self.data, (8 + index * 16 + 8) as isize)
        return mem.ptrRead<u8>(p) != 0
    }
}

/// Returns the name of the entry at `index` as a borrowed byte slice,
/// or an empty slice when `index` is out of range.
///
/// The view borrows `self`; the bytes remain valid while the listing owns its
/// blob. This method does not allocate or decode the name as text.
public func DirListing.name(self: ref DirListing, index: usize): []u8 {
    if index >= self.count {
        unsafe {
            return intrinsics.sliceFromRaw<DirListing, u8>(self, self.data, 0)
        }
    }
    unsafe {
        let entryOff: usize = 8 + index * 16
        let nameOff = readU32At(self.data, entryOff) as usize
        let nameLen = readU32At(self.data, entryOff + 4) as usize
        let namesBase = mem.ptrOffset<u8>(self.data, (8 + self.count * 16 + self.count * mem.sizeOf<DirNameDescriptor>()) as isize)
        let namePtr = mem.ptrOffset<u8>(namesBase, nameOff as isize)
        return intrinsics.sliceFromRaw<DirListing, u8>(self, namePtr, nameLen)
    }
}

/// Returns the name of the entry at `index` as a borrowed string view,
/// or an empty string when `index` is out of range.
///
/// Each entry has its own stable descriptor in the listing blob. Multiple
/// name views may coexist; all become invalid when the listing is closed or dropped.
/// This method does not allocate or mutate the listing.
public func DirListing.nameStr(self: ref DirListing, index: usize): ref str {
    if index >= self.count {
        unsafe {
            return intrinsics.strView<DirListing>(self)
        }
    }
    unsafe {
        let descriptors = mem.ptrOffset<u8>(self.data, (8 + self.count * 16) as isize) as ptr[DirNameDescriptor]
        let views = intrinsics.sliceFromRaw<DirListing, DirNameDescriptor>(self, descriptors, self.count)
        return intrinsics.strView<DirNameDescriptor>(&views[index])
    }
}

/// Idempotently closes and releases the directory listing snapshot.
public func DirListing.close(self: mut ref DirListing): void {
    destroyListing(self)
}

/// Automatic destructor invoked when an owned `DirListing` leaves scope.
@Destructor
func DirListing.destroy(self: own DirListing): void {
    destroyListing(self)
}

/// Frees the listing blob (null- and zero-capacity safe).
func destroyListing(l: mut ref DirListing): void {
    let data = l.data
    let capacity = l.capacity
    l.emptyData = nil
    l.emptyLen = 0
    l.data = nil
    l.capacity = 0
    l.count = 0
    if capacity > 0 {
        unsafe {
            ar_vec_buf_free(data, capacity)
        }
    }
}

/// Metadata information about a file or directory.
public struct Metadata {
    /// File length in bytes.
    file_size: usize
    /// Whether the entry is a directory.
    is_dir: bool
    /// Whether the entry is a regular file.
    is_file: bool
    /// Whether the entry is read-only.
    readonly: bool
}

/// Returns the size of the file in bytes.
public func Metadata.size(self: ref Metadata): usize {
    return self.file_size
}

/// Returns `true` if this metadata describes a directory.
public func Metadata.isDir(self: ref Metadata): bool {
    return self.is_dir
}

/// Returns `true` if this metadata describes a regular file.
public func Metadata.isFile(self: ref Metadata): bool {
    return self.is_file
}

/// Returns `true` if this file is read-only.
public func Metadata.isReadonly(self: ref Metadata): bool {
    return self.readonly
}

// ── Capability-Safe Directory Abstraction (RFC 0016) ────────────────────────

extern "C" {
    func ar_fs_dir_open(pathData: ptr[u8], pathLen: usize): int
    func ar_fs_dir_openat(dirFd: int, pathData: ptr[u8], pathLen: usize): int
    func ar_fs_openat(dirFd: int, pathData: ptr[u8], pathLen: usize, read: bool, write: bool, create: bool, truncate: bool): int
    func ar_fs_mkdirat(dirFd: int, pathData: ptr[u8], pathLen: usize): int
    func ar_fs_unlinkat(dirFd: int, pathData: ptr[u8], pathLen: usize, isDir: bool): int
}

/// A capability token representing an open directory handle (RFC 0016).
///
/// Linux relative opens use openat2 with BENEATH/NO_SYMLINKS/NO_MAGICLINKS.
/// Absolute paths, parent traversal and ambiguous components are rejected.
/// Creation/removal use a separately pinned, confined parent and one leaf.
/// macOS/BSD accept only one normal component per call, using O_NOFOLLOW;
/// derive a child Dir explicitly before accessing its files. Multi-component
/// paths fail closed there. Handles retain authority over their directory if
/// it is renamed. Unsupported kernels/platforms fail closed; Linux never falls
/// back from openat2 to a weaker traversal.
/// The descriptor is private and cannot be forged by safe clients.
public struct Dir {
    private fd: int
}

/// Opens an ambient directory path as a capability token.
public func openDir(path: str): Result<Dir, io.IoError> {
    return Dir.open(path)
}

/// Acquires an ambient directory handle. Linux uses openat2 for relative paths;
/// macOS/BSD require one component per relative call. Windows is unsupported.
public func Dir.open(path: str): Result<Dir, io.IoError> {
    let bytes = intrinsics.strBytes(path)
    unsafe {
        let fd = ar_fs_dir_open(slice.asPtr<u8>(bytes), slice.len<u8>(bytes))
        if fd < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, fd))
        }
        return Result.Ok(Dir { fd: fd })
    }
}

/// Opens a file relative to this directory descriptor.
public func Dir.openFile(self: ref Dir, subpath: str, options: OpenOptions): Result<File, io.IoError> {
    if options.append { return Result.Err(io.IoError.new(io.IoErrorKind.InvalidInput, 5)) }
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let fd = ar_fs_openat(
        self.fd,
        slice.asPtr<u8>(bytes),
        slice.len<u8>(bytes),
        options.read,
        options.write,
        options.create,
        options.truncate
        )
        if fd < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, fd))
        }
        return Result.Ok(File.fromRaw(fd))
    }
}

/// Opens a subdirectory relative to this directory descriptor as a new `Dir` capability.
public func Dir.openDir(self: ref Dir, subpath: str): Result<Dir, io.IoError> {
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let fd = ar_fs_dir_openat(
        self.fd,
        slice.asPtr<u8>(bytes),
        slice.len<u8>(bytes)
        )
        if fd < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, fd))
        }
        return Result.Ok(Dir { fd: fd })
    }
}

/// Checks if a file exists relative to this directory descriptor without ambient path leakage.
public func Dir.fileExists(self: ref Dir, subpath: str): bool {
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let fd = ar_fs_openat(
        self.fd,
        slice.asPtr<u8>(bytes),
        slice.len<u8>(bytes),
        true,
        false,
        false,
        false
        )
        if fd >= 0 {
            ar_fs_close(fd)
            return true
        }
        return false
    }
}

/// Creates a new subdirectory relative to this directory descriptor.
public func Dir.createDir(self: ref Dir, subpath: str): Result<Dir, io.IoError> {
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let fd = ar_fs_mkdirat(self.fd, slice.asPtr<u8>(bytes), slice.len<u8>(bytes))
        if fd < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.PermissionDenied, fd))
        }
        return Result.Ok(Dir { fd: fd })
    }
}

/// Removes a regular file relative to this directory descriptor.
public func Dir.removeFile(self: ref Dir, subpath: str): Result<bool, io.IoError> {
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let ret = ar_fs_unlinkat(self.fd, slice.asPtr<u8>(bytes), slice.len<u8>(bytes), false)
        if ret < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, ret))
        }
        return Result.Ok(true)
    }
}

/// Removes a subdirectory relative to this directory descriptor.
public func Dir.removeDir(self: ref Dir, subpath: str): Result<bool, io.IoError> {
    let bytes = intrinsics.strBytes(subpath)
    unsafe {
        let ret = ar_fs_unlinkat(self.fd, slice.asPtr<u8>(bytes), slice.len<u8>(bytes), true)
        if ret < 0 {
            return Result.Err(io.IoError.new(io.IoErrorKind.NotFound, ret))
        }
        return Result.Ok(true)
    }
}

/// Closes this directory capability handle.
public func Dir.close(self: mut ref Dir): void {
    if self.fd >= 0 {
        unsafe {
            ar_fs_close(self.fd)
        }
        self.fd = -1
    }
}

/// Automatic destructor ensuring the directory descriptor is closed on scope exit.
@Destructor
func Dir.destroy(self: own Dir): void {
    if self.fd >= 0 {
        unsafe {
            ar_fs_close(self.fd)
        }
    }
}
