module examples.minimal.m13_vec

// Minimal 0.1 — PROMOTE-L6 complete (Vec thin, pure-buffer).
// Canonical method API: Vec<T>.new/withCapacity, push/get/getCopy/set/pop, len/capacity/isEmpty,
// reserve, clear, automatic drop.
import std.alloc.vec as vec

func main(): int {
    let mut v = vec.Vec<int>.new()
    if !v.isEmpty() {
        return 90
    }
    v.push(10)
    v.push(20)
    v.push(30)

    let ok = v.set(1, 5)
    if !ok {
        return 1
    }

    let g0 = v.getCopy(0)
    let g1 = v.getCopy(1)
    let g2 = v.getCopy(2)
    match g0 {
        Some(a) => {
            match g1 {
                Some(b) => {
                    match g2 {
                        Some(c) => {
                            let n = v.len() as int
                            let gp = v.pop()
                            match gp {
                                Some(p) => {
                                    // 10 + 5 + 30 + 3 + 30 = 78
                                    return a + b + c + n + p
                                }
                                None => {
                                    return 2
                                }
                            }
                        }
                        None => {
                            return 3
                        }
                    }
                }
                None => {
                    return 4
                }
            }
        }
        None => {
            return 5
        }
    }
}
