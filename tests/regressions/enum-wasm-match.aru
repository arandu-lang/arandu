struct Sample {
    left: int
    right: int
}

enum Choice {
    Left(int),
    Right(int),
}

func main(): int {
    let base: int = 26
    let values = [(5 - (base / 5)), base, base]
    let sample = Sample { left: values[0], right: values[1] }
    let selected_value = if (1 != (((((base / 6) % 6) + (base - (base * 1))) - (((23 - base) + (6 - base)) / 3)) * 3)) { sample.left } else { sample.right }
    let selected = Choice.Left(selected_value)
    return match selected {
        Choice.Left(value) => value
        Choice.Right(value) => value
    }
}
