//! Growable contiguous arrays.
//!
//! ## Overview
//!
//! `Vec<T>` owns a heap buffer with separate length and capacity. Use its fallible `try*` operations when allocation failure must be handled explicitly.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.vec as vec
//!
//! let mut values = vec.Vec<int>.new()
//! values.push(3)
//! let first = values.get(0) // Option<ref int>
//! ```
//!
//! ## Safety
//! A slice returned by `asSlice` borrows the vector's storage. Growth,
//! clear, or drop can invalidate that view.
//!
//! ## Allocations
//! `Vec.new` does not allocate. `tryPush` and `tryReserve` return `false` on
//! allocation failure; `push` and `reserve` may abort on failure.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.vec

/// Minimal 0.1 — growable array (`Vec<T>`).
///
/// # Design
/// Contiguous pure-buffer storage: host raw allocators
/// (`ar_vec_malloc` / `ar_vec_realloc` / `ar_vec_buf_free`) + typed access via
/// mem intrinsics (`sizeOf` / `ptrOffset` / `ptrRead` / `ptrWrite`).
///
/// Growth: geometric factor 2, minimum capacity 8 (amortised O(1) append).

import std.core.mem as mem
import std.core.intrinsics as intrinsics
import std.core.marker as marker
import std.core.slice as slice

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: usize): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
    /// Host allocator that resizes a raw byte buffer.
    func ar_vec_realloc(p: ptr[u8], oldSize: usize, newSize: usize): ptr[u8]
}

/// Growable contiguous buffer of `T`.
public struct Vec<T> {
    /// Pointer to the owned element buffer.
    data: ptr[T]
    /// Number of initialized elements.
    len: usize
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: usize
}

/// Adopts an initialized byte buffer without allocating or copying.
///
/// # Safety
/// `data` must be uniquely owned storage compatible with `ar_vec_buf_free`,
/// allocated for `bufCap` bytes. `bufLen` must not exceed `bufCap`, and the
/// first `bufLen` bytes must be initialized. A nil buffer requires zero length
/// and capacity. Ownership transfers to the returned vector exactly once.
@Unsafe
public func adoptBytes(data: ptr[u8], bufCap: usize, bufLen: usize): Vec<u8> {
    return Vec<u8> { data: data, len: bufLen, capacity: bufCap }
}

func new<T>(): Vec<T> {
    return Vec<T> {
        data: nil,
        len: 0,
        capacity: 0,
    }
}

/// Creates a new empty `Vec<T>` without heap allocation.
///
/// # Examples
/// ```arandu
/// let v = vec.Vec<int>.new()
/// v.len() // 0
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func Vec.new<T>(): Vec<T> {
    return new<T>()
}

func withCapacity<T>(cap: usize): Vec<T> {
    let mut v = new<T>()
    ensureCapacity<T>(v, cap)
    return v
}

/// Creates an empty `Vec<T>` preallocated with room for at least `cap` elements.
///
/// # Examples
/// ```arandu
/// let v = vec.Vec<int>.withCapacity(16)
/// v.capacity() // >= 16
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(cap)
public func Vec.withCapacity<T>(cap: usize): Vec<T> {
    return withCapacity<T>(cap)
}

/// Attempts to ensure absolute capacity ≥ `minCap`.
///
/// Returns `true` on success. On failure (such as capacity overflow or
/// allocation failure), returns `false` and leaves `v` completely unmodified.
func tryEnsureCapacity<T>(v: mut ref Vec<T>, minCap: usize): bool {
    if v.capacity >= minCap {
        return true
    }
    let maxCap: usize = 2147483647 as usize
    if minCap > maxCap {
        return false
    }
    let mut newCap: usize = v.capacity
    if newCap == 0 {
        newCap = 8
    }
    while newCap < minCap {
        if newCap > maxCap / 2 {
            newCap = maxCap
        } else {
            newCap = newCap * 2
        }
    }
    let elem = mem.sizeOf<T>()
    if elem > 0 && newCap > (maxCap / elem) {
        return false
    }
    let oldBytes = v.capacity * elem
    let newBytes = newCap * elem
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_realloc(v.data as ptr[u8], oldBytes, newBytes)
        if p == nullp {
            return false
        }
        v.data = p as ptr[T]
        v.capacity = newCap
    }
    return true
}

/// Ensure absolute capacity ≥ `minCap`. Aborts if reallocation fails.
func ensureCapacity<T>(v: mut ref Vec<T>, minCap: usize): void {
    if !tryEnsureCapacity<T>(v, minCap) {
        unsafe {
            intrinsics.abort()
        }
    }
}

func tryReserve<T>(v: mut ref Vec<T>, additional: usize): bool {
    let maxCap: usize = 2147483647 as usize
    if additional > maxCap - v.len {
        return false
    }
    let need = v.len + additional
    return tryEnsureCapacity<T>(v, need)
}

func reserve<T>(v: mut ref Vec<T>, additional: usize): void {
    if !tryReserve<T>(v, additional) {
        unsafe {
            intrinsics.abort()
        }
    }
}

func tryPush<T>(v: mut ref Vec<T>, value: T): bool {
    let maxCap: usize = 2147483647 as usize
    if v.len >= maxCap {
        return false
    }
    let need = v.len + 1
    if v.capacity < need {
        if !tryEnsureCapacity<T>(v, need) {
            return false
        }
    }
    unsafe {
        let dest = mem.ptrOffset<T>(v.data, v.len as isize)
        mem.ptrWrite<T>(dest, value)
    }
    v.len = v.len + 1
    return true
}

func push<T>(v: mut ref Vec<T>, value: T): void {
    if !tryPush<T>(v, value) {
        unsafe {
            intrinsics.abort()
        }
    }
}

func pop<T>(v: mut ref Vec<T>): Option<T> {
    if v.len == 0 {
        return Option.None
    }
    v.len = v.len - 1
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, v.len as isize)
        return Option.Some(mem.ptrRead<T>(elemPtr))
    }
}

func get<T>(v: ref Vec<T>, index: usize): Option<ref T> {
    if index >= v.len {
        return Option.None
    }
    return slice.get<T>(asSlice<T>(v), index)
}

func takeSome<T>(v: mut ref Vec<Option<T>>, index: usize): Option<T> {
    if index >= v.len {
        return Option.None
    }
    unsafe {
        let elemPtr = mem.ptrOffset<Option<T>>(v.data, index as isize)
        let slot = mem.ptrRead<Option<T>>(elemPtr)
        mem.ptrWrite<Option<T>>(elemPtr, Option.None)
        return slot
    }
}

/// Moves a populated optional slot out of the vector and leaves `None` behind.
///
/// This is intended for ownership-aware containers built on `Vec<Option<T>>`:
/// the payload is transferred without copying, while the vector remains fully
/// initialized and can still be safely dropped. Returns `None` for an
/// out-of-range index or an empty slot.
public func Vec.takeSome<T>(self: mut ref Vec<Option<T>>, index: usize): Option<T> {
    return takeSome<T>(self, index)
}

func getCopy<Element: marker.Copy>(v: ref Vec<Element>, index: usize): Option<Element> {
    let maxCap: usize = 2147483647 as usize
    if index >= v.len || index > maxCap {
        return Option.None
    }
    unsafe {
        let elemPtr = mem.ptrOffset<Element>(v.data, index as isize)
        return Option.Some(mem.ptrRead<Element>(elemPtr))
    }
}

func len<T>(v: ref Vec<T>): usize {
    return v.len
}

func capacity<T>(v: ref Vec<T>): usize {
    return v.capacity
}

func isEmpty<T>(v: ref Vec<T>): bool {
    return v.len == 0
}

func asSlice<T>(v: ref Vec<T>): []T {
    unsafe {
        return intrinsics.sliceFromRaw<Vec<T>, T>(v, v.data, v.len)
    }
}

func clear<T>(v: mut ref Vec<T>): void {
    let mut i: usize = 0
    while i < v.len {
        unsafe {
            let elemPtr = mem.ptrOffset<T>(v.data, i as isize)
            mem.dropInPlace<T>(elemPtr)
        }
        i = i + 1
    }
    v.len = 0
}

/// Deallocates the heap buffer and resets the vector to empty.
func destroyVec<T>(v: mut ref Vec<T>): void {
    clear<T>(v)
    if v.capacity > 0 {
        let size = v.capacity * mem.sizeOf<T>()
        unsafe {
            ar_vec_buf_free(v.data as ptr[u8], size)
        }
        v.data = nil
        v.capacity = 0
    }
}

// ── Method-style surface ───────────────────────────────────────────────────

/// Appends `value`, growing the buffer when full.
///
/// Allocation failure aborts. Use `tryPush` when the caller must handle failure.
public func Vec.push<T>(self: mut ref Vec<T>, value: T): void {
    push(self, value)
}

/// Removes and returns the last element, or `None` if empty.
///
/// Capacity remains allocated for reuse; this operation is O(1).
public func Vec.pop<T>(self: mut ref Vec<T>): Option<T> {
    return pop(self)
}

/// Borrows the indexed element as `Some`, or returns `None` out of bounds.
///
/// No element is copied or moved. The vector cannot be changed or dropped
/// while the returned borrow is still in use.
public func Vec.get<T>(self: ref Vec<T>, index: usize): Option<ref T> {
    return get<T>(self, index)
}

/// Returns a copy of a `Copy` element at `index`, or `Option.None` if out of bounds.
public func Vec.getCopy<Element: marker.Copy>(self: ref Vec<Element>, index: usize): Option<Element> {
    return getCopy<Element>(self, index)
}

/// Replaces an in-range element and returns `true`.
///
/// An out-of-range index returns `false` without changing the vector.
public func Vec.set<T>(self: mut ref Vec<T>, index: usize, value: T): bool {
    let maxCap: usize = 2147483647 as usize
    if index >= self.len || index > maxCap {
        return false
    }
    unsafe {
        let elemPtr = mem.ptrOffset<T>(self.data, index as isize)
        mem.dropInPlace<T>(elemPtr)
        mem.ptrWrite<T>(elemPtr, value)
    }
    return true
}

/// Returns the number of elements in the vector.
public func Vec.len<T>(self: ref Vec<T>): usize {
    return len(self)
}

/// Returns the allocated capacity of the vector.
public func Vec.capacity<T>(self: ref Vec<T>): usize {
    return capacity(self)
}

/// Returns `true` if the vector contains no elements.
public func Vec.isEmpty<T>(self: ref Vec<T>): bool {
    return isEmpty(self)
}

/// Borrows the initialized elements as a slice without copying.
///
/// The view becomes invalid if the vector is destroyed or reallocated.
public func Vec.asSlice<T>(self: ref Vec<T>): []T {
    return asSlice<T>(self)
}

/// Ensures room for `additional` elements beyond the current length.
///
/// Growth may reallocate and invalidate borrowed slices; failure aborts.
public func Vec.reserve<T>(self: mut ref Vec<T>, additional: usize): void {
    reserve(self, additional)
}

/// Attempts to reserve room for `additional` elements beyond the length.
///
/// Returns `false` on allocation failure or capacity overflow, leaving
/// existing contents intact.
public func Vec.tryReserve<T>(self: mut ref Vec<T>, additional: usize): bool {
    return tryReserve(self, additional)
}

/// Attempts to append one element without aborting on allocation failure.
///
/// Returns `false` and leaves the vector intact if growth fails.
public func Vec.tryPush<T>(self: mut ref Vec<T>, value: T): bool {
    return tryPush(self, value)
}

/// Sets the length to zero while retaining allocated capacity.
///
/// This drops initialized elements in place while retaining the buffer.
public func Vec.clear<T>(self: mut ref Vec<T>): void {
    clear(self)
}

/// Releases the owned buffer and resets the vector to empty.
///
/// Borrowed slices into that buffer become invalid. The destructor consumes
/// this `Vec` value automatically at scope exit.
@Destructor
func Vec.destroy<T>(self: own Vec<T>): void {
    destroyVec(self)
}
