import std.alloc.vec as vec

func main(): int {
    let mut values = vec.Vec<int>.new()
    if !values.tryReserve(9 as usize) {
        return -1
    }
    let mut next: int = 0
    while next < 9 {
        if !values.tryPush(next) {
            return -2
        }
        next = next + 1
    }
    if !values.set(8 as usize, 42) {
        return -3
    }
    let last = values.pop()
    let result = match last {
        Some(value) => value
        None => -4
    }
    let length = values.len() as int
    values.clear()
    let empty_pop = values.pop()
    let empty_result = match empty_pop {
        Some(_) => -5
        None => 0
    }
    return result + length + empty_result
}
