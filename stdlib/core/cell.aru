//! Simple value cells with explicit mutable access.
//!
//! ## Overview
//!
//! `Cell<T>` and `UnsafeCell<T>` store a value inline. The current public
//! methods read, replace, or consume that value; mutation requires a mutable
//! reference. Neither type provides mutual exclusion or atomic operations.
//! Use an appropriate synchronization mechanism when values are shared
//! between concurrent tasks.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.cell as cell
//!
//! let c = cell.unsafeCellNew(42)
//! let v = cell.UnsafeCell.intoInner(c)  // 42, consumes c
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Zero overhead on every supported platform.
//!
//! ## See also
//!
//! - `std.core.atomic` — atomic-style API; current operations are not atomic
//! - `std.runtime.mutex` — async mutex

module std.core.cell

/// Inline value wrapper without synchronization.
///
/// The current public API only exposes construction and consuming extraction.
/// Concurrent access requires external synchronization.
public struct UnsafeCell<T> {
    /// Stored value.
    value: T
}

/// Creates a new `UnsafeCell` containing `val`.
public func unsafeCellNew<T>(val: T): UnsafeCell<T> {
    return UnsafeCell<T> {
        value: val,
    }
}

/// Unwraps and returns the contained value.
public func UnsafeCell.intoInner<T>(self: own UnsafeCell<T>): T {
    return self.value
}

/// A mutable memory location for copyable types.
public struct Cell<T> {
    /// Stored value.
    value: T
}

/// Creates a new `Cell` containing `val`.
public func cellNew<T>(val: T): Cell<T> {
    return Cell<T> {
        value: val,
    }
}

/// Returns a copy of the contained value.
public func Cell.get<T>(self: ref Cell<T>): T {
    return self.value
}

/// Sets the contained value.
public func Cell.put<T>(self: mut ref Cell<T>, val: T): void {
    self.value = val
}

/// Replaces the contained value with `val`, returning the old value.
public func Cell.replace<T>(self: mut ref Cell<T>, val: T): T {
    let old = self.value
    self.value = val
    return old
}

/// Unwraps and returns the contained value.
public func Cell.intoInner<T>(self: own Cell<T>): T {
    return self.value
}
