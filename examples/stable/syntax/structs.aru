module examples.stable.syntax.structs

import io
from std.alloc.string import { String }

public struct User {
    public name: str
    age: int
}

func User.greet(shared self) : String {
    return "Ola, ${self.name}"
}

func main() {
    let user = User { name: "Ana", age: 30 }
    io.println(user.greet())
}
