//! Condition-variable prototype; registration/wakeup protocol is pending.
//!
//! ## Overview
//!
//! The current host wait uses parking/timeouts and notify is a placeholder.
//! Mutex release/reacquisition, lost-wakeup protection, cancellation and
//! cooperation with the executor are not implemented by this surface.
//!
//! ## Examples
//!
//! ```arandu
//! import std.sync.condvar as sync
//!
//! let cv = sync.Condvar.new()
//! cv.notifyOne()
//! ```
//!
//! ## Platform
//! `native` · `wasm32`
module std.sync.condvar

import std.core.atomic as atomic
import std.core.intrinsics as intrinsics

extern "C" {
    func ar_rt_condvar_wait(key: ptr[u8], seq: usize): void
    func ar_rt_condvar_notify_one(key: ptr[u8]): void
    func ar_rt_condvar_notify_all(key: ptr[u8]): void
    func ar_rt_thread_sleep_ms(ms: u64): void
}

/// A condition variable.
public struct Condvar {
    sequence: atomic.AtomicUsize,
}

/// Creates a new `Condvar`.
public func Condvar.new(): Condvar {
    return Condvar {
        sequence: atomic.AtomicUsize.new(0 as usize),
    }
}

/// Waits for a notification, waking cooperatively.
public func Condvar.wait(self: ref Condvar): void {
    let current = self.sequence.load(atomic.MemoryOrder.Acquire)
    unsafe {
        let key = (intrinsics.addressOfShared(self) as ptr[u8])
        ar_rt_condvar_wait(key, current)
    }
}

/// Wakes one task waiting on this condition variable.
public func Condvar.notifyOne(self: mut ref Condvar): void {
    let next = self.sequence.fetchAdd(1 as usize, atomic.MemoryOrder.Release)
    unsafe {
        let key = (intrinsics.addressOf(self) as ptr[u8])
        ar_rt_condvar_notify_one(key)
    }
}

/// Wakes all tasks waiting on this condition variable.
public func Condvar.notifyAll(self: mut ref Condvar): void {
    let next = self.sequence.fetchAdd(1 as usize, atomic.MemoryOrder.Release)
    unsafe {
        let key = (intrinsics.addressOf(self) as ptr[u8])
        ar_rt_condvar_notify_all(key)
    }
}

/// Waits for a notification or until `timeoutMs` expires.
///
/// Returns `true` if notified or `false` if the timeout elapsed.
public func Condvar.waitTimeout(self: ref Condvar, timeoutMs: u64): bool {
    let current = self.sequence.load(atomic.MemoryOrder.Acquire)
    let mut elapsed: u64 = 0 as u64
    let step: u64 = if timeoutMs < 10 as u64 { timeoutMs } else { 10 as u64 }
    while elapsed < timeoutMs {
        if self.sequence.load(atomic.MemoryOrder.Acquire) != current {
            return true
        }
        unsafe {
            ar_rt_thread_sleep_ms(step)
        }
        elapsed = elapsed + step
    }
    return self.sequence.load(atomic.MemoryOrder.Acquire) != current
}
