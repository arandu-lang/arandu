//! Canonical typed raw-pointer (`ptr<T>`) utilities.
//!
//! ## Overview
//!
//! `std.core.pointer` provides the most basic safe operations over raw
//! pointers: creating a null pointer, checking nullness, reinterpreting bits
//! across types and computing offsets by index.
//!
//! These functions are thin wrappers over `std.core.mem` intrinsics and
//! perform no allocation. Every raw-pointer use requires `unsafe {}`.
//!
//! Use raw pointers only when strictly necessary — FFI boundaries, allocators
//! and low-level data structures. For safe references, use `ref T` or
//! `mut ref T` in the Arandu type system.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.pointer as pointer
//!
//! unsafe {
//!     let p = pointer.null<i32>()
//!     pointer.isNull(p)  // true
//! }
//! ```
//!
//! ## Safety
//!
//! - Dereferencing a null pointer traps via `intrinsics.abort()`.
//! - Pointer arithmetic is bounds-unchecked — the caller guarantees validity.
//! - Raw pointers carry no compiler-tracked lifetime.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! wasm32 lowers to linear-memory arithmetic; bare-metal gets direct MMIO
//! and register access.
//!
//! ## See also
//!
//! - `std.core.mem` — `size_of`, `align_of` and memory intrinsics
//! - `std.core.intrinsics` — traps and low-level builtins

module std.core.pointer

/// Returns a null pointer (`nil`) typed as `ptr[T]`.
///
/// # Examples
/// ```arandu
/// let p = pointer.null<int>()
/// pointer.isNull(p) // true
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func null<T>(): ptr[T]? {
    return nil
}

/// Returns `true` if the pointer `p` is null (`nil`).
///
/// # Examples
/// ```arandu
/// let p = pointer.null<int>()
/// pointer.isNull(p) // true
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isNull<T>(p: ptr[T]?): bool {
    let nullp: ptr[T]? = nil
    return p == nullp
}

// Dereference and pointer arithmetic intentionally remain in `std.core.mem`.
// Those operations are compiler intrinsics and require explicit acknowledgement
// of validity, alignment, and lifetime invariants via `unsafe` blocks.
