//! Bounded channel for cooperative communication.
//!
//! ## Overview
//!
//! `Channel<T>` stores values in a ring buffer. `trySend` and `tryRecv` are
//! immediate operations; close stops further sends. The fields and methods
//! use ordinary memory accesses, so concurrent threads need external
//! synchronization.
//!
//! ## Safety
//! `trySend` returns `false` when the buffer is full or closed. `tryRecv`
//! returns `None` when no value is available. These are immediate operations,
//! not blocking waits.
//!
//! ## Allocations
//! `Channel.new` allocates its bounded ring buffer; heap storage is released automatically on drop.
//!
//! ## Platform
//! `native` · `wasm32`

module std.runtime.channel

/// SL_R — Concurrency: Bounded Ring-Buffer `Channel<T>` (DoD Zero-Alloc).
///
/// Moved out of the former `std.runtime` monolith.

import std.core.mem as mem
import std.core.intrinsics as intrinsics

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: usize): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
}

/// Bounded contiguous FIFO ring-buffer channel.
///
/// Pre-allocates buffer storage for `cap` elements; zero allocations during send/recv.
public struct Channel<T> {
    /// Ring buffer storage for channel values.
    buf: ptr[Option<T>]
    /// Maximum number of buffered values.
    cap: uint
    /// Index of the next element to receive.
    head: uint
    /// Index of the next slot to send into.
    tail: uint
    /// Current number of buffered values.
    len: uint
    /// Whether the channel has been closed.
    is_closed: bool
}

/// Allocates a ring buffer for `capacity` values, initially empty.
///
/// A requested capacity of zero is treated as one. The current constructor
/// does not return an allocation error; invalid sizes and allocation failure
/// abort before the buffer is accessed. The ring buffer is released automatically on drop.
public func Channel.new<T>(capacity: uint): Channel<T> {
    let cap = if capacity == 0 { 1 as uint } else { capacity }
    let elem_size = mem.sizeOf<Option<T>>()
    let max_bytes: usize = 2147483647 as usize
    if elem_size == (0 as usize) || (cap as usize) > max_bytes || (cap as usize) > max_bytes / elem_size {
        unsafe { intrinsics.abort() }
    }
    let byte_size = (cap as usize) * elem_size
    let raw = unsafe { ar_vec_malloc(byte_size) }
    let nullp: ptr[u8] = nil
    if raw == nullp {
        unsafe { intrinsics.abort() }
    }
    let p = raw as ptr[Option<T>]
    let mut i = 0 as uint
    while i < cap {
        unsafe {
            let slot = mem.ptrOffset<Option<T>>(p, i as isize)
            mem.ptrWrite<Option<T>>(slot, Option.None)
        }
        i = i + 1
    }
    return Channel<T> {
        buf: p,
        cap: cap,
        head: 0,
        tail: 0,
        len: 0,
        is_closed: false,
    }
}

/// Allocates a ring buffer for `capacity` values; equivalent to `Channel.new`.
public func Channel.withCapacity<T>(capacity: uint): Channel<T> {
    return Channel.new<T>(capacity)
}

/// Returns the number of items currently buffered in the channel.
public func Channel.len<T>(self: ref Channel<T>): uint {
    return self.len
}

/// Returns the maximum capacity of the channel.
public func Channel.capacity<T>(self: ref Channel<T>): uint {
    return self.cap
}

/// Returns `true` if the channel has no buffered items.
public func Channel.isEmpty<T>(self: ref Channel<T>): bool {
    return self.len == 0
}

/// Returns `true` if the channel is at maximum capacity.
public func Channel.isFull<T>(self: ref Channel<T>): bool {
    return self.len == self.cap
}

/// Returns `true` if the channel has been closed.
public func Channel.isClosed<T>(self: ref Channel<T>): bool {
    return self.is_closed
}

/// Marks the channel closed without discarding buffered values.
///
/// Later `trySend` calls return `false`; `tryRecv` can still drain existing
/// items. Calling `close` again leaves it closed.
public func Channel.close<T>(self: mut ref Channel<T>): void {
    self.is_closed = true
}

/// Adds `val` to the ring and returns `true` when space is available.
///
/// Returns `false` immediately when full or closed. No allocation occurs
/// during a successful send; the caller must handle a rejected value.
public func Channel.trySend<T>(self: mut ref Channel<T>, val: T): bool {
    if self.is_closed || self.len == self.cap {
        return false
    }
    unsafe {
        let slot = mem.ptrOffset<Option<T>>(self.buf, self.tail as isize)
        mem.ptrWrite<Option<T>>(slot, Option.Some(val))
    }
    self.tail = (self.tail + 1) % self.cap
    self.len = self.len + 1
    return true
}

/// Removes and returns the oldest buffered item as `Some`.
///
/// Returns `None` immediately when empty, whether open or closed. A receive
/// frees one ring slot for a future send while the channel remains open.
public func Channel.tryRecv<T>(self: mut ref Channel<T>): Option<T> {
    if self.len == 0 {
        return Option.None
    }
    let opt = unsafe {
        let slot = mem.ptrOffset<Option<T>>(self.buf, self.head as isize)
        let item = mem.ptrRead<Option<T>>(slot)
        mem.ptrWrite<Option<T>>(slot, Option.None)
        item
    }
    self.head = (self.head + 1) % self.cap
    self.len = self.len - 1
    return opt
}

/// Internal helper that drops remaining buffered values and frees the ring buffer.
func destroyChannel<T>(c: mut ref Channel<T>): void {
    unsafe {
        let nullp: ptr[Option<T>] = nil
        if c.buf != nullp {
            let mut i = 0 as uint
            while i < c.cap {
                let slot = mem.ptrOffset<Option<T>>(c.buf, i as isize)
                mem.dropInPlace<Option<T>>(slot)
                i = i + 1
            }
            let byte_size = (c.cap as usize) * mem.sizeOf<Option<T>>()
            ar_vec_buf_free(c.buf as ptr[u8], byte_size)
            c.buf = nullp
            c.len = 0
        }
    }
}

/// Automatic destructor invoked when an owned `Channel<T>` leaves scope.
@Destructor
func Channel.destroy<T>(self: own Channel<T>): void {
    destroyChannel<T>(self)
}
