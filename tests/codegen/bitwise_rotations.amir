Func rotr(x: u32, n: u32) -> u32
  locals:
    _0: u32 // return
    _1: u32
    _2: u32
    _3: u32
    _4: u32
    _5: u32
    _6: u32
    _7: u32
    _8: u32
    _9: u32
    _10: u32
    _11: u32
    _12: u32
    s0: u32 // x
    s1: u32 // n
    s2: u32 // right
    s3: u32 // left

  bb0:
    _5 = shr _1, _2
    _8 = 32
    _9 = sub _8, _2
    _10 = shl _1, _9
    _0 = bitor _5, _10
    return

Func main() -> u32
  locals:
    _0: u32 // return
    _1: u32
    s0: u32 // val

  bb0:
    _1 = 0x12345678
    _0 = call fn@rotr(_1, 8)
    return
