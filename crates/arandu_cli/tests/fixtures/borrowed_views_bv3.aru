module codegen.borrowed_views_bv3
import std.alloc.vec as vec
import std.core.slice as slice

func main(): int {
    let mut values = vec.Vec<int>.new()
    values.push(5)
    values.push(8)
    let view = values.asSlice()
    match slice.subslice<int>(view, 1, 1) {
        Some(tail) => {
            match slice.first<int>(tail) {
                Some(item) => { return *item }
                None => { return 2 }
            }
        }
        None => { return 3 }
    }
}
