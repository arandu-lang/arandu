module examples.minimal.m10_path_empty_windows

// Windows variant of m10_path_empty. `std.path` follows host semantics.
import std.path as path

func main(): int {
    let empty = path.Path.from("")
    if !empty.isEmpty() {
        return 1
    }
    let nonEmpty = path.Path.from("x")
    if nonEmpty.isEmpty() {
        return 2
    }

    let driveRoot = path.Path.from("C:\\")
    if !driveRoot.isAbsolute() {
        return 3
    }
    let rel = path.Path.from("rel")
    if rel.isAbsolute() {
        return 4
    }
    let dotRel = path.Path.from(".\\x")
    if dotRel.isAbsolute() {
        return 5
    }

    let baseA = path.Path.from("a")
    let joinedAb = path.Path.from(baseA.joinStr("b")).fileName()
    if joinedAb.asStr() != "b" {
        return 6
    }
    let winTmp = path.Path.from("C:\\tmp")
    let joinedTmp = path.Path.from(winTmp.joinStr("x")).fileName()
    if joinedTmp.asStr() != "x" {
        return 7
    }
    let joinedAbs = path.Path.from(winTmp.joinStr("C:\\abs")).fileName()
    if joinedAbs.asStr() != "abs" {
        return 8
    }

    let winLeaf = path.Path.from("C:\\tmp\\leaf").fileName()
    if winLeaf.asStr() != "leaf" {
        return 9
    }
    return 0
}
