module examples.minimal.m20_str

// Minimal 0.1 — std.core.str pure heapless (isEmpty / len / startsWith / endsWith / contains / find).
import std.core.str as s

func main(): int {
    if !s.isEmpty("") {
        return 1
    }
    if s.isEmpty("x") {
        return 2
    }
    if s.len("hi") != 2 {
        return 3
    }
    if !s.startsWith("hello", "he") {
        return 4
    }
    if s.startsWith("hello", "x") {
        return 5
    }
    if !s.endsWith("hello", "lo") {
        return 6
    }
    if !s.contains("hello world", "world") {
        return 7
    }
    if s.contains("hello world", "xyz") {
        return 8
    }
    match s.find("hello world", "world") {
        Some(idx) => {
            if idx != 6 {
                return 9
            }
        }
        None => {
            return 10
        }
    }

    // Inherent method syntax on str
    let greeting = "hello world"
    if !"".isEmpty() {
        return 11
    }
    if greeting.isEmpty() {
        return 12
    }
    if greeting.len() != 11 {
        return 13
    }
    if !greeting.startsWith("hello") {
        return 14
    }
    if greeting.startsWith("world") {
        return 15
    }
    if !greeting.endsWith("world") {
        return 16
    }
    if !greeting.contains("lo wo") {
        return 17
    }
    match greeting.find("world") {
        Some(idx) => {
            if idx != 6 {
                return 18
            }
        }
        None => {
            return 19
        }
    }
    if greeting.charCount() != 11 {
        return 20
    }

    return 0
}
