//! Convenience re-exports of the most used stdlib utilities.
//!
//! ## Overview
//!
//! The prelude gathers the most used stdlib types and functions in a single
//! import: `Option<T>` and `Result<T, E>`, raw `ptr<T>`, coroutine `Poll<T>`,
//! `size_of`/`align_of` layout queries, `Ordering`, slices (`[]T`), strings
//! (`str`), checked arithmetic via `std.core.num`, char and ASCII utilities,
//! generic `Hash`/`Hasher` and `Iterator<T>`.
//!
//! Core items (`Option`, `Result`, `Poll`, `Range`, `RangeInclusive`,
//! `Ordering`, `Iterator`, `Copy`, `Clone`, `Send`, `Sync`) and, outside
//! `std.*`, the foundational heap/I/O prelude (`String`, `Vec`, `Box`,
//! `str.toString`, `io`, `err`, `println`, `print`, `eprint`) are injected
//! into the prelude scope automatically and may be shadowed by any local
//! declaration or explicit `import`.
//!
//! Importing `std.core.prelude` explicitly remains supported for convenience
//! re-exports such as checked arithmetic helpers and `Cell`/`UnsafeCell`.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Available on every supported platform: it only re-exports.
//!
//! ## See also
//!
//! - `std.core.option` — `Option<T>` documentation
//! - `std.core.result` — `Result<T, E>` documentation
//! - `std.core.iter` — `Iterator<T>` documentation

module std.core.prelude



// Canonical re-exports via RFC 0021
public use std.core.option.{ Option }
public use std.core.result.{ Result }
public use std.core.future.{ Poll }
public use std.core.num.{ checkedAdd, checkedSub, checkedMul, saturatingAdd, saturatingSub }
public use std.core.cmp.{ Ordering }
public use std.core.iter.{ Iterator }
public use std.core.marker.{ Copy, Clone, Send, Sync, PhantomData, phantom }
public use std.core.cell.{ Cell, UnsafeCell }
