import std.alloc.vec as vec
import std.core.slice as slice

func main(): int {
    let mut values = vec.Vec<int>.new()
    if !values.tryPush(17) {
        return -1
    }
    let vector_len = values.len()
    let slice_len = slice.len<int>(values.asSlice())
    return (vector_len + slice_len) as int
}
