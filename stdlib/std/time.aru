//! Monotonic instants and typed durations.
//!
//! ## Overview
//!
//! `Duration` represents nanosecond intervals and converts between time units. `Instant` represents a monotonic clock reading for elapsed-time measurements.
//!
//! ## Example
//!
//! ```arandu
//! import std.time as time
//!
//! let delay = time.durationFromMillis(250)
//! let nanos = delay.asNanos()
//! ```
//!
//! ## Safety
//! Use `Instant` for elapsed monotonic time, not wall-clock timestamps.
//! Duration arithmetic uses signed nanoseconds; inspect the individual
//! methods before relying on behavior near integer limits.
//!
//! ## Platform
//! `native`

module std.time

/// Clocks and high-precision temporal measurements.
///
/// Provides strongly-typed `Instant` (monotonic point in time) and `Duration`
/// (time interval) representations, preventing unit confusion (seconds vs ms vs ns)
/// without any heap allocation or object boxing.

extern "C" {
    /// Nanoseconds since an arbitrary process-local epoch.
    func ar_time_monotonic_ns(): int
}

/// Reads the host's monotonic clock in nanoseconds from an arbitrary origin.
///
/// Use differences between readings for elapsed time; the absolute value is
/// not a calendar timestamp. No heap allocation is involved.
public func monotonicNs(): int {
    unsafe {
        return ar_time_monotonic_ns()
    }
}

/// Represents a span of time with nanosecond precision.
public struct Duration {
    /// Length of this interval in nanoseconds.
    nanos: int
}

/// Wraps a signed nanosecond count without changing its value.
///
/// Negative durations are representable. No allocation is involved.
public func durationFromNanos(ns: int): Duration {
    return Duration { nanos: ns }
}

/// Converts signed microseconds to nanoseconds by multiplying by 1,000.
///
/// No overflow check is performed by this function.
public func durationFromMicros(us: int): Duration {
    return Duration { nanos: us * 1000 }
}

/// Converts signed milliseconds to nanoseconds by multiplying by 1,000,000.
///
/// No overflow check is performed by this function.
public func durationFromMillis(ms: int): Duration {
    return Duration { nanos: ms * 1000000 }
}

/// Converts signed seconds to nanoseconds by multiplying by 1,000,000,000.
///
/// No overflow check is performed by this function.
public func durationFromSecs(s: int): Duration {
    return Duration { nanos: s * 1000000000 }
}

/// Returns the total number of whole seconds in this duration.
public func Duration.asSecs(self: ref Duration): int {
    return self.nanos / 1000000000
}

/// Returns the total number of whole milliseconds in this duration.
public func Duration.asMillis(self: ref Duration): int {
    return self.nanos / 1000000
}

/// Returns the total number of whole microseconds in this duration.
public func Duration.asMicros(self: ref Duration): int {
    return self.nanos / 1000
}

/// Returns the total number of nanoseconds in this duration.
public func Duration.asNanos(self: ref Duration): int {
    return self.nanos
}

/// Returns `nanos % 1,000,000,000`.
///
/// For a negative duration the remainder can also be negative; callers
/// requiring a nonnegative subsecond field must normalize it themselves.
public func Duration.subsecNanos(self: ref Duration): int {
    return self.nanos % 1000000000
}

/// Returns `true` if this duration spans 0 nanoseconds.
public func Duration.isZero(self: ref Duration): bool {
    return self.nanos == 0
}

/// Adds the signed nanosecond counts and returns a new duration.
///
/// This function performs no overflow check and does not allocate.
public func Duration.add(self: ref Duration, other: Duration): Duration {
    return Duration { nanos: self.nanos + other.nanos }
}

/// Subtracts `other` from this duration, returning zero when `other` is larger.
///
/// Comparison uses signed nanosecond values. The subtraction itself has no
/// overflow check.
public func Duration.sub(self: ref Duration, other: Duration): Duration {
    if self.nanos < other.nanos {
        return Duration { nanos: 0 }
    }
    return Duration { nanos: self.nanos - other.nanos }
}

/// Measurement of a monotonically non-decreasing clock.
///
/// Instants are opaque and only useful for calculating intervals with `elapsed`
/// or `durationSince`.
public struct Instant {
    /// Monotonic clock reading in nanoseconds.
    nanos: int
}

/// Captures the current monotonic clock reading as an `Instant`.
///
/// Its numeric value has no calendar meaning. Use `elapsed` or
/// `durationSince` to obtain a duration.
public func now(): Instant {
    return Instant { nanos: monotonicNs() }
}

/// Reads the clock and returns the nonnegative time since this instant.
///
/// If the new reading is earlier than the stored one, the result is zero.
/// This method makes a fresh clock call each time.
public func Instant.elapsed(self: ref Instant): Duration {
    let current = monotonicNs()
    if current < self.nanos {
        return Duration { nanos: 0 }
    }
    return Duration { nanos: current - self.nanos }
}

/// Returns the nonnegative interval from `earlier` to this instant.
///
/// If this instant precedes `earlier`, the result is zero. This method only
/// compares stored readings; it does not call the clock.
public func Instant.durationSince(self: ref Instant, earlier: Instant): Duration {
    if self.nanos < earlier.nanos {
        return Duration { nanos: 0 }
    }
    return Duration { nanos: self.nanos - earlier.nanos }
}
