module examples.minimal.m19_allocator

// Minimal 0.1 — allocator_api thin with Result<_, AllocError> + bump align.
// Alias cannot be `alloc` (reserved builtin).
import std.alloc.allocator_api as aapi

func work(): Result<int, aapi.AllocError> {
    let p = aapi.globalAlloc(16)?
    let resized = unsafe { aapi.globalRealloc(p, 16, 32) }
    let q = resized?
    unsafe { aapi.globalDealloc(q, 32) }

    let mut arena = aapi.BumpArena.tryNew(64)?
    let _a = arena.alloc(8, 8)?
    let _b = arena.alloc(8, 8)?
    let rem = arena.remaining() as int
    arena.reset()
    let rem2 = arena.remaining() as int
    // 48 + 64 = 112
    return Result.Ok(rem + rem2)
}

func main(): int {
    return match work() {
        Ok(value) => value
        Err(_) => -1
    }
}
