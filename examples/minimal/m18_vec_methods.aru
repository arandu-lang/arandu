module examples.minimal.m18_vec_methods

// Minimal 0.1 — method-style Vec (receiver mono; PROMOTE method thin).
// Read copies use the `getCopy` method guarded by the `Copy` bound.
import std.alloc.vec as vec

func main(): int {
    let mut v = vec.Vec<int>.new()
    if !v.isEmpty() {
        return 90
    }
    v.push(10)
    v.push(20)
    v.push(30)
    if !v.set(1, 5) {
        return 1
    }
    let n = v.len() as int
    let g0 = v.getCopy(0)
    let g1 = v.getCopy(1)
    let g2 = v.getCopy(2)
    match g0 {
        Some(a) => {
            match g1 {
                Some(b) => {
                    match g2 {
                        Some(c) => {
                            let p = v.pop()
                            match p {
                                Some(last) => {
                                    // 10+5+30+3+30 = 78 (same checksum as free-func m13)
                                    return a + b + c + n + last
                                }
                                None => {
                                    return 2
                                }
                            }
                        }
                        None => {
                            return 3
                        }
                    }
                }
                None => {
                    return 4
                }
            }
        }
        None => {
            return 5
        }
    }
}
