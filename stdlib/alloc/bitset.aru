//! Dense, growable sets of nonnegative bit indexes.
//!
//! ## Overview
//!
//! `BitSet` stores bits in 64-bit words. Insert, remove, membership, and set operations work on the owned word buffer.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.bitset as bitset
//!
//! let mut flags = bitset.bitsetNew()
//! flags.insert(3)
//! let present = flags.contains(3)
//! ```
//!
//! ## Complexity
//! Membership and bit updates index a word in O(1) time; set operations
//! traverse the occupied words. Growing to a higher bit may reallocate.
//!
//! ## Allocations
//! `bitsetNew` starts empty; storage grows as bits beyond capacity are added.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.bitset

import std.alloc.vec as vec
import std.core.option as option

/// Dense bitset stored as an array of 64-bit words.
///
/// Designed for high cache locality and word-parallel set operations (DoD/SoA).
public struct BitSet {
    /// Owned vector of 64-bit bit words.
    words: vec.Vec<u64>
    /// Number of bit positions represented by the word buffer.
    nbits: uint
}

/// Creates an empty set without allocating a word buffer.
///
/// A later `insert` grows the buffer to include the requested bit.
public func bitsetNew(): BitSet {
    return BitSet {
        words: vec.new<u64>(),
        nbits: 0,
    }
}

/// Creates an empty set with storage for at least `bits` bit positions.
///
/// All words start cleared. `contains` is therefore false for every bit,
/// including indexes below `bits`. This allocates and initializes
/// `(bits + 63) / 64` words; `bits` is a storage request, not a set-bit count.
public func bitsetWithCapacity(bits: uint): BitSet {
    let wordCount = (bits + 63) / 64
    let mut words = vec.withCapacity<u64>(wordCount)
    let mut i: uint = 0
    while i < wordCount {
        vec.push<u64>(words, 0 as u64)
        i = i + 1
    }
    return BitSet {
        words: words,
        nbits: bits,
    }
}

/// Returns whether `bit` is set. Bits beyond the current word buffer are unset.
///
/// This lookup does not grow the set or allocate.
public func BitSet.contains(self: ref BitSet, bit: uint): bool {
    let wordIdx = bit / 64
    let bitIdx = bit % 64
    if wordIdx >= vec.len<u64>(self.words) {
        return false
    }
    match vec.get<u64>(self.words, wordIdx) {
        Some(w) => {
            let mask: u64 = (1 as u64) << (bitIdx as u64)
            return (w & mask) != (0 as u64)
        }
        None => {
            return false
        }
    }
}

/// Sets `bit` and returns `true` only when it changed from unset to set.
///
/// Inserting a higher index extends the word buffer with zeroed words and may
/// allocate. Inserting a bit that is already set leaves the set unchanged.
public func BitSet.insert(self: mut ref BitSet, bit: uint): bool {
    let wordIdx = bit / 64
    let bitIdx = bit % 64
    while wordIdx >= vec.len<u64>(self.words) {
        vec.push<u64>(self.words, 0 as u64)
    }
    match vec.get<u64>(self.words, wordIdx) {
        Some(w) => {
            let mask: u64 = (1 as u64) << (bitIdx as u64)
            if (w & mask) != (0 as u64) {
                return false
            }
            vec.put<u64>(self.words, wordIdx, w | mask)
            if bit >= self.nbits {
                self.nbits = bit + 1
            }
            return true
        }
        None => {
            return false
        }
    }
}

/// Clears `bit` and returns `true` only when it was previously set.
///
/// Out-of-range bits return `false`. Removing a bit does not shrink the word
/// buffer or reduce the recorded bit range.
public func BitSet.remove(self: mut ref BitSet, bit: uint): bool {
    let wordIdx = bit / 64
    let bitIdx = bit % 64
    if wordIdx >= vec.len<u64>(self.words) {
        return false
    }
    match vec.get<u64>(self.words, wordIdx) {
        Some(w) => {
            let mask: u64 = (1 as u64) << (bitIdx as u64)
            if (w & mask) == (0 as u64) {
                return false
            }
            vec.put<u64>(self.words, wordIdx, w & (~mask))
            return true
        }
        None => {
            return false
        }
    }
}

/// Clears every bit while retaining the allocated word buffer for reuse.
///
/// The recorded bit range becomes zero. This visits each allocated word and
/// does not deallocate storage.
public func BitSet.clear(self: mut ref BitSet): void {
    let total = vec.len<u64>(self.words)
    let mut i: uint = 0
    while i < total {
        vec.put<u64>(self.words, i, 0 as u64)
        i = i + 1
    }
    self.nbits = 0
}

/// Replaces this set with its union with `other`.
///
/// The buffer grows if `other` has more words; existing bits outside
/// `other`'s range remain set. Runs in O(other word count), plus any growth.
public func BitSet.unionWith(self: mut ref BitSet, other: ref BitSet): void {
    let otherLen = vec.len<u64>(other.words)
    while vec.len<u64>(self.words) < otherLen {
        vec.push<u64>(self.words, 0 as u64)
    }
    let mut i: uint = 0
    while i < otherLen {
        let wSelf = vec.get<u64>(self.words, i).unwrapOr(0 as u64)
        let wOther = vec.get<u64>(other.words, i).unwrapOr(0 as u64)
        vec.put<u64>(self.words, i, wSelf | wOther)
        i = i + 1
    }
    if other.nbits > self.nbits {
        self.nbits = other.nbits
    }
}

/// Keeps only bits present in both sets.
///
/// Words beyond `other`'s range are cleared. The operation visits every word
/// in `self` and retains its storage and recorded bit range.
public func BitSet.intersectWith(self: mut ref BitSet, other: ref BitSet): void {
    let selfLen = vec.len<u64>(self.words)
    let otherLen = vec.len<u64>(other.words)
    let mut i: uint = 0
    while i < selfLen {
        if i < otherLen {
            let wSelf = vec.get<u64>(self.words, i).unwrapOr(0 as u64)
            let wOther = vec.get<u64>(other.words, i).unwrapOr(0 as u64)
            vec.put<u64>(self.words, i, wSelf & wOther)
        } else {
            vec.put<u64>(self.words, i, 0 as u64)
        }
        i = i + 1
    }
}

/// Removes from this set every bit that is set in `other`.
///
/// Bits beyond `other`'s range are unchanged. The operation visits every
/// word in `self` and retains its storage and recorded bit range.
public func BitSet.differenceWith(self: mut ref BitSet, other: ref BitSet): void {
    let selfLen = vec.len<u64>(self.words)
    let otherLen = vec.len<u64>(other.words)
    let mut i: uint = 0
    while i < selfLen {
        if i < otherLen {
            let wSelf = vec.get<u64>(self.words, i).unwrapOr(0 as u64)
            let wOther = vec.get<u64>(other.words, i).unwrapOr(0 as u64)
            vec.put<u64>(self.words, i, wSelf & (~wOther))
        }
        i = i + 1
    }
}

/// Counts the set bits across the entire allocated word buffer.
///
/// Runs in O(words + set bits) time and does not allocate.
public func BitSet.countOnes(self: ref BitSet): uint {
    let total = vec.len<u64>(self.words)
    let mut count: uint = 0
    let mut i: uint = 0
    while i < total {
        let mut w = vec.get<u64>(self.words, i).unwrapOr(0 as u64)
        while w != (0 as u64) {
            w = w & (w - (1 as u64))
            count = count + 1
        }
        i = i + 1
    }
    return count
}
