//! Heap-backed SwissTable hash map for keys implementing `Hash`.
//!
//! ## Overview
//!
//! `HashMap<K, V>` stores key-value entries in a flat bucket array indexed by an open-addressing control table (`ctrl`) probed 16 bytes at a time via SIMD (`std.core.simd.U8x16`). Hashes are derived through `std.core.hash`.
//!
//! ## Complexity
//! Lookup, insertion, and removal compare 16 metadata control tags (`h2`) per group in O(1) expected time. Resizing visits existing entries and allocates a larger bucket and control array.
//!
//! ## Safety
//! Keys must produce equal hashes whenever `Hash.eq` considers them equal. Bucket transfers use `Vec.takeSome` and `Vec.set` so owned values are not shallow-copied.
//! Mutating a key in storage can make it unreachable by lookup.
//!
//! ## Allocations
//! `new` starts without buckets; insertion or `withCapacity` obtains storage.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.hash_map

import std.alloc.vec as vec
import std.core.hash as hash
import std.core.marker as marker
import std.core.intrinsics as intrinsics
import std.core.option as option
import std.core.simd as simd

const MAX_BUCKETS = 1073741824 as usize
const CTRL_EMPTY: u8 = 0x80 as u8
const CTRL_DELETED: u8 = 0xFE as u8
const GROUP_WIDTH: usize = 16 as usize

func capacityFailure(): void {
    unsafe { intrinsics.abort() }
}

/// An entry within a `HashMap` bucket.
public struct Entry<K, V> {
    /// Cached hash of the key.
    hash: u64
    /// Stored map key.
    key: K
    /// Stored value.
    value: V
}

/// Fast flat hash table using SwissTable 16-slot SIMD control-byte probing.
///
/// # Design
/// - 1-byte metadata (`ctrl`) per bucket plus a 16-byte mirror tail for wrapless unaligned SIMD group loads.
/// - Top 7 bits of the 64-bit hash serve as `h2` (`0x00..=0x7F`); empty (`0x80`) and deleted (`0xFE`) carry bit 7 (`0x80`).
/// - Load factor threshold is 75% with power-of-two growth starting at 8 buckets; tombstone accumulation cleans in place.
public struct HashMap<K: hash.Hash, V> {
    /// Owned bucket array (`Option<Entry<K, V>>`).
    buckets: vec.Vec<Option<Entry<K, V>>>
    /// Control bytes (`cap + 16` when `cap >= 8`, empty otherwise).
    ctrl: vec.Vec<u8>
    /// Number of active entries.
    len: usize
    /// Number of deleted tombstone slots in `ctrl`.
    tombstones: usize
    /// Bit mask (`cap - 1`) used to wrap probe offsets.
    mask: usize
}

/// Computes the 64-bit FNV-1a hash supplied by `key`'s `Hash` implementation.
///
/// Keys considered equal by `Hash.eq` must yield the same hash for lookups to
/// find them. This function does not access or modify a map.
public func hashKey<K: hash.Hash>(k: ref K): u64 {
    let mut h = hash.FnvHasher.new()
    k.hash(mut ref h)
    return h.finish()
}

func h2(h: u64): u8 {
    return ((h >> (57 as u64)) as u8) & (0x7F as u8)
}

func loadCtrlGroup(ctrl: ref vec.Vec<u8>, pos: usize): simd.U8x16 {
    let ctrlSlice = ctrl.asSlice()
    return unsafe {
        simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(ctrlSlice, pos, GROUP_WIDTH))
    }
}

func setCtrl(ctrl: mut ref vec.Vec<u8>, cap: usize, idx: usize, tag: u8): void {
    ctrl.set(idx, tag);
    if cap == (8 as usize) {
        ctrl.set(idx + (8 as usize), tag);
    } else if idx < GROUP_WIDTH {
        ctrl.set(cap + idx, tag);
    }
}

func initStorage<K, V>(cap: usize, outBuckets: mut ref vec.Vec<Option<Entry<K, V>>>, outCtrl: mut ref vec.Vec<u8>): void {
    let mut i: usize = 0 as usize
    while i < cap {
        outBuckets.push(Option.None)
        i = i + (1 as usize)
    }
    let ctrlLen = cap + GROUP_WIDTH
    let mut c: usize = 0 as usize
    while c < ctrlLen {
        outCtrl.push(CTRL_EMPTY)
        c = c + (1 as usize)
    }
}

func new<K: hash.Hash, V>(): HashMap<K, V> {
    return HashMap<K, V> {
        buckets: vec.Vec<Option<Entry<K, V>>>.new(),
        ctrl: vec.Vec<u8>.new(),
        len: 0 as usize,
        tombstones: 0 as usize,
        mask: 0 as usize,
    }
}

/// Creates a new empty `HashMap` with zero heap allocation until first insertion.
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func HashMap.new<K: hash.Hash, V>(): HashMap<K, V> {
    return new<K, V>()
}

func withCapacity<K: hash.Hash, V>(minCap: usize): HashMap<K, V> {
    if minCap > MAX_BUCKETS {
        capacityFailure()
    }
    let mut cap: usize = 8 as usize
    while cap < minCap {
        if cap > MAX_BUCKETS / (2 as usize) {
            capacityFailure()
        }
        cap = cap * (2 as usize)
    }
    let mut buckets = vec.Vec<Option<Entry<K, V>>>.withCapacity(cap)
    let mut ctrl = vec.Vec<u8>.withCapacity(cap + GROUP_WIDTH)
    initStorage<K, V>(cap, mut ref buckets, mut ref ctrl)
    return HashMap<K, V> {
        buckets: buckets,
        ctrl: ctrl,
        len: 0 as usize,
        tombstones: 0 as usize,
        mask: cap - (1 as usize),
    }
}

/// Creates an empty map with at least `minCap` buckets allocated.
///
/// Bucket count is rounded up to a power of two, with a minimum of eight.
/// `capacity()` reports bucket count, not the number of entries that fit
/// before growth: insertion resizes when occupancy would exceed 75%.
///
/// # Complexity
/// Time: O(cap) | Space: O(cap)
public func HashMap.withCapacity<K: hash.Hash, V>(minCap: usize): HashMap<K, V> {
    return withCapacity<K, V>(minCap)
}

func len<K: hash.Hash, V>(self: ref HashMap<K, V>): usize {
    return self.len
}

/// Returns the number of key-value pairs in the map.
public func HashMap.len<K: hash.Hash, V>(self: ref HashMap<K, V>): usize {
    return self.len
}

func isEmpty<K: hash.Hash, V>(self: ref HashMap<K, V>): bool {
    return self.len == (0 as usize)
}

/// Returns `true` if the map contains no elements.
public func HashMap.isEmpty<K: hash.Hash, V>(self: ref HashMap<K, V>): bool {
    return self.len == (0 as usize)
}

func capacity<K: hash.Hash, V>(self: ref HashMap<K, V>): usize {
    return self.buckets.len()
}

/// Returns the current number of buckets, including empty buckets.
///
/// The map can store fewer entries than this before its 75% growth threshold
/// triggers a resize. A map from `HashMap.new()` reports zero until first insertion.
public func HashMap.capacity<K: hash.Hash, V>(self: ref HashMap<K, V>): usize {
    return capacity(self)
}

func clear<K: hash.Hash, V>(self: mut ref HashMap<K, V>): void {
    let cap = self.buckets.len()
    let mut i: usize = 0 as usize
    while i < cap {
        self.buckets.set(i, Option.None);
        i = i + (1 as usize)
    }
    let ctrlLen = self.ctrl.len()
    let mut c: usize = 0 as usize
    while c < ctrlLen {
        self.ctrl.set(c, CTRL_EMPTY);
        c = c + (1 as usize)
    }
    self.len = 0 as usize
    self.tombstones = 0 as usize
}

/// Removes all entries while retaining the allocated bucket array.
///
/// The next insertion can reuse that storage. This visits every bucket in
/// O(bucket count) time and does not allocate.
public func HashMap.clear<K: hash.Hash, V>(self: mut ref HashMap<K, V>): void {
    clear(self)
}

/// Releases the entries owned by the map; backing buffers are dropped
/// automatically by field-drop elaboration.
@Destructor
func HashMap.destroy<K: hash.Hash, V>(self: own HashMap<K, V>): void {
    clear(self)
}

func findIndex<K: hash.Hash, V>(self: ref HashMap<K, V>, key: ref K, h: u64): Option<usize> {
    let cap = self.buckets.len()
    if cap == (0 as usize) {
        return Option.None
    }
    let ctrlSlice = self.ctrl.asSlice()
    let bucketSlice = self.buckets.asSlice()
    let groupMask: u32 = if cap == (8 as usize) { 0xFF as u32 } else { 0xFFFF as u32 }
    let tag = h2(h)
    let h2Vec = simd.U8x16.splat(tag)
    let emptyVec = simd.U8x16.splat(CTRL_EMPTY)
    let mut pos = (h as usize) & self.mask
    let mut stride: usize = 0 as usize
    let mut steps: usize = 0 as usize
    while steps < cap {
        let group = unsafe {
            simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(ctrlSlice, pos, GROUP_WIDTH))
        }
        let mut matchMask = group.eq(h2Vec).bitmask() & groupMask
        while matchMask != (0 as u32) {
            let bit = intrinsics.bitTrailingZeros32(matchMask) as usize
            let idx = (pos + bit) & self.mask
            match bucketSlice[idx].asRef() {
                Some(entry) => {
                    if entry.hash == h && entry.key.eq(key) {
                        return Option.Some(idx)
                    }
                }
                None => {}
            }
            matchMask = matchMask & (matchMask - (1 as u32))
        }
        if (group.eq(emptyVec).bitmask() & groupMask) != (0 as u32) {
            return Option.None
        }
        stride = stride + GROUP_WIDTH
        pos = (pos + stride) & self.mask
        steps = steps + (1 as usize)
    }
    return Option.None
}

func insertFreshEntry<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: K, val: V, h: u64): void {
    let cap = self.buckets.len()
    let groupMask: u32 = if cap == (8 as usize) { 0xFF as u32 } else { 0xFFFF as u32 }
    let emptyVec = simd.U8x16.splat(CTRL_EMPTY)
    let mut pos = (h as usize) & self.mask
    let mut stride: usize = 0 as usize
    let mut steps: usize = 0 as usize
    while steps < cap {
        let group = loadCtrlGroup(ref self.ctrl, pos)
        let emptyMask = group.eq(emptyVec).bitmask() & groupMask
        if emptyMask != (0 as u32) {
            let bit = intrinsics.bitTrailingZeros32(emptyMask) as usize
            let idx = (pos + bit) & self.mask
            setCtrl(mut ref self.ctrl, cap, idx, h2(h))
            self.buckets.set(idx, Option.Some(Entry<K, V> {
                hash: h,
                key: key,
                value: val,
            }));
            self.len = self.len + (1 as usize)
            return
        }
        stride = stride + GROUP_WIDTH
        pos = (pos + stride) & self.mask
        steps = steps + (1 as usize)
    }
    capacityFailure()
}

func rebuildTable<K: hash.Hash, V>(self: mut ref HashMap<K, V>, targetCap: usize): void {
    let oldCap = self.buckets.len()
    let mut newBuckets = vec.Vec<Option<Entry<K, V>>>.withCapacity(targetCap)
    let mut newCtrl = vec.Vec<u8>.withCapacity(targetCap + GROUP_WIDTH)
    initStorage<K, V>(targetCap, mut ref newBuckets, mut ref newCtrl)

    let mut oldBuckets = self.buckets
    self.buckets = newBuckets
    self.ctrl = newCtrl
    self.mask = targetCap - (1 as usize)
    self.len = 0 as usize
    self.tombstones = 0 as usize

    let mut j: usize = 0 as usize
    while j < oldCap {
        match oldBuckets.takeSome(j) {
            Some(entry) => {
                insertFreshEntry(self, entry.key, entry.value, entry.hash)
            }
            _ => {}
        }
        j = j + (1 as usize)
    }
}

/// Doubles the bucket array and reinserts all existing entries.
func resize<K: hash.Hash, V>(self: mut ref HashMap<K, V>): void {
    let oldCap = self.buckets.len()
    let mut newCap: usize = 8 as usize
    if oldCap > (0 as usize) {
        if oldCap >= MAX_BUCKETS {
            capacityFailure()
        }
        newCap = oldCap * (2 as usize)
    }
    rebuildTable(self, newCap)
}

/// Rehashes at the current capacity when deleted tombstones crowd empty slots.
func rehashInPlace<K: hash.Hash, V>(self: mut ref HashMap<K, V>): void {
    let cap = self.buckets.len()
    if cap == (0 as usize) {
        resize(self)
        return
    }
    rebuildTable(self, cap)
}

/// Inserts a pair using the supplied precomputed hash and SwissTable SIMD probing.
func insertEntry<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: K, val: V, h: u64): Option<V> {
    let cap = self.buckets.len()
    if cap == (0 as usize) || self.len >= cap - cap / (4 as usize) {
        resize(self)
    } else if self.tombstones > (0 as usize) && self.len + self.tombstones >= cap - cap / (8 as usize) {
        rehashInPlace(self)
    }
    let currentCap = self.buckets.len()
    let groupMask: u32 = if currentCap == (8 as usize) { 0xFF as u32 } else { 0xFFFF as u32 }
    let tag = h2(h)
    let h2Vec = simd.U8x16.splat(tag)
    let emptyVec = simd.U8x16.splat(CTRL_EMPTY)
    let mut pos = (h as usize) & self.mask
    let mut stride: usize = 0 as usize
    let mut steps: usize = 0 as usize
    let mut hasFirstAvail = false
    let mut firstAvailIdx: usize = 0 as usize

    while steps < currentCap {
        let group = loadCtrlGroup(ref self.ctrl, pos)
        let mut matchMask = group.eq(h2Vec).bitmask() & groupMask
        while matchMask != (0 as u32) {
            let bit = intrinsics.bitTrailingZeros32(matchMask) as usize
            let idx = (pos + bit) & self.mask
            let mut same_key = false
            match self.buckets.get(idx) {
                Some(slot) => {
                    match slot.asRef() {
                        Some(entry) => {
                            same_key = entry.hash == h && entry.key.eq(ref key)
                        }
                        None => {}
                    }
                }
                None => {}
            }
            if same_key {
                let old = self.buckets.takeSome(idx)
                match old {
                    Some(previous) => {
                        let old_value = previous.value
                        self.buckets.set(idx, Option.Some(Entry<K, V> {
                            hash: h,
                            key: key,
                            value: val,
                        }));
                        return Option.Some(old_value)
                    }
                    _ => { capacityFailure() }
                }
            }
            matchMask = matchMask & (matchMask - (1 as u32))
        }
        if !hasFirstAvail {
            // Both EMPTY (0x80) and DELETED (0xFE) have high bit 7 set.
            let availMask = group.highBitmask() & groupMask
            if availMask != (0 as u32) {
                let bit = intrinsics.bitTrailingZeros32(availMask) as usize
                firstAvailIdx = (pos + bit) & self.mask
                hasFirstAvail = true
            }
        }
        if (group.eq(emptyVec).bitmask() & groupMask) != (0 as u32) {
            break
        }
        stride = stride + GROUP_WIDTH
        pos = (pos + stride) & self.mask
        steps = steps + (1 as usize)
    }

    if hasFirstAvail {
        let target = firstAvailIdx
        if self.ctrl.asSlice()[target] == CTRL_DELETED {
            self.tombstones = self.tombstones - (1 as usize)
        }
        setCtrl(mut ref self.ctrl, currentCap, target, tag)
        self.buckets.set(target, Option.Some(Entry<K, V> {
            hash: h,
            key: key,
            value: val,
        }));
        self.len = self.len + (1 as usize)
        return Option.None
    }
    capacityFailure()
    return Option.None
}

func insert<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: K, val: V): Option<V> {
    let h = hashKey(ref key)
    return insertEntry(self, key, val, h)
}

/// Associates `key` with `val` in the map, returning the previous value if present.
///
/// The key is hashed with `hashKey`; insertion may allocate when the map
/// crosses its load threshold. Equal keys must have equal hashes.
///
/// # Complexity
/// Time: O(1) amortized | Space: O(1) amortized
public func HashMap.put<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: K, val: V): Option<V> {
    return insert(self, key, val)
}

func contains<K: hash.Hash, V>(self: ref HashMap<K, V>, key: ref K): bool {
    match findIndex(self, key, hashKey<K>(key)) {
        Some(_) => { return true }
        None => { return false }
    }
}

/// Returns `true` if the map contains a value for the specified key.
/// An empty map returns `false`; lookup does not allocate or modify entries.
///
/// # Complexity
/// Time: O(1) average | Space: O(1)
public func HashMap.contains<K: hash.Hash, V>(self: ref HashMap<K, V>, key: ref K): bool {
    return contains(self, key)
}

func get<K: hash.Hash + marker.Copy, V: marker.Copy>(self: ref HashMap<K, V>, key: ref K): Option<V> {
    match findIndex(self, key, hashKey<K>(key)) {
        Some(idx) => {
            let bucketSlice = self.buckets.asSlice()
            match bucketSlice[idx].asRef() {
                Some(entry) => { return Option.Some(entry.value) }
                None => { return Option.None }
            }
        }
        None => { return Option.None }
    }
}

/// Returns a copy of the matching value when `V` is `Copy`.
///
/// # Complexity
/// Time: O(1) average | Space: O(1)
public func HashMap.get<K: hash.Hash + marker.Copy, V: marker.Copy>(self: ref HashMap<K, V>, key: ref K): Option<V> {
    return get(self, key)
}

/// Returns the value corresponding to the key, or `defaultVal` if not present.
public func HashMap.getOrDefault<K: hash.Hash + marker.Copy, V: marker.Copy>(self: ref HashMap<K, V>, key: ref K, defaultVal: V): V {
    match get(self, key) {
        Some(v) => {
            return v
        }
        None => {
            return defaultVal
        }
    }
}

func getRef<K: hash.Hash, V>(self: ref HashMap<K, V>, key: ref K): Option<ref V> {
    match findIndex(self, key, hashKey<K>(key)) {
        Some(idx) => {
            match self.buckets.get(idx) {
                Some(slot) => match slot.asRef() {
                    Some(entry) => { return Option.Some(ref entry.value) }
                    None => { return Option.None }
                }
                None => { return Option.None }
            }
        }
        None => { return Option.None }
    }
}

/// Returns a shared reference to the matching value without copying it.
///
/// The returned reference borrows the map and becomes invalid if the map is
/// cleared, resized, or dropped. Use this for values that own resources or
/// otherwise do not implement `Copy`.
public func HashMap.getRef<K: hash.Hash, V>(self: ref HashMap<K, V>, key: ref K): Option<ref V> {
    return getRef(self, key)
}

func getMut<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: ref K): Option<mut ref V> {
    match findIndex(self, key, hashKey<K>(key)) {
        Some(idx) => {
            match self.buckets.getMut(idx) {
                Some(slot) => match slot.asMut() {
                    Some(entry) => { return Option.Some(mut ref entry.value) }
                    None => { return Option.None }
                }
                None => { return Option.None }
            }
        }
        None => { return Option.None }
    }
}

/// Returns an exclusive mutable reference to the matching value without copying it.
public func HashMap.getMut<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: ref K): Option<mut ref V> {
    return getMut(self, key)
}

func eraseMetaAt<K: hash.Hash, V>(self: mut ref HashMap<K, V>, idx: usize): void {
    let cap = self.buckets.len()
    let emptyVec = simd.U8x16.splat(CTRL_EMPTY)
    let rightPos = (idx + (1 as usize)) & self.mask
    let rightGroup = loadCtrlGroup(ref self.ctrl, rightPos)
    if cap == (8 as usize) {
        if (rightGroup.eq(emptyVec).bitmask() & (0x7F as u32)) != (0 as u32) {
            setCtrl(mut ref self.ctrl, cap, idx, CTRL_EMPTY)
        } else {
            setCtrl(mut ref self.ctrl, cap, idx, CTRL_DELETED)
            self.tombstones = self.tombstones + (1 as usize)
        }
        return
    }
    let leftPos = (idx + cap - (15 as usize)) & self.mask
    let leftGroup = loadCtrlGroup(ref self.ctrl, leftPos)
    let leftMask = leftGroup.eq(emptyVec).bitmask() & (0x7FFF as u32)
    if leftMask == (0 as u32) {
        setCtrl(mut ref self.ctrl, cap, idx, CTRL_DELETED)
        self.tombstones = self.tombstones + (1 as usize)
        return
    }
    let leftEmpty = intrinsics.bitLeadingZeros32(leftMask) - (17 as u32)
    let rightMask = rightGroup.eq(emptyVec).bitmask() & (0x7FFF as u32)
    let rightEmpty = if rightMask == (0 as u32) {
        15 as u32
    } else {
        intrinsics.bitTrailingZeros32(rightMask)
    }
    if leftEmpty + rightEmpty < (15 as u32) {
        setCtrl(mut ref self.ctrl, cap, idx, CTRL_EMPTY)
    } else {
        setCtrl(mut ref self.ctrl, cap, idx, CTRL_DELETED)
        self.tombstones = self.tombstones + (1 as usize)
    }
}

func remove<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: ref K): Option<V> {
    let h = hashKey<K>(key)
    match findIndex(self, key, h) {
        Some(idx) => {
            let removed = self.buckets.takeSome(idx)
            let mut removed_value: Option<V> = Option.None
            match removed {
                Some(entry) => { removed_value = Option.Some(entry.value) }
                None => { capacityFailure() }
            }
            eraseMetaAt(self, idx)
            self.len = self.len - (1 as usize)
            return removed_value
        }
        None => { return Option.None }
    }
}

/// Removes a matching key and returns its value, or `None` if absent.
///
/// The bucket and control arrays are retained and slots turn empty whenever
/// surrounding probe windows remain broken by another empty byte.
///
/// # Complexity
/// Time: O(1) average | Space: O(1)
public func HashMap.remove<K: hash.Hash, V>(self: mut ref HashMap<K, V>, key: ref K): Option<V> {
    return remove(self, key)
}
