//! Target-aware memory and value utilities.
//!
//! ## Overview
//!
//! Use the compiler-provided size, alignment, and pointer operations for low-level work, or the value helpers `swap`, `replace`, and `take`. Raw pointer operations require their documented safety preconditions.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.mem as mem
//!
//! let mut first = 1
//! let mut second = 2
//! mem.swap(&mut first, &mut second)
//! ```
//!
//! ## Safety
//! `ptrOffset`, `ptrRead`, and `ptrWrite` require valid allocation bounds,
//! alignment, and initialized storage. `sizeOf` and `alignOf` use the selected
//! target layout, which may differ from the compiler host.
//!
//! ## Allocations
//! The value helpers and intrinsics do not allocate.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`

module std.core.mem

extern "arandu-intrinsic" {
    /// Returns the size in bytes of type `T` according to the target's `DataLayout`.
    ///
    /// # Examples
    /// ```arandu
    /// mem.sizeOf<int>() // 8 on x64, 4 on x32
    /// ```
    func sizeOf<T>() : uint

    /// Returns the required ABI alignment in bytes for type `T`.
    ///
    /// # Examples
    /// ```arandu
    /// mem.alignOf<int>() // 8 on x64, 4 on x32
    /// ```
    func alignOf<T>() : uint

    /// Computes a pointer offset by `offset` elements of type `T` from `base`.
    ///
    /// # Safety
    /// The resulting pointer must remain within the bounds of the allocated object
    /// to prevent undefined behavior.
    func ptrOffset<T>(base: ptr[T], offset: i32) : ptr[T]

    /// Directly reads and returns the value of type `T` pointed to by `p`.
    ///
    /// # Safety
    /// `p` must be a valid, non-null, properly aligned pointer pointing to initialized memory.
    func ptrRead<T>(p: ptr[T]) : T

    /// Directly writes `val` into the memory address pointed to by `p`.
    ///
    /// # Safety
    /// `p` must be a valid, properly aligned pointer with write permissions.
    func ptrWrite<T>(p: ptr[T], val: T) : void

    /// Directly writes `val` into the exclusive reference `dest`.
    func refWrite<T>(dest: mut ref T, val: T) : void
}

/// Swaps the values referenced by `x` and `y` in-place without extra allocation.
///
/// # Examples
/// ```arandu
/// let mut a: int = 100
/// let mut b: int = 200
/// mem.swap(&mut a, &mut b)
/// assert(a == 200)
/// assert(b == 100)
/// ```
public func swap<T>(x: mut ref T, y: mut ref T): void {
    let tmp = *x
    refWrite<T>(x, *y)
    refWrite<T>(y, tmp)
}

/// Replaces the value at `dest` with `src`, returning the old value.
///
/// # Examples
/// ```arandu
/// let mut buffer: int = 50
/// let old = mem.replace(&mut buffer, 100)
/// assert(old == 50)
/// assert(buffer == 100)
/// ```
public func replace<T>(dest: mut ref T, src: T): T {
    let old = *dest
    refWrite<T>(dest, src)
    return old
}

/// Replaces the value at `dest` with `Option.None`, returning the previous value.
///
/// # Examples
/// ```arandu
/// let mut opt = Option.Some(42)
/// let prev = mem.take(&mut opt)
/// assert(prev.isSome())
/// assert(opt.isNone())
/// ```
public func take<T>(dest: mut ref Option<T>): Option<T> {
    return replace<Option<T>>(dest, Option.None)
}

