//! Generational slots with handles that detect reuse.
//!
//! ## Overview
//!
//! `GenArena<T>` stores values in reusable slots. A `GenRef` includes the slot generation so removed and recycled entries can be distinguished.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.gen_arena as arena
//!
//! let mut values = arena.new<int>()
//! let handle = arena.insert(&mut values, 7)
//! let removed = arena.remove(&mut values, handle)
//! ```
//!
//! ## Safety
//! `GenRef` records a slot and generation. After removal, using an old
//! handle with `get` traps on a generation mismatch; use `remove` when a
//! fallible lookup is needed.
//!
//! ## Allocations
//! The empty arena allocates on first insertion and grows its slot buffers.
//!
//! ## Platform
//! `native` · `wasm32`

// arandu_alloc::gen_arena — generational slots.
//
// Minimal 0.1 — generational arena.

module std.alloc.gen_arena

import std.core.mem as mem
import std.core.intrinsics as intrinsics

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: uint): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: uint): void
    /// Host allocator that resizes a raw byte buffer.
    func ar_vec_realloc(p: ptr[u8], oldSize: uint, newSize: uint): ptr[u8]
}

/// Handle identifying a slot and the generation when it was inserted.
///
/// Removing and reusing a slot changes its generation, so the previous handle
/// cannot remove the newly inserted value.
public struct GenRef {
    /// Position of this element or slot.
    index: u32
    /// Generation recorded when the handle was created.
    generation: u32
}

/// Recyclable generational arena (slab free list + gen bump on recycle).
public struct GenArena<T> {
    /// Owned storage for slot values.
    data: ptr[T]
    /// Generation number for each slot.
    gen: ptr[u32]
    /// Occupancy flag for each slot.
    used: ptr[u8]
    /// Indexes of reusable slots.
    free: ptr[u32]
    /// Number of indexes in the free list.
    free_len: uint
    /// Allocated capacity of the free list.
    free_cap: uint
    /// Number of slots allocated for values.
    slots: uint
    /// Allocated slot capacity.
    slots_cap: uint
}

/// Creates an empty arena without allocating its slot tables.
///
/// Call `destroy` when the arena is no longer needed to release tables grown
/// by `insert` or `remove`.
public func new<T>(): GenArena<T> {
    return GenArena<T> {
        data: nil,
        gen: nil,
        used: nil,
        free: nil,
        free_len: 0,
        free_cap: 0,
        slots: 0,
        slots_cap: 0,
    }
}

func growSlots<T>(a: mut ref GenArena<T>, minCap: uint): void {
    if a.slots_cap >= minCap {
        return
    }
    let mut newCap: uint = a.slots_cap
    if newCap == 0 {
        newCap = 8
    }
    while newCap < minCap {
        newCap = newCap * 2
    }
    let elem = mem.sizeOf<T>()
    let genElem = mem.sizeOf<u32>()
    let usedElem = mem.sizeOf<u8>()
    let oldSlots = a.slots_cap
    unsafe {
        let nullp: ptr[u8] = nil
        let pData = ar_vec_realloc(a.data as ptr[u8], oldSlots * elem, newCap * elem)
        if pData == nullp {
            intrinsics.abort()
        }
        let pGen = ar_vec_realloc(a.gen as ptr[u8], oldSlots * genElem, newCap * genElem)
        if pGen == nullp {
            intrinsics.abort()
        }
        let pUsed = ar_vec_realloc(a.used as ptr[u8], oldSlots * usedElem, newCap * usedElem)
        if pUsed == nullp {
            intrinsics.abort()
        }
        a.data = pData as ptr[T]
        a.gen = pGen as ptr[u32]
        a.used = pUsed as ptr[u8]
        a.slots_cap = newCap
    }
}

func growFree<T>(a: mut ref GenArena<T>, minCap: uint): void {
    if a.free_cap >= minCap {
        return
    }
    let mut newCap: uint = a.free_cap
    if newCap == 0 {
        newCap = 8
    }
    while newCap < minCap {
        newCap = newCap * 2
    }
    let genElem = mem.sizeOf<u32>()
    let oldBytes = a.free_cap * genElem
    let newBytes = newCap * genElem
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_realloc(a.free as ptr[u8], oldBytes, newBytes)
        if p == nullp {
            intrinsics.abort()
        }
        a.free = p as ptr[u32]
        a.free_cap = newCap
    }
}

/// Stores `value` and returns a handle for the occupied slot.
///
/// A removed slot is reused before a new slot is added. Reuse increments the
/// slot generation, invalidating handles from its previous occupant.
///
/// ## Allocations
/// Growing the slot tables can allocate; reusing an available slot does not.
/// Allocation failure aborts rather than returning an error.
public func insert<T>(a: mut ref GenArena<T>, value: T): GenRef {
    if a.free_len > 0 {
        let lastIdx = a.free_len - 1
        unsafe {
            let freePtr = mem.ptrOffset<u32>(a.free, lastIdx as i32)
            let slot = mem.ptrRead<u32>(freePtr)
            a.free_len = lastIdx
            let usedPtr = mem.ptrOffset<u8>(a.used, slot as i32)
            mem.ptrWrite<u8>(usedPtr, 1 as u8)
            let genPtr = mem.ptrOffset<u32>(a.gen, slot as i32)
            let g = mem.ptrRead<u32>(genPtr)
            let nextG = g + 1 as u32
            mem.ptrWrite<u32>(genPtr, nextG)
            let dataPtr = mem.ptrOffset<T>(a.data, slot as i32)
            mem.ptrWrite<T>(dataPtr, value)
            return GenRef {
                index: slot,
                generation: nextG,
            }
        }
    }
    let need = a.slots + 1
    if a.slots_cap < need {
        growSlots<T>(a, need)
    }
    let idx = a.slots as u32
    unsafe {
        let dataPtr = mem.ptrOffset<T>(a.data, idx as i32)
        mem.ptrWrite<T>(dataPtr, value)
        let genPtr = mem.ptrOffset<u32>(a.gen, idx as i32)
        mem.ptrWrite<u32>(genPtr, 0 as u32)
        let usedPtr = mem.ptrOffset<u8>(a.used, idx as i32)
        mem.ptrWrite<u8>(usedPtr, 1 as u8)
    }
    a.slots = a.slots + 1
    return GenRef {
        index: idx,
        generation: 0 as u32,
    }
}

/// Returns the value at a live handle.
///
/// An out-of-range index, removed slot, or stale generation aborts execution.
/// Use `remove` when invalid handles must be handled without aborting. This
/// reads the value without removing its slot and does not allocate.
public func get<T>(a: ref GenArena<T>, r: GenRef): T {
    let idx = r.index as uint
    if idx >= a.slots {
        unsafe {
            intrinsics.abort()
        }
    }
    unsafe {
        let usedPtr = mem.ptrOffset<u8>(a.used, r.index as i32)
        let u = mem.ptrRead<u8>(usedPtr)
        if u == 0 as u8 {
            intrinsics.abort()
        }
        let genPtr = mem.ptrOffset<u32>(a.gen, r.index as i32)
        let g = mem.ptrRead<u32>(genPtr)
        if g != r.generation {
            intrinsics.abort()
        }
        let dataPtr = mem.ptrOffset<T>(a.data, r.index as i32)
        return mem.ptrRead<T>(dataPtr)
    }
}

/// Removes a live entry and returns its value as `Some`.
///
/// Returns `None` for an out-of-range, already removed, or stale handle. A
/// successful removal makes that handle invalid and makes the slot available
/// for a later `insert`. Growing the free-slot table can allocate and abort
/// on allocation failure.
public func remove<T>(a: mut ref GenArena<T>, r: GenRef): Option<T> {
    let idx = r.index as uint
    if idx >= a.slots {
        return Option.None
    }
    unsafe {
        let usedPtr = mem.ptrOffset<u8>(a.used, r.index as i32)
        let u = mem.ptrRead<u8>(usedPtr)
        if u == 0 as u8 {
            return Option.None
        }
        let genPtr = mem.ptrOffset<u32>(a.gen, r.index as i32)
        let g = mem.ptrRead<u32>(genPtr)
        if g != r.generation {
            return Option.None
        }
        let dataPtr = mem.ptrOffset<T>(a.data, r.index as i32)
        let val = mem.ptrRead<T>(dataPtr)
        mem.ptrWrite<u8>(usedPtr, 0 as u8)
        let needFree = a.free_len + 1
        if a.free_cap < needFree {
            growFree<T>(a, needFree)
        }
        let freePtr = mem.ptrOffset<u32>(a.free, a.free_len as i32)
        mem.ptrWrite<u32>(freePtr, r.index)
        a.free_len = a.free_len + 1
        return Option.Some(val)
    }
}

/// Returns the number of currently occupied slots in O(1) time.
///
/// Removed slots are excluded even though their storage remains available.
public func len<T>(a: ref GenArena<T>): uint {
    return a.slots - a.free_len
}

/// `true` when no live slots.
public func isEmpty<T>(a: ref GenArena<T>): bool {
    return len<T>(a) == 0
}

/// Releases all slot and free-list buffers and resets the arena to empty.
///
/// Existing handles cannot be used with the reset arena. The stored values
/// are not individually visited by this operation.
public func destroy<T>(a: mut ref GenArena<T>): void {
    if a.slots_cap > 0 {
        let elem = mem.sizeOf<T>()
        let genElem = mem.sizeOf<u32>()
        let usedElem = mem.sizeOf<u8>()
        unsafe {
            ar_vec_buf_free(a.data as ptr[u8], a.slots_cap * elem)
            ar_vec_buf_free(a.gen as ptr[u8], a.slots_cap * genElem)
            ar_vec_buf_free(a.used as ptr[u8], a.slots_cap * usedElem)
        }
        a.data = nil
        a.gen = nil
        a.used = nil
        a.slots_cap = 0
        a.slots = 0
    }
    if a.free_cap > 0 {
        let genElem = mem.sizeOf<u32>()
        unsafe {
            ar_vec_buf_free(a.free as ptr[u8], a.free_cap * genElem)
        }
        a.free = nil
        a.free_cap = 0
        a.free_len = 0
    }
}
