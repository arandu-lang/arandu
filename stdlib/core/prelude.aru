//! Convenience re-exports of the most used stdlib utilities.
//!
//! ## Overview
//!
//! The prelude gathers the most used stdlib types and functions in a single
//! import: `Option<T>` and `Result<T, E>`, raw `ptr<T>`, coroutine `Poll<T>`,
//! `size_of`/`align_of` layout queries, `Ordering`, slices (`[]T`), strings
//! (`str`), checked arithmetic via `std.core.num`, char and ASCII utilities,
//! generic `Hash`/`Hasher` and `Iterator<T>`.
//!
//! Import it explicitly — nothing here is injected implicitly. The only names
//! the compiler provides without `import` are the `io` and `err` builtins
//! (`io.println`, `io.eprint`, `err.new`).
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Available on every supported platform: it only re-exports.
//!
//! ## See also
//!
//! - `std.core.option` — `Option<T>` documentation
//! - `std.core.result` — `Result<T, E>` documentation
//! - `std.core.iter` — `Iterator<T>` documentation

module std.core.prelude

import std.core.option as option
import std.core.result as result
import std.core.pointer as pointer
import std.core.future as future
import std.core.mem as mem
import std.core.cmp as cmp
import std.core.slice as slice
import std.core.num as num
import std.core.char as chars
import std.core.ascii as ascii
import std.core.str as strings
import std.core.hash as hash
import std.core.iter as iter
import std.core.cell as cell
import std.core.marker as marker
import std.core.atomic as atomic
