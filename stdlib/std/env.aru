//! Read-only access to process arguments and environment.
//!
//! ## Overview
//!
//! `argsLen` and `arg` inspect the process argument vector. `varIsSet` checks whether an environment variable is present.
//!
//! ## Example
//!
//! ```arandu
//! import std.env as env
//!
//! let argc = env.argsLen()
//! let first = env.arg(0)
//! let hasHome = env.varIsSet("HOME")
//! ```
//!
//! ## Safety
//! `arg` returns an empty string for an index outside the argument vector,
//! so an empty result does not by itself prove that the argument is absent.
//! `argsLen` includes the executable name at index zero.
//!
//! ## Platform
//! `native`

module std.env

/// Minimal 0.1 — read-only environment query (thin, deterministic).
///
/// | Function      | Status |
/// |---------------|--------|
/// | `args_len`    | host-backed (`argv` count, includes argv[0]) |
/// | `arg`         | host-backed (`argv[index]`, empty `""` when out of range) |
/// | `var_is_set`  | host-backed (presence, including empty value) |
///
/// **Out of Minimal:** `setenv` / `unsetenv` / listing all vars. Presence-only
/// and argv-snapshot are intentional: no global mutation races (same caution
/// as concurrent `setenv` in C/POSIX), and non-UTF-8 argv never panics (the
/// host converts lossy, unlike Rust `env::args()`).
///
/// Not in the default `arandu new` template.

extern "C" {
    func ar_env_args_len(): int
    /// Returns `argv[index]` as a UTF-8 string (lossy; empty when out of range).
    func ar_env_arg(index: int): str
    /// Returns 0/1 as int (bool ABI via wrapper).
    func ar_env_var_is_set(name: str): int
}

/// Number of command-line arguments including the program name.
public func argsLen(): int {
    unsafe {
        return ar_env_args_len()
    }
}

/// The `index`-th command-line argument (`argv[0]` is the program name, like
/// Go `os.Args[index]`), or an empty string when `index` is out of range.
/// Reads a process-start snapshot, so the value is stable during execution.
public func arg(index: int): str {
    unsafe {
        return ar_env_arg(index)
    }
}

/// True if environment variable `name` is present (value may be empty).
public func varIsSet(name: str): bool {
    unsafe {
        return ar_env_var_is_set(name) != 0
    }
}
