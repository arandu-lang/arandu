//! Operations over immutable borrowed UTF-8 strings (`str`).
//!
//! ## Overview
//!
//! `str` is Arandu's primitive string type: a slice of valid immutable UTF-8
//! bytes. `std.core.str` provides the fundamental allocation-free operations
//! over it — byte length, comparison, search, byte slicing and
//! prefix/suffix checks.
//!
//! For mutable growable strings that require the heap, use
//! `std.alloc.string.String`. For allocation-free formatting into a fixed
//! buffer, use `std.core.fmt.Formatter`.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.str
//!
//! let s = "hello, world"
//! s.isEmpty()              // false
//! s.len()                  // 12
//! s.charCount()            // 12
//! s.startsWith("hello")    // true
//! s.contains("world")      // true
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! No allocation involved on any supported platform.
//!
//! ## See also
//!
//! - `std.alloc.string` — heap-allocated mutable `String`
//! - `std.core.fmt` — allocation-free fixed-buffer formatting
//! - `std.core.char` — Unicode codepoint operations

module std.core.str

import std.core.intrinsics as intrinsics
import std.core.simd as simd
import std.core.slice as slice

/// Returns a shared view of the UTF-8 bytes without allocating or copying.
/// The view borrows the input storage and cannot outlive it. Lengths and
/// indices in this view count bytes, not Unicode characters.
public func asBytes(s: ref str): []u8 {
    return intrinsics.strBytes(s)
}

/// Returns `true` if the string is empty (`len == 0`).
///
/// # Examples
/// ```arandu
/// str.isEmpty("")     // true
/// str.isEmpty("hello") // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isEmpty(s: str): bool {
    return s == ""
}

/// Returns the byte length of the string when encoded as UTF-8.
///
/// Note: this counts UTF-8 **bytes**, not Unicode scalar values. Use
/// `charCount` to count Unicode scalar values.
/// # Examples
/// ```arandu
/// str.len("abc") // 3
/// str.len("olá") // 4 ('á' occupies 2 bytes in UTF-8)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func len(s: str): usize {
    let bytes = intrinsics.strBytes(s)
    return slice.len<u8>(bytes)
}

/// Returns the number of Unicode scalar values (`char`s) in `s`.
///
/// Scans the UTF-8 byte sequence and counts leading bytes (any byte whose top
/// two bits are not `10`).
/// # Examples
/// ```arandu
/// str.charCount("abc") // 3
/// str.charCount("olá") // 3
/// ```
///
/// # Complexity
/// Time: O(N) | Space: O(1)
public func charCount(s: str): usize {
    let bytes = intrinsics.strBytes(s)
    let total = slice.len<u8>(bytes)
    let mut i: usize = 0
    let mut count: usize = 0
    while i < total {
        if (bytes[i] & (0xC0 as u8)) != (0x80 as u8) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

/// Returns `true` if the string `s` starts with `prefix`.
/// An empty prefix matches every string. Comparison is bytewise and does not
/// allocate.
///
/// # Examples
/// ```arandu
/// str.startsWith("compiler", "comp") // true
/// str.startsWith("arandu", "lang")   // false
/// ```
///
/// # Complexity
/// Time: O(M) where M is prefix length | Space: O(1)
public func startsWith(s: str, prefix: str): bool {
    let source = intrinsics.strBytes(s)
    let expected = intrinsics.strBytes(prefix)
    let source_len = slice.len<u8>(source)
    let expected_len = slice.len<u8>(expected)
    if expected_len > source_len {
        return false
    }
    let mut i: usize = 0
    while i < expected_len {
        if source[i] != expected[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// Returns `true` if the string `s` ends with `suffix`.
/// An empty suffix matches every string. Comparison is bytewise and does not
/// allocate.
///
/// # Examples
/// ```arandu
/// str.endsWith("file.aru", ".aru") // true
/// str.endsWith("main.c", ".aru")   // false
/// ```
///
/// # Complexity
/// Time: O(M) where M is suffix length | Space: O(1)
public func endsWith(s: str, suffix: str): bool {
    let source = intrinsics.strBytes(s)
    let expected = intrinsics.strBytes(suffix)
    let source_len = slice.len<u8>(source)
    let expected_len = slice.len<u8>(expected)
    if expected_len > source_len {
        return false
    }
    let offset = source_len - expected_len
    let mut i: usize = 0
    while i < expected_len {
        if source[offset + i] != expected[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// Returns `true` if the string `s` contains the substring `needle`.
/// An empty needle is always contained, including in an empty source.
/// This delegates to `find` and does not allocate.
///
/// # Examples
/// ```arandu
/// str.contains("arandu compiler", "arandu") // true
/// str.contains("hello world", "rust")       // false
/// ```
///
/// # Complexity
/// Time: O(N * M) | Space: O(1)
public func contains(s: str, needle: str): bool {
    match find(s, needle) {
        Option.Some(_) => {
            return true
        }
        Option.None => {
            return false
        }
    }
}

/// Returns the first byte index of `needle` in `s`, or `Option.None` if not found.
/// An empty needle matches at index zero. The returned offset counts UTF-8
/// bytes, not characters; use it as a byte position when slicing.
///
/// # Examples
/// ```arandu
/// str.find("arandu", "ran") // Some(1)
/// str.find("arandu", "xyz") // None
/// ```
///
/// # Complexity
/// Time: O(N * M) | Space: O(1)
public func find(s: str, needle: str): Option<usize> {
    let source = intrinsics.strBytes(s)
    let expected = intrinsics.strBytes(needle)
    let source_len = slice.len<u8>(source)
    let expected_len = slice.len<u8>(expected)
    if expected_len == 0 {
        return Option.Some(0)
    }
    if expected_len > source_len {
        return Option.None
    }
    let last = source_len - expected_len
    let mut start: usize = 0
    while start <= last {
        let mut i: usize = 0
        while i < expected_len && source[start + i] == expected[i] {
            i = i + 1
        }
        if i == expected_len {
            return Option.Some(start)
        }
        start = start + 1
    }
    return Option.None
}

// ── Inherent methods on `str` ───────────────────────────────────────────────

/// Returns a shared view of the UTF-8 bytes without allocating or copying.
public func str.asBytes(self: ref str): []u8 {
    return asBytes(self)
}

/// Returns `true` if the string is empty (`len == 0`).
public func str.isEmpty(self: str): bool {
    return isEmpty(self)
}

/// Returns the byte length of the string when encoded as UTF-8.
public func str.len(self: str): usize {
    return len(self)
}

/// Returns the number of Unicode scalar values (`char`s) in `self`.
public func str.charCount(self: str): usize {
    return charCount(self)
}

/// Returns `true` if the string starts with `prefix`.
public func str.startsWith(self: str, prefix: str): bool {
    return startsWith(self, prefix)
}

/// Returns `true` if the string ends with `suffix`.
public func str.endsWith(self: str, suffix: str): bool {
    return endsWith(self, suffix)
}

/// Returns `true` if the string contains the substring `needle`.
public func str.contains(self: str, needle: str): bool {
    return contains(self, needle)
}

/// Returns the first byte index of `needle` in `self`, or `Option.None` if not found.
public func str.find(self: str, needle: str): Option<usize> {
    return find(self, needle)
}

/// Returns `true` if `s` contains only ASCII bytes (values in `0..=127`).
public func isAscii(s: str): bool {
    let bytes = intrinsics.strBytes(s)
    let len = slice.len<u8>(bytes)
    let mut i: usize = 0
    while len - i >= (16 as usize) {
        let chunk = unsafe {
            simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(bytes, i, 16 as usize))
        }
        if chunk.highBitmask() != (0 as u32) {
            return false
        }
        i = i + (16 as usize)
    }
    while i < len {
        if bytes[i] > (127 as u8) {
            return false
        }
        i = i + (1 as usize)
    }
    return true
}

/// Returns `true` if `bytes` is valid UTF-8 according to RFC 3629.
public func isValidUtf8(bytes: []u8): bool {
    let total = slice.len<u8>(bytes)
    let mut i: usize = 0
    while i < total {
        while total - i >= (16 as usize) {
            let chunk = unsafe {
                simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(bytes, i, 16 as usize))
            }
            if chunk.highBitmask() != (0 as u32) {
                break
            }
            i = i + (16 as usize)
        }
        if i >= total {
            return true
        }
        let rem = total - i
        let b0 = bytes[i]
        if b0 <= (0x7F as u8) {
            i = i + (1 as usize)
        } else if b0 >= (0xC2 as u8) && b0 <= (0xDF as u8) {
            if rem <= (1 as usize) { return false }
            let b1 = bytes[i + (1 as usize)]
            if (b1 & (0xC0 as u8)) != (0x80 as u8) { return false }
            i = i + (2 as usize)
        } else if b0 >= (0xE0 as u8) && b0 <= (0xEF as u8) {
            if rem <= (2 as usize) { return false }
            let b1 = bytes[i + (1 as usize)]
            let b2 = bytes[i + (2 as usize)]
            if (b2 & (0xC0 as u8)) != (0x80 as u8) { return false }
            if b0 == (0xE0 as u8) {
                if !(b1 >= (0xA0 as u8) && b1 <= (0xBF as u8)) { return false }
            } else if b0 == (0xED as u8) {
                if !(b1 >= (0x80 as u8) && b1 <= (0x9F as u8)) { return false }
            } else {
                if (b1 & (0xC0 as u8)) != (0x80 as u8) { return false }
            }
            i = i + (3 as usize)
        } else if b0 >= (0xF0 as u8) && b0 <= (0xF4 as u8) {
            if rem <= (3 as usize) { return false }
            let b1 = bytes[i + (1 as usize)]
            let b2 = bytes[i + (2 as usize)]
            let b3 = bytes[i + (3 as usize)]
            if (b2 & (0xC0 as u8)) != (0x80 as u8) || (b3 & (0xC0 as u8)) != (0x80 as u8) {
                return false
            }
            if b0 == (0xF0 as u8) {
                if !(b1 >= (0x90 as u8) && b1 <= (0xBF as u8)) { return false }
            } else if b0 == (0xF4 as u8) {
                if !(b1 >= (0x80 as u8) && b1 <= (0x8F as u8)) { return false }
            } else {
                if (b1 & (0xC0 as u8)) != (0x80 as u8) { return false }
            }
            i = i + (4 as usize)
        } else {
            return false
        }
    }
    return true
}

/// Returns `true` if two strings are identical in length and bytes.
public func eq(a: str, b: str): bool {
    let bytes_a = intrinsics.strBytes(a)
    let bytes_b = intrinsics.strBytes(b)
    let len_a = slice.len<u8>(bytes_a)
    let len_b = slice.len<u8>(bytes_b)
    if len_a != len_b {
        return false
    }
    let mut i: usize = 0
    while len_a - i >= (16 as usize) {
        let va = unsafe {
            simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(bytes_a, i, 16 as usize))
        }
        let vb = unsafe {
            simd.simdU8x16LoadUnaligned(intrinsics.sliceSubslice<u8>(bytes_b, i, 16 as usize))
        }
        if !va.eq(vb).allTrue() {
            return false
        }
        i = i + (16 as usize)
    }
    while i < len_a {
        if bytes_a[i] != bytes_b[i] {
            return false
        }
        i = i + (1 as usize)
    }
    return true
}

/// Returns `true` if `self` contains only ASCII bytes (`s.isAscii()`).
public func str.isAscii(self: str): bool {
    return isAscii(self)
}

/// Returns `true` if `self` is byte-for-byte identical to `other` (`s.eq(other)`).
public func str.eq(self: str, other: str): bool {
    return eq(self, other)
}
