module closureMoveCapture

import std.alloc.string as strings

// `move` closures own their captures: the environment holds them and drops
// them after the call. A borrowed callback may run many times, so its body
// uses the moved values in place and never consumes them.

func callTwice(f: () -> int): int {
    return f() + f()
}

func withSuffix(n: int, f: (int) -> int): int {
    return f(n)
}

// The closure mutates its own copy; the caller's value moved away.
func mutatesItsOwnCapture(): int {
    let mut text = strings.String.from("owned")
    let total = callTwice(move || {
        let _, _ = text.pushStr("!")
        return text.asStr().len() as int
    })
    if total != 13 { return 1 }
    return 0
}

// The closure takes a parameter and drops its owned capture after use.
func movedCaptureWithParameter(): int {
    let label = strings.String.from("abc")
    let r = withSuffix(39, move |n| n + label.asStr().len() as int)
    if r != 42 { return 1 }
    return 0
}

func main(): int {
    let mutated = mutatesItsOwnCapture()
    if mutated != 0 { return 10 + mutated }
    let moved = movedCaptureWithParameter()
    if moved != 0 { return 20 + moved }
    return 0
}
