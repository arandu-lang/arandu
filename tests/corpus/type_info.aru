// `types.info<T>()`: descriptions computed at compile time, read at run
// time from static storage when kept in a `const`.
module app.shapes

import std.core.types as types
from std.core.types import { TypeKind }

struct Point {
    x: int,
    y: int,
}

struct Account {
    owner: str,
    private balance: i64,
}

enum Shape {
    Empty,
    Circle(float),
    Square(int),
}

const POINT: types.TypeInfo = types.info<Point>()
const SHAPE: types.TypeInfo = types.info<Shape>()

func describe<T>(): usize {
    let info = comptime types.info<T>()
    return info.fields.len() + info.variants.len()
}

func main(): int {
    if POINT.name != "app.shapes.Point" { return 1 }
    if POINT.size != 8 || POINT.align != 4 { return 2 }
    if POINT.fields.len() != 2 || POINT.fields[1].name != "y" { return 3 }
    if POINT.fields[1].offset != 4 || POINT.fields[1].typeName != "int" { return 4 }
    match POINT.kind {
        TypeKind.Struct => {}
        _ => { return 5 }
    }
    if SHAPE.variants.len() != 3 || SHAPE.variants[1].name != "Circle" { return 6 }
    if !SHAPE.variants[2].hasPayload || SHAPE.variants[0].hasPayload { return 7 }
    // Declared here, so the private field is visible and the list complete.
    let account = types.info<Account>()
    if !account.isComplete || account.fields.len() != 2 { return 8 }
    if types.info<int>().size != 4 { return 9 }
    if types.info<(int, str)>().name != "(int, str)" { return 10 }
    if types.info<Option<int>>().variants[1].name != "Some" { return 11 }
    if describe<Point>() != 2 || describe<Shape>() != 3 { return 12 }
    if types.info<[]Point>().name != "[]app.shapes.Point" { return 13 }
    return 0
}
