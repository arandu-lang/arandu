/// Selects each lane from `yes` where the mask is true, otherwise from `no`.
public func I64x2.select(mask: Mask64x2, yes: I64x2, no: I64x2): I64x2 {
    unsafe { return simdI64x2Select(mask.rawBits(), yes, no) }
}
/// Extracts a lane. Traps for negative or out-of-range indices.
public func I64x2.extractLane(self: I64x2, index: int): i64 {
    unsafe {
        if index == 0 { return simdI64x2Extract0(self) }
        if index == 1 { return simdI64x2Extract1(self) }
        intrinsics.abort()
    }
    return 0 as i64
}
/// Replaces a lane. Traps for negative or out-of-range indices.
public func I64x2.replaceLane(self: I64x2, index: int, value: i64): I64x2 {
    unsafe {
        if index == 0 { return simdI64x2Insert0(self, value) }
        if index == 1 { return simdI64x2Insert1(self, value) }
        intrinsics.abort()
    }
    return self
}
/// Reads the first 2 lanes; a short slice returns None without reading data.
/// Only `i64` alignment is required. Scalar accesses avoid aligned vector UB.
public func I64x2.loadUnaligned(source: []i64): Option<I64x2> {
    if intrinsics.sliceLen<i64>(source) < (2 as usize) { return Option.None }
    return Option.Some(I64x2.new(source[0], source[1]))
}
/// Writes the first 2 lanes through an exclusive borrowed view.
/// A short destination returns false without writes; scalar alignment suffices.
public func I64x2.storeUnaligned<Owner>(self: I64x2, destination: mut ref slice.MutableSlice<Owner, i64>): bool {
    if destination.len() < (2 as usize) { return false }
    destination.set(0 as usize, self.extractLane(0))
    destination.set(1 as usize, self.extractLane(1))
    return true
}

/// Low-level slice descriptor store. Safety: the complete destination data
/// range must be exclusively accessible for this call; mut ref to a shared
/// Writes the first 2 lanes through an exclusive mutable slice view.
/// A short destination returns false without writes.
public func I64x2.storeUnalignedSlice(self: I64x2, destination: mut []i64): bool {
    if intrinsics.mutSliceLen<i64>(destination) < (2 as usize) { return false }
    destination[0] = self.extractLane(0)
    destination[1] = self.extractLane(1)
    return true
}

/// Negates each lane (including signed zero).
public func F32x4.neg(self: F32x4): F32x4 {
    return F32x4.new(-self.extractLane(0), -self.extractLane(1), -self.extractLane(2), -self.extractLane(3))
}
/// Selects self when strictly less; ties and unordered pairs select other.
public func F32x4.min(self: F32x4, other: F32x4): F32x4 {
    return F32x4.select(self.lt(other), self, other)
}
/// Selects self when strictly greater; ties and unordered pairs select other.
public func F32x4.max(self: F32x4, other: F32x4): F32x4 {
    return F32x4.select(self.gt(other), self, other)
}
/// Multiplies lanes, then sums in ascending order without reassociation.
public func F32x4.dot(self: F32x4, other: F32x4): f32 {
    let product = self.mul(other)
    return product.extractLane(0) + product.extractLane(1) + product.extractLane(2) + product.extractLane(3)
}

/// Canonical mask of 16 lanes. True occupies every bit of its lane.
public struct Mask8x16 { private bits: U8x16 }

// Unsafe module-internal bridge; safe constructors preserve lane canonicity.
@Unsafe
