struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

func vec3(x: f32, y: f32, z: f32): Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

func Vec3.add(self: Vec3, other: Vec3): Vec3 {
    return Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z };
}

func Vec3.scale(self: Vec3, t: f32): Vec3 {
    return Vec3 { x: self.x * t, y: self.y * t, z: self.z * t };
}

func Vec3.dot(self: Vec3, other: Vec3): f32 {
    return self.x * other.x + self.y * other.y + self.z * other.z;
}

func Vec3.reflect(self: Vec3, normal: Vec3): Vec3 {
    let d = self.dot(normal) * 2.0;
    return self.sub(normal.scale(d));
}
