module tests.matchPatterns

func describe(token: Token): str {
    return match token {
        Token.Number(value) if value > 0 => "positive"
        Token.Number(_) => "number"
        Token.Word(text) => "word ${text}"
        Token.End => "end"
    }
}

func kindName(kind: types.TypeKind): str {
    return match kind {
        types.TypeKind.Struct => "struct"
        std.core.types.TypeKind.Enum => "enum"
        types.FieldInfo { name } => name
        _ => "other"
    }
}
