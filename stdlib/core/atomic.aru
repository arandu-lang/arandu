}

// ── AtomicUsize (Pointer-sized unsigned) ────────────────────────────────────

/// A pointer-sized unsigned atomic integer, ideal for reference counters.
public struct AtomicUsize {
    val: usize
}

/// Creates a new `AtomicUsize`.
public func AtomicUsize.new(val: usize): AtomicUsize {
    return AtomicUsize { val: val }
}

/// Loads the usize value.
public func AtomicUsize.load(self: ref AtomicUsize, order: MemoryOrder): usize {
    return self.val
}

/// Stores a usize value.
public func AtomicUsize.store(self: mut ref AtomicUsize, val: usize, order: MemoryOrder): void {
    self.val = val
}

/// Atomically swaps the value, returning the previous usize.
public func AtomicUsize.swap(self: mut ref AtomicUsize, val: usize, order: MemoryOrder): usize {
    let old = self.val
    self.val = val
    return old
}

/// Adds `val` atomically and returns the previous usize value.
public func AtomicUsize.fetchAdd(self: mut ref AtomicUsize, val: usize, order: MemoryOrder): usize {
    let old = self.val
    self.val = self.val + val
    return old
}

/// Subtracts `val` atomically and returns the previous usize value.
public func AtomicUsize.fetchSub(self: mut ref AtomicUsize, val: usize, order: MemoryOrder): usize {
    let old = self.val
    self.val = self.val - val
    return old
}

/// Compares value with `expected` and stores `desired` if equal.
public func AtomicUsize.compareExchange(
    self: mut ref AtomicUsize,
    expected: usize,
    desired: usize,
    success: MemoryOrder,
    failure: MemoryOrder
): Result<usize, usize> {
    if self.val == expected {
        self.val = desired
        return Result.Ok(expected)
    }
    return Result.Err(self.val)
}

/// Weak compare-and-swap for `AtomicUsize`.
public func AtomicUsize.compareExchangeWeak(
    self: mut ref AtomicUsize,
    expected: usize,
    desired: usize,
    success: MemoryOrder,
    failure: MemoryOrder
): Result<usize, usize> {
    return self.compareExchange(expected, desired, success, failure)
}

