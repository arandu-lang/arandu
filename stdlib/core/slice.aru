//! Borrowed views over contiguous element sequences (`[]T`).
//!
//! ## Overview
//!
//! A slice `[]T` is a fat-pointer view (pointer + length) over a contiguous
//! memory block. It does not own the data — it only references it. This makes
//! slices the canonical way to pass arrays and buffer parts across functions
//! without copying anything.
//!
//! `std.core.slice` provides the fundamental operations: length, subslicing,
//! checked index access, linear search and comparison. Every checked index
//! access validates bounds and traps on violation via `intrinsics.abort()`.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.slice as slice
//!
//! let arr = [10, 20, 30, 40, 50]
//! let n = slice.len<i32>(arr)               // 5
//! let sub = slice.subslice<i32>(arr, 1, 2)  // Some([20, 30])
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Zero overhead versus a raw pointer on every supported platform.
//!
//! ## See also
//!
//! - `std.core.str` — specialized slice for UTF-8 bytes
//! - `std.core.mem` — byte access and memory layout

module std.core.slice

import std.core.intrinsics as intrinsics

/// Returns the number of elements in the borrowed view `[]T`.
///
/// # Examples
/// ```arandu
/// let arr = [10, 20, 30]
/// slice.len<int>(arr) // 3
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func len<T>(s: []T): uint {
    return intrinsics.sliceLen<T>(s)
}

/// Returns the raw pointer to the underlying buffer of the slice `[]T`.
///
/// # Examples
/// ```arandu
/// let arr = [10, 20, 30]
/// let p = slice.asPtr<int>(arr)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func asPtr<T>(s: []T): ptr[T] {
    unsafe {
        return intrinsics.sliceData<T>(s)
    }
}

/// Returns `true` if the slice contains no elements (`len == 0`).
///
/// # Examples
/// ```arandu
/// slice.isEmpty<int>([])    // true
/// slice.isEmpty<int>([10])  // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isEmpty<T>(s: []T): bool {
    return len<T>(s) == 0
}

/// Returns a shared reference to the element at `index`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [10, 20, 30]
/// slice.get<int>(s, 1) // Some(ref 20)
/// slice.get<int>(s, 5) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func get<T>(s: []T, index: uint): Option<ref T> {
    if index >= len<T>(s) {
        return Option.None
    }
    return Option.Some(ref s[index])
}

/// Returns a shared reference to the first element, or `Option.None` if the slice is empty.
///
/// # Examples
/// ```arandu
/// slice.first<int>([10, 20]) // Some(ref 10)
/// slice.first<int>([])       // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func first<T>(s: []T): Option<ref T> {
    return get<T>(s, 0)
}

/// Returns a shared reference to the last element, or `Option.None` if the slice is empty.
///
/// # Examples
/// ```arandu
/// slice.last<int>([10, 20, 30]) // Some(ref 30)
/// slice.last<int>([])           // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func last<T>(s: []T): Option<ref T> {
    let count = len<T>(s)
    if count == 0 {
        return Option.None
    }
    return get<T>(s, count - 1)
}

/// Returns a checked subview starting at `start` with length `count`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [10, 20, 30, 40, 50]
/// slice.subslice<int>(s, 1, 3) // Some([20, 30, 40])
/// slice.subslice<int>(s, 4, 3) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func subslice<T>(s: []T, start: uint, count: uint): Option<[]T> {
    let total = len<T>(s)
    if start > total || count > total - start {
        return Option.None
    }
    unsafe {
        return Option.Some(intrinsics.sliceSubslice<T>(s, start, count))
    }
}

/// Minimal allocation-free iterator over shared element borrows.
public struct Iterator<T> {
    /// Borrowed slice being traversed.
    view: []T
    /// Next slice index to return.
    index: uint
}

/// Creates an iterator over the slice elements.
///
/// # Examples
/// ```arandu
/// let mut it = slice.iter<int>([1, 2])
/// it.next() // Some(ref 1)
/// it.next() // Some(ref 2)
/// it.next() // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func iter<T>(s: []T): Iterator<T> {
    return Iterator<T> { view: s, index: 0 }
}

/// Advances the iterator and returns the next element reference.
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func Iterator.next<T>(self: mut ref Iterator<T>): Option<ref T> {
    let item = get<T>(self.view, self.index)
    if self.index < len<T>(self.view) {
        self.index = self.index + 1
    }
    return item
}

/// Result of splitting a slice into two contiguous subviews.
public struct Split<T> {
    /// Borrowed elements before the split index.
    public left: []T
    /// Borrowed elements from the split index onward.
    public right: []T
}

/// Splits the slice at `mid`.
/// Returns `Option.Some(Split { left, right })` if `mid <= len(s)`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let s = [1, 2, 3, 4]
/// let res = slice.splitAt<int>(s, 2)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func splitAt<T>(s: []T, mid: uint): Option<Split<T>> {
    let total = len<T>(s)
    if mid > total {
        return Option.None
    }
    unsafe {
        let left = intrinsics.sliceSubslice<T>(s, 0, mid)
        let right = intrinsics.sliceSubslice<T>(s, mid, total - mid)
        return Option.Some(Split<T> { left: left, right: right })
    }
}
