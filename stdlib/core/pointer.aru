//! Canonical typed raw-pointer (`ptr<T>`) utilities.
//!
//! ## Overview
//!
//! `std.core.pointer` provides the most basic safe operations over raw
//! pointers: creating a null pointer, checking nullness, reinterpreting bits
//! across types and computing offsets by index.
//!
//! These functions are thin wrappers over `std.core.mem` intrinsics and
//! perform no allocation. Every raw-pointer use requires `unsafe {}`.
//!
//! Use raw pointers only when strictly necessary — FFI boundaries, allocators
//! and low-level data structures. For safe references, use `ref T` or
//! `mut ref T` in the Arandu type system.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.pointer as pointer
//!
//! unsafe {
//!     let p = pointer.null<i32>()
//!     pointer.isNull(p)  // true
//! }
//! ```
//!
//! ## Safety
//!
//! - A raw pointer may be null. Dereferencing it has no guaranteed trap
//!   behavior and violates the `ptrRead`/`ptrWrite` preconditions in
//!   `std.core.mem`; the result depends on the selected backend/platform.
//! - Pointer arithmetic is bounds-unchecked — the caller guarantees validity.
//! - Raw pointers carry no compiler-tracked lifetime.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! wasm32 lowers to linear-memory arithmetic; bare-metal gets direct MMIO
//! and register access.
//!
//! ## See also
//!
//! - `std.core.mem` — `size_of`, `align_of` and memory intrinsics
//! - `std.core.intrinsics` — traps and low-level builtins

module std.core.pointer

import std.core.mem as mem
import std.core.option as option

/// Non-null raw pointer wrapper (`ptr[T]` with null-niche optimization).
///
/// Guarantees bit-pattern 0 is uninhabited so `Option<NonNull<T>>` / `Option<Box<T>>`
/// occupy a single pointer-width word with zero tag overhead.
@NoSend
@NoSync
public struct NonNull<T> {
    private pointer: ptr[T]
}

/// Wraps `p` into `Some(NonNull<T>)` if non-null, or `Option.None` if `nil`.
public func NonNull.new<T>(p: ptr[T]): Option<NonNull<T>> {
    let nullp: ptr[T] = nil
    if p == nullp {
        return Option.None
    }
    return Option.Some(NonNull<T> { pointer: p })
}

/// Constructs a `NonNull<T>` assuming the caller has already verified `p != nil`.
@Unsafe
public func NonNull.fromRaw<T>(p: ptr[T]): NonNull<T> {
    return NonNull<T> { pointer: p }
}

/// Returns a well-aligned, non-null, dangling pointer for `T` (suitable for ZSTs or sentinels).
public func NonNull.dangling<T>(): NonNull<T> {
    let align = mem.alignOf<T>()
    let addr = if align == (0 as usize) { 1 as usize } else { align }
    return NonNull<T> { pointer: addr as ptr[T] }
}

/// Extracts the underlying raw pointer `ptr[T]`.
public func NonNull.asPtr<T>(self: ref NonNull<T>): ptr[T] {
    return self.pointer
}

/// Reinterprets this non-null pointer as `NonNull<U>`.
public func NonNull.cast<T, U>(self: NonNull<T>): NonNull<U> {
    return NonNull<U> { pointer: self.pointer as ptr[U] }
}

/// Returns a null pointer (`nil`) typed as `ptr[T]`.
///
/// # Examples
/// ```arandu
/// let p = pointer.null<int>()
/// pointer.isNull(p) // true
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func null<T>(): ptr[T] {
    return nil
}

/// Returns `true` if the pointer `p` is null (`nil`).
///
/// # Examples
/// ```arandu
/// let p = pointer.null<int>()
/// pointer.isNull(p) // true
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isNull<T>(p: ptr[T]): bool {
    let nullp: ptr[T] = nil
    return p == nullp
}

// Dereference and pointer arithmetic intentionally remain in `std.core.mem`.
// Those operations are compiler intrinsics and require explicit acknowledgement
// of validity, alignment, and lifetime invariants via `unsafe` blocks.

// ── Inherent methods on `ptr` ───────────────────────────────────────────────

/// Returns `true` if the pointer is null (`nil`).
public func ptr.isNull<T>(self: ptr[T]): bool {
    return isNull<T>(self)
}

/// Distance from `origin` to this pointer, in elements of `T`: `p - q` in
/// C, `offset_from` in Rust. Only the addresses take part; nothing is read.
/// Both pointers should point into the same object for the distance to
/// mean anything, and `T` must have a size.
///
/// # Examples
/// ```arandu
/// let end = unsafe { mem.ptrOffset(start, 3) }
/// end.offsetFrom(start) // 3
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func ptr.offsetFrom<T>(self: ptr[T], origin: ptr[T]): isize {
    return ((self as isize) - (origin as isize)) / (mem.sizeOf<T>() as isize)
}
