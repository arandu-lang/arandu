module examples.minimal.m15_vec_capacity

// PROMOTE-L6 closeout: withCapacity, capacity, reserve, growth, empty pop.
import std.alloc.vec as vec

func main(): int {
    // withCapacity pre-allocates (may round up geometrically).
    let mut v = vec.Vec<int>.withCapacity(4)
    let c0 = v.capacity()
    if c0 < 4 {
        return 10
    }
    if !v.isEmpty() {
        return 11
    }

    // Empty pop is None → use 0.
    let pe = v.pop()
    match pe {
        Some(_) => {
            return 12
        }
        None => {}
    }

    v.push(1)
    v.push(2)
    // reserve(6) from len=2 → need capacity ≥ 8
    v.reserve(6)
    if v.capacity() < 8 {
        return 13
    }

    // Grow past 8 elements to force realloc.
    v.push(3)
    v.push(4)
    v.push(5)
    v.push(6)
    v.push(7)
    v.push(8)
    v.push(9)
    v.push(10)
    let n = v.len() as int
    let last = v.getCopy(9)
    match last {
        Some(x) => {
            v.clear()
            if !v.isEmpty() {
                return 14
            }
            // capacity retained after clear
            let cap = v.capacity() as int
            if cap < 8 {
                return 15
            }
            return n + x + 1
        }
        None => {
            return 16
        }
    }
}
