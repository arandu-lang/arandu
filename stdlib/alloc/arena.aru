//! Contiguous arenas for grouped allocations.
//!
//! ## Overview
//!
//! `Arena` allocates from one buffer and resets the whole region at once. `ScratchArena` adds checkpoints and rewinding for temporary work.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.arena as arena
//!
//! let mut scratch = arena.ScratchArena.withCapacity(4096)
//! let mark = scratch.checkpoint()
//! scratch.rewind(mark)
//! ```
//!
//! ## Safety
//! Pointers and slices allocated from an arena are invalidated by reset,
//! rewind past their allocation, or when the arena is dropped. Do not retain
//! them beyond the owning arena's lifetime.
//!
//! ## Allocations
//! Creating an arena obtains one backing buffer. Bump allocations inside
//! available capacity do not request another buffer.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.arena

/// High-performance contiguous Bump Allocators (Arena & ScratchArena).
///
/// Follows Data-Oriented Design (DoD):
/// - Allocates a single large memory block up-front.
/// - Allocation is a pointer bump: O(1) instruction sequence.
/// - Whole-arena reset is instantaneous O(1) without per-object traversal or individual frees.
/// - Scoped rollback via checkpoints and rewinds without deallocation overhead.
/// - Ideal for AST nodes, compilers, linear algebra kernels, packing buffers, and transient scopes.

import std.core.mem as mem
import std.core.intrinsics as intrinsics

const MAX_ARENA_CAPACITY = 2147483647 as usize

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: usize): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
}

// ── General Bump Arena ───────────────────────────────────────────────────────

/// Contiguous bump allocation arena.
public struct Arena {
    /// Pointer to the stored elements or bytes.
    data: ptr[u8]
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: usize
    /// Current byte offset from the start of the arena.
    offset: usize
}

func new(capacity: usize): Arena {
    let mut actualCapacity = capacity
    let mut data: ptr[u8] = nil
    if capacity > MAX_ARENA_CAPACITY {
        actualCapacity = 0 as usize
    } else {
        unsafe {
            data = ar_vec_malloc(capacity)
        }
    }
    return Arena {
        data: data,
        capacity: actualCapacity,
        offset: 0 as usize,
    }
}

/// Obtains one backing buffer with `capacity` bytes for a new arena.
///
/// Subsequent allocations use this fixed buffer. If the host allocator
/// returns a null pointer, `alloc` returns `None`.
public func Arena.new(capacity: usize): Arena {
    return new(capacity)
}

/// Creates an `Arena` with `capacity` bytes; equivalent to `Arena.new(capacity)`.
public func Arena.withCapacity(capacity: usize): Arena {
    return new(capacity)
}

/// Allocates `size` bytes from the arena aligned to `align` boundary.
///
/// Returns `Some(pointer)` if the aligned region fits, or `None` if the
/// backing buffer is unavailable or exhausted. An alignment of zero or one
/// applies no padding. Successful pointers remain valid until `reset` or
/// drop; there is no individual deallocation.
public func Arena.alloc(self: mut ref Arena, size: usize, align: usize): Option<ptr[u8]> {
    let nullp: ptr[u8] = nil
    let data = self.data
    if data == nullp || self.capacity > MAX_ARENA_CAPACITY || self.offset > self.capacity {
        return Option.None
    }
    let mut padding: usize = 0 as usize
    if align > (1 as usize) {
        let rem = self.offset % align
        if rem != (0 as usize) {
            padding = align - rem
        }
    }
    if padding > self.capacity - self.offset {
        return Option.None
    }
    let aligned = self.offset + padding
    if size > self.capacity - aligned {
        return Option.None
    }
    let nextOffset = aligned + size
    let res = mem.ptrOffset<u8>(self.data, aligned as isize)
    self.offset = nextOffset
    return Option.Some(res)
}

/// Allocates contiguous space for `count` elements of type `T`.
///
/// Returns an aligned pointer on success or `None` when the region cannot fit.
/// The returned storage is raw; callers must initialize elements before
/// reading them. Resetting or dropping the arena invalidates the pointer.
public func Arena.allocTyped<T>(self: mut ref Arena, count: usize): Option<ptr[T]> {
    let elemSize = mem.sizeOf<T>()
    let elemAlign = mem.alignOf<T>()
    if elemSize > (0 as usize) && count > MAX_ARENA_CAPACITY / elemSize {
        return Option.None
    }
    let totalSize = elemSize * count
    let raw = self.alloc(totalSize, elemAlign)
    if raw is Option.Some(p) {
        return Option.Some(p as ptr[T])
    }
    return Option.None
}

/// Allocates a contiguous slice `[]T` of `count` elements from the arena.
///
/// Returns `Some(slice)` backed by arena memory, or `None` if it cannot fit.
/// The slice borrows the arena, so it must not be used after `reset` or drop.
public func Arena.allocSlice<T>(self: mut ref Arena, count: usize): Option<[]T> {
    let optPtr = self.allocTyped<T>(count)
    if optPtr is Option.Some(p) {
        unsafe {
            return Option.Some(intrinsics.sliceFromRaw<Arena, T>(self, p, count))
        }
    }
    return Option.None
}

/// Resets the allocation offset to zero without releasing the backing buffer.
///
/// All previously returned pointers and slices become invalid. The operation
/// does not visit values stored in the arena and runs in O(1) time.
public func Arena.reset(self: mut ref Arena): void {
    self.offset = 0 as usize
}

/// Returns the number of bytes currently allocated in the arena.
public func Arena.allocatedBytes(self: ref Arena): usize {
    return self.offset
}

/// Returns the number of remaining bytes available before exhaustion.
public func Arena.remainingBytes(self: ref Arena): usize {
    if self.offset >= self.capacity {
        return 0 as usize
    }
    return self.capacity - self.offset
}

/// Returns the total capacity in bytes of the arena.
public func Arena.capacity(self: ref Arena): usize {
    return self.capacity
}

/// Internal helper that releases the backing buffer and resets capacity and offset to zero.
func destroyArena(a: mut ref Arena): void {
    let nullp: ptr[u8] = nil
    if a.data != nullp {
        unsafe {
            ar_vec_buf_free(a.data, a.capacity)
            a.data = nullp
            a.capacity = 0 as usize
            a.offset = 0 as usize
        }
    }
}

/// Automatic destructor invoked when an owned `Arena` leaves scope.
@Destructor
func Arena.destroy(self: own Arena): void {
    destroyArena(self)
}

// ── Scratch Arena (RFC 0012) ─────────────────────────────────────────────────

/// Transient scratchpad bump allocator for DoD workloads, kernels, and temporary scopes.
///
/// Features:
/// - O(1) bump allocation with custom alignment.
/// - Scoped checkpoints and instant rollbacks via `checkpoint()` and `rewind(mark)`.
/// - Full-arena instantaneous reset via `reset()`.
/// - Profile-guided high-water mark tracking via `peakBytes()`.
/// - Typed allocations (`allocTyped<T>`) and safe slice views (`allocSlice<T>`).
public struct ScratchArena {
    /// Pointer to the stored elements or bytes.
    data: ptr[u8]
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: usize
    /// Current byte offset from the start of the arena.
    offset: usize
    /// Largest byte offset reached since the last peak reset.
    peak: usize
}

/// Obtains one backing buffer with `capacity` bytes for temporary allocations.
///
/// Allocation is limited to this buffer until drop; `peakBytes` initially
/// returns zero.
public func ScratchArena.new(capacity: usize): ScratchArena {
    let mut actualCapacity = capacity
    let mut data: ptr[u8] = nil
    if capacity > MAX_ARENA_CAPACITY {
        actualCapacity = 0 as usize
    } else {
        unsafe {
            data = ar_vec_malloc(capacity)
        }
    }
    return ScratchArena {
        data: data,
        capacity: actualCapacity,
        offset: 0 as usize,
        peak: 0 as usize,
    }
}

/// Creates a scratch arena; equivalent to `ScratchArena.new(capacity)`.
public func ScratchArena.withCapacity(capacity: usize): ScratchArena {
    return ScratchArena.new(capacity)
}

/// Allocates `size` bytes from the scratch arena aligned to `align` boundary.
///
/// Returns `Some(pointer)` when the aligned region fits, or `None` otherwise.
/// An alignment of zero or one applies no padding. Success advances the
/// offset and may raise the peak; a later `rewind`, `reset`, or drop can
/// invalidate the pointer.
public func ScratchArena.alloc(self: mut ref ScratchArena, size: usize, align: usize): Option<ptr[u8]> {
    let nullp: ptr[u8] = nil
    let data = self.data
    if data == nullp || self.capacity > MAX_ARENA_CAPACITY || self.offset > self.capacity {
        return Option.None
    }
    let mut padding: usize = 0 as usize
    if align > (1 as usize) {
        let rem = self.offset % align
        if rem != (0 as usize) {
            padding = align - rem
        }
    }
    if padding > self.capacity - self.offset {
        return Option.None
    }
    let aligned = self.offset + padding
    if size > self.capacity - aligned {
        return Option.None
    }
    let nextOffset = aligned + size
    let res = mem.ptrOffset<u8>(self.data, aligned as isize)
    self.offset = nextOffset
    if self.offset > self.peak {
        self.peak = self.offset
    }
    return Option.Some(res)
}

/// Allocates contiguous space for `count` elements of type `T`.
///
/// Returns `Option.Some(ptr[T])` aligned to `mem.alignOf<T>()`, or `Option.None` on out-of-memory.
public func ScratchArena.allocTyped<T>(self: mut ref ScratchArena, count: usize): Option<ptr[T]> {
    let elemSize = mem.sizeOf<T>()
    let elemAlign = mem.alignOf<T>()
    if elemSize > (0 as usize) && count > MAX_ARENA_CAPACITY / elemSize {
        return Option.None
    }
    let totalSize = elemSize * count
    let raw = self.alloc(totalSize, elemAlign)
    if raw is Option.Some(p) {
        return Option.Some(p as ptr[T])
    }
    return Option.None
}

/// Allocates a contiguous slice `[]T` of `count` elements from the scratch arena.
///
/// Returns `Option.Some([]T)` backed by arena memory, or `Option.None` on out-of-memory.
public func ScratchArena.allocSlice<T>(self: mut ref ScratchArena, count: usize): Option<[]T> {
    let optPtr = self.allocTyped<T>(count)
    if optPtr is Option.Some(p) {
        unsafe {
            return Option.Some(intrinsics.sliceFromRaw<ScratchArena, T>(self, p, count))
        }
    }
    return Option.None
}

/// Returns the current byte offset as a mark for a later `rewind`.
///
/// A mark belongs to this arena and is meaningful only while allocations
/// made since the checkpoint have not been reset or the arena dropped.
public func ScratchArena.checkpoint(self: ref ScratchArena): usize {
    return self.offset
}

/// Rewinds the allocation offset back to `mark`, instantly reclaiming memory allocated since that checkpoint.
///
/// If `mark` exceeds the current offset, the rewind is ignored. Pointers and
/// slices allocated after the mark become invalid. The high-water mark is
/// preserved for `peakBytes`.
public func ScratchArena.rewind(self: mut ref ScratchArena, mark: usize): void {
    if mark <= self.offset {
        self.offset = mark
    }
}

/// Resets the scratch arena, reclaiming all allocated memory instantly in O(1) time.
/// All outstanding pointers and slices become invalid. `peakBytes()` is
/// preserved across resets for capacity planning.
public func ScratchArena.reset(self: mut ref ScratchArena): void {
    self.offset = 0 as usize
}

/// Starts a new peak measurement at the current allocation offset.
///
/// Later allocations can raise the peak again; this does not reset or free
/// any existing allocation.
public func ScratchArena.resetPeak(self: mut ref ScratchArena): void {
    self.peak = self.offset
}

/// Returns the number of bytes currently allocated in the scratch arena.
public func ScratchArena.allocatedBytes(self: ref ScratchArena): usize {
    return self.offset
}

/// Returns the number of remaining bytes available before exhaustion.
public func ScratchArena.remainingBytes(self: ref ScratchArena): usize {
    if self.offset >= self.capacity {
        return 0 as usize
    }
    return self.capacity - self.offset
}

/// Returns the high-water mark of allocated bytes across the lifetime (or since last `resetPeak`).
public func ScratchArena.peakBytes(self: ref ScratchArena): usize {
    return self.peak
}

/// Returns the total capacity in bytes of the scratch arena.
public func ScratchArena.capacity(self: ref ScratchArena): usize {
    return self.capacity
}

/// Internal helper that releases the backing buffer and resets offset, capacity, and peak to zero.
func destroyScratchArena(a: mut ref ScratchArena): void {
    let nullp: ptr[u8] = nil
    if a.data != nullp {
        unsafe {
            ar_vec_buf_free(a.data, a.capacity)
            a.data = nullp
            a.capacity = 0 as usize
            a.offset = 0 as usize
            a.peak = 0 as usize
        }
    }
}

/// Automatic destructor invoked when an owned `ScratchArena` leaves scope.
@Destructor
func ScratchArena.destroy(self: own ScratchArena): void {
    destroyScratchArena(self)
}
