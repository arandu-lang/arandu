//! Double-ended queue implemented with a contiguous ring buffer.
//!
//! ## Overview
//!
//! `VecDeque<T>` is a growable ring buffer providing O(1) amortized insertions
//! and removals at both ends (`pushFront`, `popFront`, `pushBack`, `popBack`).
//!
//! The buffer capacity is always a power of two ($2^k$), allowing physical slot
//! indexing using bitwise masking (`(head + index) & (capacity - 1)`) instead of
//! costly division instructions.
//!
//! ## Examples
//!
//! ```arandu
//! import std.alloc.deque as deque
//!
//! let mut q = deque.VecDeque<int>.new()
//! q.pushBack(10)
//! q.pushBack(20)
//! q.pushFront(5)
//!
//! assert(q.popFront() is Option.Some(5))
//! assert(q.popBack() is Option.Some(20))
//! assert(q.popFront() is Option.Some(10))
//! assert(q.isEmpty())
//! ```
//!
//! ## Platform
//! `native` · `wasm32`
module std.alloc.deque

import std.core.mem as mem
import std.core.intrinsics as intrinsics
import std.core.option as option

extern "C" {
    func ar_vec_malloc(size: usize): ptr[u8]
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
}

const MINIMUM_CAPACITY = 8 as usize

/// Double-ended queue backed by a circular buffer.
public struct VecDeque<T> {
    data: ptr[T],
    head: usize,
    len: usize,
    capacity: usize,
}

func elemSize<T>(): usize {
    let size = mem.sizeOf<T>()
    if size == (0 as usize) { return 1 as usize }
    return size
}

func maxPowerOfTwoCapacity<T>(): usize {
    let maxBytes: usize = 2147483647 as usize
    let maxElements = maxBytes / elemSize<T>()
    if maxElements < MINIMUM_CAPACITY {
        return 0 as usize
    }
    let mut cap = MINIMUM_CAPACITY
    while cap <= maxElements / (2 as usize) {
        cap = cap * (2 as usize)
    }
    return cap
}

func capacityOverflow(): void {
    unsafe {
        intrinsics.abort()
    }
}

func roundUpPowerOfTwo<T>(n: usize): usize {
    let mut cap = MINIMUM_CAPACITY
    let maxCap = maxPowerOfTwoCapacity<T>()
    if maxCap < MINIMUM_CAPACITY || n > maxCap {
        capacityOverflow()
    }
    while cap < n {
        if cap > maxCap / (2 as usize) {
            capacityOverflow()
        }
        cap = cap * (2 as usize)
    }
    return cap
}

/// Creates a new, empty `VecDeque<T>`.
public func VecDeque.new<T>(): VecDeque<T> {
    let nullp: ptr[T] = nil
    return VecDeque<T> {
        data: nullp,
        head: 0 as usize,
        len: 0 as usize,
        capacity: 0 as usize,
    }
}

/// Creates a `VecDeque<T>` with at least the specified initial capacity.
public func VecDeque.withCapacity<T>(capacity: usize): VecDeque<T> {
    let nullp: ptr[T] = nil
    if capacity == (0 as usize) {
        return VecDeque<T>.new()
    }
    let cap = roundUpPowerOfTwo<T>(capacity)
    unsafe {
        let raw = ar_vec_malloc(cap * elemSize<T>())
        let nullp: ptr[u8] = nil
        if raw == nullp {
            intrinsics.abort()
        }
        return VecDeque<T> {
            data: raw as ptr[T],
            head: 0 as usize,
            len: 0 as usize,
            capacity: cap,
        }
    }
}

/// Returns the number of elements in the deque.
public func VecDeque.len<T>(self: ref VecDeque<T>): usize {
    return self.len
}

/// Returns `true` if the deque is empty.
public func VecDeque.isEmpty<T>(self: ref VecDeque<T>): bool {
    return self.len == (0 as usize)
}

/// Returns the total capacity before reallocation is required.
public func VecDeque.capacity<T>(self: ref VecDeque<T>): usize {
    return self.capacity
}

func VecDeque.grow<T>(self: mut ref VecDeque<T>): void {
    let maxCap = maxPowerOfTwoCapacity<T>()
    let newCap = if self.capacity == (0 as usize) {
        if maxCap < MINIMUM_CAPACITY {
            capacityOverflow()
        }
        MINIMUM_CAPACITY
    } else {
        if self.capacity > maxCap / (2 as usize) {
            capacityOverflow()
        }
        self.capacity * (2 as usize)
    }

    unsafe {
        let raw = ar_vec_malloc(newCap * elemSize<T>())
        let nullp: ptr[u8] = nil
        if raw == nullp {
            intrinsics.abort()
        }
        let newData = raw as ptr[T]

        // Copy elements in order from old buffer to new buffer
        let mut i = 0 as usize
        let mask = self.capacity - (1 as usize)
        while i < self.len {
            let phys = (self.head + i) & mask
            let src = mem.ptrOffset<T>(self.data, phys as isize)
            let dst = mem.ptrOffset<T>(newData, i as isize)
            mem.ptrWrite<T>(dst, mem.ptrRead<T>(src))
            i = i + (1 as usize)
        }

        if self.capacity > (0 as usize) {
            ar_vec_buf_free(self.data as ptr[u8], self.capacity * elemSize<T>())
        }

        self.data = newData
        self.head = 0 as usize
        self.capacity = newCap
    }
}

/// Appends an element to the back of the deque.
public func VecDeque.pushBack<T>(self: mut ref VecDeque<T>, value: T): void {
    if self.len == self.capacity {
        self.grow()
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let phys = (self.head + self.len) & mask
        let dst = mem.ptrOffset<T>(self.data, phys as isize)
        mem.ptrWrite<T>(dst, value)
        self.len = self.len + (1 as usize)
    }
}

/// Prepends an element to the front of the deque.
public func VecDeque.pushFront<T>(self: mut ref VecDeque<T>, value: T): void {
    if self.len == self.capacity {
        self.grow()
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let newHead = (self.head + self.capacity - (1 as usize)) & mask
        let dst = mem.ptrOffset<T>(self.data, newHead as isize)
        mem.ptrWrite<T>(dst, value)
        self.head = newHead
        self.len = self.len + (1 as usize)
    }
}

/// Removes and returns the element at the back of the deque.
public func VecDeque.popBack<T>(self: mut ref VecDeque<T>): Option<T> {
    if self.len == (0 as usize) {
        return Option.None
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let phys = (self.head + self.len - (1 as usize)) & mask
        let src = mem.ptrOffset<T>(self.data, phys as isize)
        let val = mem.ptrRead<T>(src)
        self.len = self.len - (1 as usize)
        return Option.Some(val)
    }
}

/// Removes and returns the element at the front of the deque.
public func VecDeque.popFront<T>(self: mut ref VecDeque<T>): Option<T> {
    if self.len == (0 as usize) {
        return Option.None
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let src = mem.ptrOffset<T>(self.data, self.head as isize)
        let val = mem.ptrRead<T>(src)
        self.head = (self.head + (1 as usize)) & mask
        self.len = self.len - (1 as usize)
        return Option.Some(val)
    }
}

/// Borrows the element at logical index `index`.
public func VecDeque.get<T>(self: ref VecDeque<T>, index: usize): Option<ref T> {
    if index >= self.len {
        return Option.None
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let phys = (self.head + index) & mask
        let p = mem.ptrOffset<T>(self.data, phys as isize)
        return Option.Some(ref *p)
    }
}

/// Exclusively borrows the element at logical index `index`.
public func VecDeque.getMut<T>(self: mut ref VecDeque<T>, index: usize): Option<mut ref T> {
    if index >= self.len {
        return Option.None
    }
    unsafe {
        let mask = self.capacity - (1 as usize)
        let phys = (self.head + index) & mask
        let p = mem.ptrOffset<T>(self.data, phys as isize)
        return Option.Some(mut ref *p)
    }
}

/// Borrows the element at the front of the deque without removing it.
public func VecDeque.front<T>(self: ref VecDeque<T>): Option<ref T> {
    return self.get(0 as usize)
}

/// Exclusively borrows the element at the front of the deque without removing it.
public func VecDeque.frontMut<T>(self: mut ref VecDeque<T>): Option<mut ref T> {
    return self.getMut(0 as usize)
}

/// Borrows the element at the back of the deque without removing it.
public func VecDeque.back<T>(self: ref VecDeque<T>): Option<ref T> {
    if self.len == (0 as usize) {
        return Option.None
    }
    return self.get(self.len - (1 as usize))
}

/// Exclusively borrows the element at the back of the deque without removing it.
public func VecDeque.backMut<T>(self: mut ref VecDeque<T>): Option<mut ref T> {
    if self.len == (0 as usize) {
        return Option.None
    }
    return self.getMut(self.len - (1 as usize))
}

/// Clears all elements from the deque without releasing allocated capacity.
public func VecDeque.clear<T>(self: mut ref VecDeque<T>): void {
    unsafe {
        let mask = self.capacity - (1 as usize)
        let mut i = 0 as usize
        while i < self.len {
            let phys = (self.head + i) & mask
            let p = mem.ptrOffset<T>(self.data, phys as isize)
            mem.dropInPlace<T>(p)
            i = i + (1 as usize)
        }
    }
    self.head = 0 as usize
    self.len = 0 as usize
}

func destroyVecDeque<T>(d: mut ref VecDeque<T>): void {
    let nullp: ptr[T] = nil
    if d.data != nullp && d.capacity > (0 as usize) {
        d.clear()
        unsafe {
            ar_vec_buf_free(d.data as ptr[u8], d.capacity * elemSize<T>())
        }
    }
}

/// Destroys the deque, invoking destructors on all elements and releasing storage.
@Destructor
func VecDeque.destroy<T>(self: own VecDeque<T>): void {
    destroyVecDeque(self)
}
