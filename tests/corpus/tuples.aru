module tuples

// Tuples are values: `(a, b)` builds one, `(A, B)` is its type, `t.0` reads
// an element by position, and `let (a, b) = t`, `match` and a function's
// several results all destructure the same type.

import std.alloc.string as strings

struct Point { x: int, y: int }

func pair(): (int, int) {
    return 1, 2
}

func swap(p: (int, int)): (int, int) {
    return (p.1, p.0)
}

func named(id: int): (int, strings.String) {
    return (id, strings.String.from("name"))
}

func nested(): ((int, int), bool) {
    return ((3, 4), true)
}

func main(): int {
    let t = (1, 2)
    if t.0 + t.1 != 3 { return 1 }
    let u: (int, int) = swap(t)
    if u.0 != 2 || u.1 != 1 { return 2 }
    let (a, b) = pair()
    if a + b != 3 { return 3 }
    let n = named(7)
    if n.0 != 7 || n.1.len() != 4 { return 4 }
    let (id, text) = named(8)
    if id != 8 || text.len() != 4 { return 5 }
    let deep = nested()
    if deep.0.1 != 4 || !deep.1 { return 6 }
    let mixed = (Point { x: 1, y: 2 }, 2.5, 'c')
    if mixed.0.y != 2 { return 7 }
    let mut m = (1, 2)
    m.0 = 10
    if m.0 + m.1 != 12 { return 8 }
    let kind = match t {
        (1, 2) => 1,
        (_, _) => 0,
    }
    if kind != 1 { return 9 }
    let xs = [10, 20, 30]
    let mut sum = 0
    for (i, x) in xs {
        sum += i as int * x
    }
    if sum != 80 { return 10 }
    if swap((5, 6)).0 != 6 { return 11 }
    // `for i, x in xs` binds the position and the element; over a range the
    // position still counts from zero.
    let mut acc: usize = 0
    for i, v in 5..8 {
        acc += i * 10 + v as usize
    }
    if acc != 48 { return 12 }
    return 0
}
