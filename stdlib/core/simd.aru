    return self.testLane(0) || self.testLane(1) || self.testLane(2) || self.testLane(3) || self.testLane(4) || self.testLane(5) || self.testLane(6) || self.testLane(7) || self.testLane(8) || self.testLane(9) || self.testLane(10) || self.testLane(11) || self.testLane(12) || self.testLane(13) || self.testLane(14) || self.testLane(15)
