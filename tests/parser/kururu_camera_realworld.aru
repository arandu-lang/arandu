struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

struct Ray {
    origin: Vec3,
    direction: Vec3,
}

struct Camera {
    origin: Vec3,
    lower_left: Vec3,
    horizontal: Vec3,
    vertical: Vec3,
}

func buildDefaultCamera(): Camera {
    return Camera {
        origin: Vec3 { x: 0.0, y: 1.0, z: 3.0 },
        lower_left: Vec3 { x: -2.0, y: -0.5, z: 1.0 },
        horizontal: Vec3 { x: 4.0, y: 0.0, z: 0.0 },
        vertical: Vec3 { x: 0.0, y: 3.0, z: 0.0 },
    };
}
