struct Sha256State {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    h4: u32,
    h5: u32,
    h6: u32,
    h7: u32,
    buf_len: usize,
    total_bytes: u64,
}

func rotr32(x: u32, n: u32): u32 {
    return (x >> n) | (x << ((32 as u32) - n));
}

func ch(e: u32, f: u32, g: u32): u32 {
    return (e & f) ^ ((~e) & g);
}

func maj(a: u32, b: u32, c: u32): u32 {
    return (a & b) ^ (a & c) ^ (b & c);
}

func sigma0(a: u32): u32 {
    return rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
}

func sigma1(e: u32): u32 {
    return rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
}

func beU32(b: []u8, off: usize): u32 {
    let b0 = b[off] as u32;
    let b1 = b[off + 1] as u32;
    let b2 = b[off + 2] as u32;
    let b3 = b[off + 3] as u32;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}
