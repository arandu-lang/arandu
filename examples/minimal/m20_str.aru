module examples.minimal.m20_str

// Minimal 0.1 — std.core.str pure heapless (isEmpty / len / startsWith / endsWith / contains / find).
import std.core.str as s

func main(): int {
    if !s.isEmpty("") {
        return 1
    }
    if s.isEmpty("x") {
        return 2
    }
    if s.len("hi") != 2 {
        return 3
    }
    if !s.startsWith("hello", "he") {
        return 4
    }
    if s.startsWith("hello", "x") {
        return 5
    }
    if !s.endsWith("hello", "lo") {
        return 6
    }
    if !s.contains("hello world", "world") {
        return 7
    }
    if s.contains("hello world", "xyz") {
        return 8
    }
    match s.find("hello world", "world") {
        Some(idx) => {
            if idx != 6 {
                return 9
            }
        }
        None => {
            return 10
        }
    }
    return 0
}
