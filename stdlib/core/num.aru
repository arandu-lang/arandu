//! Checked and saturating integer arithmetic.
//!
//! ## Overview
//!
//! `std.core.num` exposes arithmetic operations that detect overflow instead of
//! silencing it. Every `checked*` function returns `Option<T>` — `Some(value)`
//! on success and `None` on overflow — enabling explicit handling without
//! resorting to undefined behavior. The `saturating*` variants clamp to the
//! type bounds instead.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.num as num
//!
//! let r = num.checkedAdd(2147483647, 1)
//! // r == Option.None  (overflow detected)
//!
//! let s = num.saturatingAdd(2147483647, 1)
//! // s == 2147483647  (saturated at the bound)
//! ```
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`
//!
//! Behaves identically on 32- and 64-bit targets.
//!
//! ## See also
//!
//! - `std.core.fixed` — FPU-free fixed-point arithmetic
//! - `std.core.cmp` — comparison and ordering
module std.core.num

import std.core.intrinsics as intrinsics

func intMax(): int {
    return 2147483647
}

func intMin(): int {
    return -2147483647 - 1
}

/// Checked integer addition.
///
/// Returns `Option.Some(a + b)` if the operation does not overflow the target integer bounds,
/// or `Option.None` on arithmetic overflow or underflow.
///
/// # Examples
/// ```arandu
/// num.checkedAdd(10, 20) // Some(30)
/// num.checkedAdd(-5, 2)  // Some(-3)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedAdd(a: int, b: int): Option<int> {
    if (b > 0 && a > intMax() - b) || (b < 0 && a < intMin() - b) {
        return Option.None
    }
    return Option.Some(a + b)
}

/// Checked integer subtraction.
///
/// Returns `Option.Some(a - b)` if the operation does not overflow or underflow,
/// or `Option.None` on arithmetic overflow.
///
/// # Examples
/// ```arandu
/// num.checkedSub(20, 10) // Some(10)
/// num.checkedSub(5, 10)  // Some(-5)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedSub(a: int, b: int): Option<int> {
    if (b > 0 && a < intMin() + b) || (b < 0 && a > intMax() + b) {
        return Option.None
    }
    return Option.Some(a - b)
}

/// Checked integer multiplication.
///
/// Returns `Option.Some(a * b)` if the operation does not overflow,
/// or `Option.None` on arithmetic overflow.
///
/// # Examples
/// ```arandu
/// num.checkedMul(6, 7) // Some(42)
/// num.checkedMul(0, 100) // Some(0)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func checkedMul(a: int, b: int): Option<int> {
    if a == 0 || b == 0 {
        return Option.Some(0)
    }
    let max = intMax()
    let min = intMin()
    if (a == -1 && b == min) || (b == -1 && a == min) {
        return Option.None
    }
    if (a > 0 && b > 0 && a > max / b)
    || (a > 0 && b < 0 && b < min / a)
    || (a < 0 && b > 0 && a < min / b)
    || (a < 0 && b < 0 && a < max / b) {
        return Option.None
    }
    return Option.Some(a * b)
}

/// Saturating integer addition.
///
/// Computes `a + b`, clamping to `intMax()` on positive overflow or `intMin()` on negative overflow.
///
/// # Examples
/// ```arandu
/// num.saturatingAdd(10, 20) // 30
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func saturatingAdd(a: int, b: int): int {
    match checkedAdd(a, b) {
        Some(v) => {
            return v
        }
        None => {
            if b > 0 {
                return intMax()
            }
            return intMin()
        }
    }
}

/// Saturating integer subtraction.
///
/// Computes `a - b`, clamping to `intMax()` on positive overflow or `intMin()` on negative underflow.
///
/// # Examples
/// ```arandu
/// num.saturatingSub(20, 10) // 10
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func saturatingSub(a: int, b: int): int {
    match checkedSub(a, b) {
        Some(v) => {
            return v
        }
        None => {
            if b > 0 {
                return intMin()
            }
            return intMax()
        }
    }
}

// ── Inherent methods on `int` ───────────────────────────────────────────────

/// Returns the magnitude; traps for the unrepresentable magnitude of intMin().
public func int.abs(self: int): int {
    if self == intMin() { unsafe { intrinsics.abort() } }
    if self < 0 {
        return -self
    }
    return self
}

/// Checked integer addition.
public func int.checkedAdd(self: int, other: int): Option<int> {
    return checkedAdd(self, other)
}

/// Checked integer subtraction.
public func int.checkedSub(self: int, other: int): Option<int> {
    return checkedSub(self, other)
}

/// Checked integer multiplication.
public func int.checkedMul(self: int, other: int): Option<int> {
    return checkedMul(self, other)
}

/// Saturating integer addition.
public func int.saturatingAdd(self: int, other: int): int {
    return saturatingAdd(self, other)
}

/// Saturating integer subtraction.
public func int.saturatingSub(self: int, other: int): int {
    return saturatingSub(self, other)
}

/// Counts set bits. Pure and allocation-free.
public func countOnes(value: u32): u32 {
    return intrinsics.bitCountOnes32(value)
}

/// Counts set bits.
public func u32.countOnes(self: u32): u32 {
    return countOnes(self)
}

/// Counts set bits. Pure and allocation-free.
public func countOnes64(value: u64): u32 {
    return intrinsics.bitCountOnes64(value)
}

/// Counts set bits.
public func u64.countOnes(self: u64): u32 {
    return countOnes64(self)
}

/// Counts leading zero bits; zero returns 32. Pure and allocation-free.
public func leadingZeros(value: u32): u32 {
    return intrinsics.bitLeadingZeros32(value)
}

/// Counts leading zero bits; zero returns 32.
public func u32.leadingZeros(self: u32): u32 {
    return leadingZeros(self)
}

/// Counts leading zero bits; zero returns 64. Pure and allocation-free.
public func leadingZeros64(value: u64): u32 {
    return intrinsics.bitLeadingZeros64(value)
}

/// Counts leading zero bits; zero returns 64.
public func u64.leadingZeros(self: u64): u32 {
    return leadingZeros64(self)
}

/// Counts trailing zero bits; zero returns 32. Pure and allocation-free.
public func trailingZeros(value: u32): u32 {
    return intrinsics.bitTrailingZeros32(value)
}

/// Counts trailing zero bits; zero returns 32.
public func u32.trailingZeros(self: u32): u32 {
    return trailingZeros(self)
}

/// Counts trailing zero bits; zero returns 64. Pure and allocation-free.
public func trailingZeros64(value: u64): u32 {
    return intrinsics.bitTrailingZeros64(value)
}

/// Counts trailing zero bits; zero returns 64.
public func u64.trailingZeros(self: u64): u32 {
    return trailingZeros64(self)
}

/// Reverses all 32 bits. Pure and allocation-free.
public func reverseBits(value: u32): u32 {
    return intrinsics.bitReverse32(value)
}

/// Reverses all 32 bits.
public func u32.reverseBits(self: u32): u32 {
    return reverseBits(self)
}

/// Reverses all 64 bits. Pure and allocation-free.
public func reverseBits64(value: u64): u64 {
    return intrinsics.bitReverse64(value)
}

/// Reverses all 64 bits.
public func u64.reverseBits(self: u64): u64 {
    return reverseBits64(self)
}

/// Returns None when the magnitude cannot be represented in int.
public func checkedAbs(value: int): Option<int> {
    if value == intMin() { return Option.None }
    if value < 0 { return Option.Some(-value) }
    return Option.Some(value)
}

/// Returns None for intMin(); otherwise returns the magnitude.
public func int.checkedAbs(self: int): Option<int> {
    return checkedAbs(self)
}
