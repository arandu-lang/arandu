module mathContract

import std.core.math as math

func approxEq(a: float, b: float, epsilon: float): bool {
    let diff = math.abs(a - b)
    return diff <= epsilon
}

public func main(): int {
    // 1. Constantes
    if math.pi() <= 3.1415 || math.pi() >= 3.1416 { return 1 }
    if math.tau() <= 6.2831 || math.tau() >= 6.2832 { return 2 }
    if math.e() <= 2.7182 || math.e() >= 2.7183 { return 3 }
    if math.sqrt2() <= 1.4142 || math.sqrt2() >= 1.4143 { return 4 }

    // 2. Classificação IEEE 754
    if !math.isNan(math.nan()) { return 5 }
    if math.isNan(0.0) { return 6 }
    if !math.isInfinite(math.infinity()) { return 7 }
    if !math.isInfinite(math.negInfinity()) { return 8 }
    if math.isInfinite(1.0) { return 9 }
    if !math.isFinite(100.5) { return 10 }
    if math.isFinite(math.infinity()) { return 11 }
    if math.isFinite(math.nan()) { return 12 }

    // 3. abs, min, max, clamp
    if math.abs(-42.5) != 42.5 { return 13 }
    if math.abs(42.5) != 42.5 { return 14 }
    if math.min(10.0, 20.0) != 10.0 { return 15 }
    if math.max(10.0, 20.0) != 20.0 { return 16 }
    if math.clamp(5.0, 10.0, 20.0) != 10.0 { return 17 }
    if math.clamp(15.0, 10.0, 20.0) != 15.0 { return 18 }
    if math.clamp(25.0, 10.0, 20.0) != 20.0 { return 19 }

    // 4. Arredondamentos: trunc, floor, ceil, round
    if math.trunc(3.7) != 3.0 { return 20 }
    if math.trunc(-3.7) != -3.0 { return 21 }
    if math.floor(3.7) != 3.0 { return 22 }
    if math.floor(-3.2) != -4.0 { return 23 }
    if math.ceil(3.2) != 4.0 { return 24 }
    if math.ceil(-3.7) != -3.0 { return 25 }
    if math.round(3.4) != 3.0 { return 26 }
    if math.round(3.6) != 4.0 { return 27 }
    if math.round(-3.4) != -3.0 { return 28 }
    if math.round(-3.6) != -4.0 { return 29 }

    // 5. sqrt e hypot
    if math.sqrt(0.0) != 0.0 { return 30 }
    if math.sqrt(16.0) != 4.0 { return 31 }
    if math.sqrt(64.0) != 8.0 { return 32 }
    if !approxEq(math.sqrt(2.0), math.sqrt2(), 0.00000001) { return 33 }
    if !approxEq(math.hypot(3.0, 4.0), 5.0, 0.00000001) { return 34 }

    // 6. Trigonometria: sin, cos, tan
    if math.sin(0.0) != 0.0 { return 35 }
    if !approxEq(math.sin(math.fracPi2()), 1.0, 0.00000001) { return 36 }
    if !approxEq(math.sin(math.pi()), 0.0, 0.00000001) { return 37 }
    if math.cos(0.0) != 1.0 { return 38 }
    if !approxEq(math.cos(math.fracPi2()), 0.0, 0.00000001) { return 39 }
    if !approxEq(math.cos(math.pi()), -1.0, 0.00000001) { return 40 }
    if !approxEq(math.tan(0.0), 0.0, 0.00000001) { return 41 }
    if !approxEq(math.tan(math.fracPi4()), 1.0, 0.00000001) { return 42 }

    // 7. Exponencial e logaritmo
    if math.exp(0.0) != 1.0 { return 43 }
    if !approxEq(math.exp(1.0), math.e(), 0.00000001) { return 44 }
    if math.ln(1.0) != 0.0 { return 45 }
    if !approxEq(math.ln(math.e()), 1.0, 0.00000001) { return 46 }
    if !approxEq(math.log2(8.0), 3.0, 0.00000001) { return 47 }
    if !approxEq(math.log10(100.0), 2.0, 0.00000001) { return 48 }

    // 8. Potências
    if math.pow(2.0, 0.0) != 1.0 { return 49 }
    if math.pow(2.0, 10.0) != 1024.0 { return 50 }
    if math.pow(5.0, 3.0) != 125.0 { return 51 }
    if !approxEq(math.pow(16.0, 0.5), 4.0, 0.00000001) { return 52 }

    // 9. Graus e radianos
    if !approxEq(math.toDegrees(math.pi()), 180.0, 0.00000001) { return 53 }
    if !approxEq(math.toRadians(180.0), math.pi(), 0.00000001) { return 54 }

    // 10. Métodos inerentes em float
    let val: float = 25.0
    if val.sqrt() != 5.0 { return 55 }
    if (-12.5).abs() != 12.5 { return 56 }
    let rad: float = 0.0
    if rad.cos() != 1.0 { return 57 }
    if val.min(10.0) != 10.0 { return 58 }
    if val.max(50.0) != 50.0 { return 59 }
    if val.clamp(0.0, 10.0) != 10.0 { return 60 }

    return 0
}
