module examples.minimal.m10_path_empty

// Minimal 0.1 — std.path (isEmpty / isAbsolute / join / fileName).
import std.path as path

func main(): int {
    // isEmpty
    let empty = path.Path.from("")
    if !empty.isEmpty() {
        return 1
    }
    let nonEmpty = path.Path.from("x")
    if nonEmpty.isEmpty() {
        return 2
    }

    // isAbsolute
    let tmp = path.Path.from("/tmp")
    if !tmp.isAbsolute() {
        return 3
    }
    let root = path.Path.from("/")
    if !root.isAbsolute() {
        return 4
    }
    let rel = path.Path.from("rel")
    if rel.isAbsolute() {
        return 5
    }
    let dotRel = path.Path.from("./x")
    if dotRel.isAbsolute() {
        return 6
    }
    if empty.isAbsolute() {
        return 7
    }

    // joinStr
    let baseA = path.Path.from("a")
    if baseA.joinStr("b") != "a/b" {
        return 8
    }
    if tmp.joinStr("x") != "/tmp/x" {
        return 9
    }
    if tmp.joinStr("/abs") != "/abs" {
        return 10
    }

    // fileName
    let leaf = path.Path.from("leaf").fileName()
    if leaf.asStr() != "leaf" {
        return 11
    }
    let tmpLeaf = path.Path.from("/tmp/leaf").fileName()
    if tmpLeaf.asStr() != "leaf" {
        return 12
    }
    let nested = path.Path.from("/tmp/x/y").fileName()
    if nested.asStr() != "y" {
        return 13
    }

    return 0
}
