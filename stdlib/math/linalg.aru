//! Destination-passing linear algebra kernels.
//!
//! ## Overview
//!
//! These kernels write into caller-owned matrix views. The caller provides destination storage and, for matrix multiplication, any required scratch buffer.
//!
//! ## Safety
//! Destination views must have compatible shapes and must not alias inputs
//! where the kernel requires exclusive output. `gemmRequirements` exposes
//! the current scratch-space estimate before calling `gemmInto`.
//!
//! ## Allocations
//! Kernels write into caller-provided storage and do not own result buffers.
//!
//! ## Platform
//! `native` · `wasm32`

module std.math.linalg

/// Destination-Passing Style (DPS) Linear Algebra Kernels (RFC 0012).
///
/// Principles:
/// - Zero Hidden Allocation: Output matrices are pre-allocated by caller.
/// - Proven No-Aliasing: `mut ref ArrayViewMut` ensures exclusive write destination.
/// - Reusable Scratch Memory: Packing buffers and temporary workspaces use `ScratchArena`.
/// - Clean SIMD auto-vectorization bounds with explicit strided traversal.

import std.math.view as view
import std.alloc.arena as arena

/// Computes elementwise matrix addition: `out = a + b`.
///
/// Returns `false` without writing when the three shapes differ. On a match,
/// writes each destination element and returns `true`. This kernel performs
/// no heap allocation; its work is O(rows × columns).
public func addInto(
    a: ref view.ArrayView<float>,
    b: ref view.ArrayView<float>,
    out: mut ref view.ArrayViewMut<float>
): bool {
    let rCount = a.rows()
    let cCount = a.cols()
    if b.rows() != rCount || b.cols() != cCount || out.rows() != rCount || out.cols() != cCount {
        return false
    }

    let mut r: uint = 0
    while r < rCount {
        let mut c: uint = 0
        while c < cCount {
            let va = a.get(r, c)
            let vb = b.get(r, c)
            if va is Option.Some(x) && vb is Option.Some(y) {
                out.set(r, c, x + y)
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}

/// Computes elementwise matrix subtraction: `out = a - b`.
///
/// Returns `false` without writing when the three shapes differ. On a match,
/// writes each destination element and returns `true`. This kernel performs
/// no heap allocation; its work is O(rows × columns).
public func subInto(
    a: ref view.ArrayView<float>,
    b: ref view.ArrayView<float>,
    out: mut ref view.ArrayViewMut<float>
): bool {
    let rCount = a.rows()
    let cCount = a.cols()
    if b.rows() != rCount || b.cols() != cCount || out.rows() != rCount || out.cols() != cCount {
        return false
    }

    let mut r: uint = 0
    while r < rCount {
        let mut c: uint = 0
        while c < cCount {
            let va = a.get(r, c)
            let vb = b.get(r, c)
            if va is Option.Some(x) && vb is Option.Some(y) {
                out.set(r, c, x - y)
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}

/// Computes elementwise matrix scaling: `out = a * alpha`.
///
/// Returns `false` without writing when `out` has a different shape from `a`.
/// On a match, writes each destination element and returns `true`. This
/// kernel performs no heap allocation; its work is O(rows × columns).
public func scaleInto(
    a: ref view.ArrayView<float>,
    alpha: float,
    out: mut ref view.ArrayViewMut<float>
): bool {
    let rCount = a.rows()
    let cCount = a.cols()
    if out.rows() != rCount || out.cols() != cCount {
        return false
    }

    let mut r: uint = 0
    while r < rCount {
        let mut c: uint = 0
        while c < cCount {
            let va = a.get(r, c)
            if va is Option.Some(x) {
                out.set(r, c, x * alpha)
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}

/// Computes elementwise multiply then add: `out = a * b + c`.
///
/// The implementation uses ordinary multiplication and addition; it does
/// not promise a fused floating-point operation. A shape mismatch returns
/// `false` before writing. Work is O(rows × columns), with no heap allocation.
public func mulAddInto(
    a: ref view.ArrayView<float>,
    b: ref view.ArrayView<float>,
    c: ref view.ArrayView<float>,
    out: mut ref view.ArrayViewMut<float>
): bool {
    let rCount = a.rows()
    let cCount = a.cols()
    if b.rows() != rCount || b.cols() != cCount
        || c.rows() != rCount || c.cols() != cCount
        || out.rows() != rCount || out.cols() != cCount
    {
        return false
    }

    let mut r: uint = 0
    while r < rCount {
        let mut col: uint = 0
        while col < cCount {
            let va = a.get(r, col)
            let vb = b.get(r, col)
            let vc = c.get(r, col)
            if va is Option.Some(x) && vb is Option.Some(y) && vc is Option.Some(z) {
                out.set(r, col, x * y + z)
            }
            col = col + 1
        }
        r = r + 1
    }
    return true
}

/// Estimates scratch bytes for a GEMM shape `(M × K) * (K × N)`.
///
/// The current formula is `(rowsA + colsB) * 8`; `colsA` does not affect the
/// result. It is a sizing estimate, not an exact query of `float` layout or
/// of the space actually reserved by `gemmInto`.
public func gemmRequirements(rowsA: uint, colsA: uint, colsB: uint): uint {
    // Packing workspace: buffer for temporary tile packing (rowsA + colsB) * sizeof(float)
    let packFloats = rowsA + colsB
    return packFloats * 8
}

/// Computes general matrix multiplication: `out = a * b` (GEMM).
///
/// `a` has shape M × K, `b` has shape K × N, and `out` must have shape M × N.
/// A mismatch returns `false` before writing. The function reserves space
/// for N `float` elements from `scratch`; if that fails, it returns `false`.
/// The reservation is rewound before return, so earlier scratch allocations
/// remain available. The multiplication uses nested scalar loops and writes
/// every destination cell. It performs no heap allocation itself.
public func gemmInto(
    a: ref view.ArrayView<float>,
    b: ref view.ArrayView<float>,
    out: mut ref view.ArrayViewMut<float>,
    scratch: mut ref arena.ScratchArena
): bool {
    let m = a.rows()
    let kCount = a.cols()
    let n = b.cols()

    if b.rows() != kCount || out.rows() != m || out.cols() != n {
        return false
    }

    // Scoped scratch checkpoint for temporary workspace (DoD)
    let mark = scratch.checkpoint()

    // Workspace buffer for row accumulators or packing
    let optBuffer = scratch.allocTyped<float>(n)
    if optBuffer is Option.None {
        scratch.rewind(mark)
        return false
    }

    let mut i: uint = 0
    while i < m {
        let mut j: uint = 0
        while j < n {
            let mut sum: float = 0.0
            let mut k: uint = 0
            while k < kCount {
                let va = a.get(i, k)
                let vb = b.get(k, j)
                if va is Option.Some(x) && vb is Option.Some(y) {
                    sum = sum + x * y
                }
                k = k + 1
            }
            out.set(i, j, sum)
            j = j + 1
        }
        i = i + 1
    }

    // Rollback scratch workspace in O(1)
    scratch.rewind(mark)
    return true
}
