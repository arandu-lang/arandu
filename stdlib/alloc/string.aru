//! Owned, mutable UTF-8 byte storage.
//!
//! ## Overview
//!
//! `String` owns a growable byte buffer. Borrow its contents with `asStr` or `asBytes`, reserve capacity, append data, and release it with `destroy`.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.string as strings
//!
//! let mut name = strings.from("aran")
//! name.pushStr("du")
//! let bytes = name.len()
//! ```
//!
//! ## Safety
//! `adoptOwned` accepts only a buffer obtained from the compatible host
//! allocator. Borrowed views from `asStr` and `asBytes` must not outlive the
//! `String` or a reallocation that moves its buffer.
//!
//! ## Allocations
//! `new` is empty without allocating; growth may reallocate. Fallible
//! `tryReserve` and `pushStr` report failure with `false`.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.string

/// Owned, mutable UTF-8 string (`String`).
///
/// Heap-allocated buffer managed with pure allocators and mem intrinsics.

import std.core.mem as mem
import std.core.intrinsics as intrinsics
import std.core.char as chars
import std.core.str as core_str

func maxBufferCapacity(): uint {
    return 2147483647
}

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: uint): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: uint): void
    /// Host allocator that resizes a raw byte buffer.
    func ar_vec_realloc(p: ptr[u8], oldSize: uint, newSize: uint): ptr[u8]
    /// Host bridge that appends bytes to an owned string.
    func ar_string_push_str(s: mut ref String, value: str): bool
}

/// Returns a shared UTF-8 string view (`str`) borrowing the String's data.
/// The view has byte length `len` and does not copy or allocate. It becomes
/// invalid if the owner is destroyed or its buffer moves during growth.
///
/// # Examples
/// ```arandu
/// let s = strings.from("hello")
/// strings.asStr(s) // "hello"
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func asStr(s: ref String): ref str {
    unsafe {
        return intrinsics.strView<String>(s)
    }
}

/// Returns a shared byte slice `[]u8` viewing the underlying UTF-8 storage.
/// The slice covers initialized bytes only; its length is `String.len`.
/// Destroying or reallocating the String invalidates the borrowed view.
///
/// # Examples
/// ```arandu
/// let s = strings.from("abc")
/// let bytes = strings.asBytes(s)
/// slice.len<u8>(bytes) // 3
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func asBytes(s: ref String): []u8 {
    unsafe {
        return intrinsics.sliceFromRaw<String, u8>(s, s.data, s.len)
    }
}

/// Appends the bytes of `value` and returns whether the append succeeded.
///
/// Growth may reallocate and invalidate borrowed views. A `false` return
/// reports allocation failure; callers must check it before assuming the
/// complete value was appended.
///
/// # Examples
/// ```arandu
/// let mut s = strings.new()
/// strings.pushStr(s, "arandu")
/// s.len() // 6
/// ```
///
/// # Complexity
/// Time: O(m) where m is length of `value` | Space: O(m)
public func pushStr(s: mut ref String, value: str): bool {
    unsafe {
        return ar_string_push_str(s, value)
    }
}

/// Owned UTF-8 string buffer.
public struct String {
    /// Pointer to the owned byte buffer.
    data: ptr[u8]
    /// Number of initialized UTF-8 bytes.
    len: uint
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: uint
}

/// Adopts an `ar_vec_malloc` buffer as an owned `String` without copying.
///
/// `bufCap` is the allocated capacity, `bufLen` the valid bytes
/// (`len == bufCap` for exact-size buffers, e.g. a whole-file read).
///
/// # Safety
/// `data` must be a pointer returned by `ar_vec_malloc(bufCap)` (or `nil` with
/// `0`/`0`). `bufLen` must not exceed `bufCap`, and the initialized bytes must
/// be valid UTF-8 before treating the result as text. The buffer is freed
/// exactly once via `destroy`/`ar_vec_buf_free`.
public func adoptOwned(data: ptr[u8], bufCap: uint, bufLen: uint): String {
    return String {
        data: data,
        len: bufLen,
        capacity: bufCap,
    }
}

/// Creates a new empty `String` without heap allocation.
///
/// # Examples
/// ```arandu
/// let s = strings.new()
/// strings.len(s) // 0
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func new(): String {
    return String {
        data: nil,
        len: 0,
        capacity: 0,
    }
}

/// Creates a new empty `String` with preallocated byte capacity.
///
/// # Examples
/// ```arandu
/// let s = strings.withCapacity(32)
/// strings.capacity(s) // >= 32
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(cap)
public func withCapacity(cap: uint): String {
    let mut s = new()
    ensureCapacity(s, cap)
    return s
}

/// Creates a new owned `String` initialized with a copy of `value`.
/// The source remains independent of the new buffer. Allocation failure
/// aborts; use `new` followed by fallible `pushStr` to handle failure.
///
/// # Examples
/// ```arandu
/// let s = strings.from("arandu")
/// strings.len(s) // 6
/// ```
///
/// # Complexity
/// Time: O(n) | Space: O(n) where n is length of `value`
public func from(value: str): String {
    let mut s = new()
    if !pushStr(s, value) {
        unsafe {
            intrinsics.abort()
        }
    }
    return s
}

/// Attempts to ensure capacity in bytes ≥ `minCap`.
///
/// Returns `true` on success, or `false` on OOM or capacity overflow without
/// modifying `s`. The maximum accepted capacity is 2,147,483,647 bytes.
/// Existing borrowed views remain valid only if no reallocation occurs.
public func tryEnsureCapacity(s: mut ref String, minCap: uint): bool {
    let maxCap = maxBufferCapacity()
    if minCap > maxCap {
        return false
    }
    if s.capacity >= minCap {
        return true
    }
    let mut newCap: uint = s.capacity
    if newCap == 0 {
        newCap = 8
    }
    while newCap < minCap {
        if newCap > maxCap / 2 {
            newCap = maxCap
        } else {
            newCap = newCap * 2
        }
    }
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_realloc(s.data, s.capacity, newCap)
        if p == nullp {
            return false
        }
        s.data = p
        s.capacity = newCap
    }
    return true
}

/// Ensure capacity in bytes ≥ `minCap`. Aborts if reallocation fails.
func ensureCapacity(s: mut ref String, minCap: uint): void {
    if !tryEnsureCapacity(s, minCap) {
        unsafe {
            intrinsics.abort()
        }
    }
}

/// Fallible byte capacity reservation.
///
/// Reserves capacity for at least `additional` more bytes beyond current `len`.
/// Returns `true` on success, or `false` on allocation failure or capacity
/// overflow without aborting. Existing content remains intact on failure.
public func tryReserve(s: mut ref String, additional: uint): bool {
    let maxCap = maxBufferCapacity()
    if additional > maxCap - s.len {
        return false
    }
    let need = s.len + additional
    return tryEnsureCapacity(s, need)
}

/// Returns the byte length of the String.
///
/// # Examples
/// ```arandu
/// let s = strings.from("arandu")
/// strings.len(s) // 6
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func len(s: ref String): uint {
    return s.len
}

/// Returns the total byte capacity allocated for the String.
///
/// # Examples
/// ```arandu
/// let s = strings.withCapacity(64)
/// strings.capacity(s) // >= 64
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func capacity(s: ref String): uint {
    return s.capacity
}

/// Returns `true` if the String contains no bytes (`len == 0`).
///
/// # Examples
/// ```arandu
/// strings.isEmpty(strings.new())          // true
/// strings.isEmpty(strings.from("text"))   // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isEmpty(s: ref String): bool {
    return s.len == 0
}

/// Reserves capacity for at least `additional` more bytes beyond `len`.
///
/// # Examples
/// ```arandu
/// let mut s = strings.new()
/// strings.reserve(s, 16)
/// strings.capacity(s) // >= 16
/// ```
///
/// # Complexity
/// Time: O(n) reallocation | Space: O(capacity)
public func reserve(s: mut ref String, additional: uint): void {
    if !tryReserve(s, additional) {
        unsafe {
            intrinsics.abort()
        }
    }
}

/// Appends a single Unicode scalar value (`char`) encoded as UTF-8 bytes (1 to 4 bytes).
/// Growth may reallocate and invalidate views returned by `asStr` or
/// `asBytes`. Capacity overflow or allocation failure aborts.
///
/// # Examples
/// ```arandu
/// let mut s = strings.new()
/// strings.pushScalar(s, 'a')
/// strings.pushScalar(s, 'é')
/// strings.len(s) // 3 bytes ('a'=1, 'é'=2)
/// ```
///
/// # Complexity
/// Time: Amortized O(1) | Space: O(1)
public func pushScalar(s: mut ref String, c: char): void {
    let clen = chars.lenUtf8(c) as uint
    if clen > maxBufferCapacity() - s.len {
        unsafe {
            intrinsics.abort()
        }
    }
    let need = s.len + clen
    if s.capacity < need {
        ensureCapacity(s, need)
    }
    let val = c as u32
    unsafe {
        if clen == 1 {
            let p = mem.ptrOffset<u8>(s.data, s.len as i32)
            mem.ptrWrite<u8>(p, val as u8)
        } else if clen == 2 {
            let b0 = (192 as u32 | (val >> 6)) as u8
            let b1 = (128 as u32 | (val & 63 as u32)) as u8
            let p0 = mem.ptrOffset<u8>(s.data, s.len as i32)
            let p1 = mem.ptrOffset<u8>(s.data, (s.len + 1) as i32)
            mem.ptrWrite<u8>(p0, b0)
            mem.ptrWrite<u8>(p1, b1)
        } else if clen == 3 {
            let b0 = (224 as u32 | (val >> 12)) as u8
            let b1 = (128 as u32 | ((val >> 6) & 63 as u32)) as u8
            let b2 = (128 as u32 | (val & 63 as u32)) as u8
            let p0 = mem.ptrOffset<u8>(s.data, s.len as i32)
            let p1 = mem.ptrOffset<u8>(s.data, (s.len + 1) as i32)
            let p2 = mem.ptrOffset<u8>(s.data, (s.len + 2) as i32)
            mem.ptrWrite<u8>(p0, b0)
            mem.ptrWrite<u8>(p1, b1)
            mem.ptrWrite<u8>(p2, b2)
        } else {
            let b0 = (240 as u32 | (val >> 18)) as u8
            let b1 = (128 as u32 | ((val >> 12) & 63 as u32)) as u8
            let b2 = (128 as u32 | ((val >> 6) & 63 as u32)) as u8
            let b3 = (128 as u32 | (val & 63 as u32)) as u8
            let p0 = mem.ptrOffset<u8>(s.data, s.len as i32)
            let p1 = mem.ptrOffset<u8>(s.data, (s.len + 1) as i32)
            let p2 = mem.ptrOffset<u8>(s.data, (s.len + 2) as i32)
            let p3 = mem.ptrOffset<u8>(s.data, (s.len + 3) as i32)
            mem.ptrWrite<u8>(p0, b0)
            mem.ptrWrite<u8>(p1, b1)
            mem.ptrWrite<u8>(p2, b2)
            mem.ptrWrite<u8>(p3, b3)
        }
    }
    s.len = s.len + clen
}

/// Clears the String by setting its byte length to zero, retaining capacity.
///
/// No bytes are deallocated or overwritten. Existing borrowed views must
/// not be used as views of the cleared content.
///
/// # Examples
/// ```arandu
/// let mut s = strings.from("hello")
/// strings.clear(s)
/// strings.len(s) // 0
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func clear(s: mut ref String): void {
    s.len = 0
}

/// Deallocates the heap buffer and resets the String to empty.
///
/// All views into the buffer become invalid. Repeating this operation on an
/// already empty, unallocated String has no effect.
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func destroy(s: mut ref String): void {
    if s.capacity > 0 {
        unsafe {
            ar_vec_buf_free(s.data, s.capacity)
        }
        s.data = nil
        s.capacity = 0
        s.len = 0
    }
}

// ── Method-style surface ───────────────────────────────────────────────────

/// Copies `value` into a new owned `String`.
///
/// Allocation failure aborts, as with the free `from` constructor.
public func String.from(value: str): String {
    return from(value)
}

/// Returns the byte length of the String.
public func String.len(self: ref String): uint {
    return len(self)
}

/// Returns the allocated byte capacity.
public func String.capacity(self: ref String): uint {
    return capacity(self)
}

/// Returns `true` if the String is empty.
public func String.isEmpty(self: ref String): bool {
    return isEmpty(self)
}

/// Ensures room for `additional` bytes beyond the current length.
///
/// Reallocation may invalidate borrowed views; allocation failure aborts.
public func String.reserve(self: mut ref String, additional: uint): void {
    reserve(self, additional)
}

/// Encodes `c` as one to four UTF-8 bytes and appends it.
///
/// Growth may reallocate; allocation failure aborts.
public func String.pushScalar(self: mut ref String, c: char): void {
    pushScalar(self, c)
}

/// Borrows the initialized bytes as a `str` view without copying.
///
/// Destroying or reallocating the owner invalidates the view.
public func String.asStr(self: ref String): ref str {
    return asStr(self)
}

/// Borrows initialized bytes as a slice without copying.
///
/// Destroying or reallocating the owner invalidates the view.
public func String.asBytes(self: ref String): []u8 {
    return asBytes(self)
}

/// Appends all bytes of `value` and returns whether it succeeded.
///
/// A `false` result reports allocation failure. Successful growth may
/// reallocate and invalidate borrowed views.
public func String.pushStr(self: mut ref String, value: str): bool {
    return pushStr(self, value)
}

/// Attempts to reserve room for `additional` bytes beyond the length.
///
/// Returns `false` on allocation failure or capacity overflow, preserving
/// existing content.
public func String.tryReserve(self: mut ref String, additional: uint): bool {
    return tryReserve(self, additional)
}

/// Sets byte length to zero while retaining the allocated buffer.
///
/// No allocation or byte overwrite occurs.
public func String.clear(self: mut ref String): void {
    clear(self)
}

/// Shortens the String to `newLen` bytes when that is a UTF-8 boundary.
///
/// A length beyond the current end or inside a multibyte character leaves
/// the String unchanged. Capacity is retained; no allocation occurs.
public func truncate(s: mut ref String, newLen: uint): void {
    if newLen < s.len {
        if newLen > 0 {
            let boundary = unsafe {
                let p = mem.ptrOffset<u8>(s.data, newLen as i32)
                mem.ptrRead<u8>(p)
            }
            if (boundary & (192 as u8)) == (128 as u8) {
                return
            }
        }
        s.len = newLen
    }
}

/// Shortens this String at a UTF-8 boundary; delegates to `truncate`.
///
/// Invalid or out-of-range byte lengths leave the String unchanged.
public func String.truncate(self: mut ref String, newLen: uint): void {
    truncate(self, newLen)
}

/// Compares initialized bytes with `prefix` without allocation.
///
/// An empty prefix matches every string.
public func String.startsWith(self: ref String, prefix: str): bool {
    return core_str.startsWith(*asStr(self), prefix)
}

/// Compares the end of the initialized bytes with `suffix`.
///
/// An empty suffix matches every string; no allocation occurs.
public func String.endsWith(self: ref String, suffix: str): bool {
    return core_str.endsWith(*asStr(self), suffix)
}

/// Searches for `needle` in the initialized bytes without allocation.
///
/// An empty needle matches at the beginning.
public func String.contains(self: ref String, needle: str): bool {
    return core_str.contains(*asStr(self), needle)
}

/// Returns the first byte offset of `needle`, or `None` if absent.
///
/// An empty needle yields `Some(0)`; offsets count UTF-8 bytes.
public func String.find(self: ref String, needle: str): Option<uint> {
    return core_str.find(*asStr(self), needle)
}

/// Copies this String into a separate owned buffer.
///
/// The clone can be changed or destroyed independently. Allocation failure
/// aborts through `from`.
public func String.clone(self: ref String): String {
    return from(*asStr(self))
}

/// Consumes this String and releases its owned byte buffer.
///
/// Borrowed views into the buffer become invalid.
@Destructor
public func String.destroy(self: own String): void {
    destroy(self)
}
