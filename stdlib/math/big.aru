//! Arbitrary-precision integer and decimal arithmetic (RFC 0037 Layer 3).
//!
//! ## Overview
//!
//! `std.math.big` is an initial dynamic-precision implementation:
//! - `BigInt`: Signed integer backed by a dynamic vector of 64-bit limbs.
//!   Can represent numbers with hundreds or thousands of digits for cryptography,
//!   number theory, and exact combinatorial counting.
//! - `BigDecimal`: Arbitrary-precision decimal represented by an unscaled `BigInt`
//!   mantissa and an `i64` scale.
//!
//! ## Algorithms
//!
//! - Addition / Subtraction: Linear $O(N)$ with ripple-carry.
//! - Multiplication: Schoolbook limb arithmetic; Karatsuba is not implemented.
//! - Comparisons can traverse limbs and are not constant-time.
//! Allocation, scale/work limits and wide independent oracles remain pending.
//! This module does not establish cryptographic suitability.
//!
//! ## Examples
//!
//! ```arandu
//! import std.math.big as big
//!
//! let a = big.BigInt.fromInt(1000000)
//! let b = big.BigInt.fromInt(2000000)
//! let c = a.add(b)
//! ```
//!
//! ## Platform
//! `native` · `wasm32`
module std.math.big

import std.alloc.vec as vec
import std.core.option as option
import std.core.slice as slice
import std.core.cmp as cmp
import std.core.intrinsics as intrinsics

/// An arbitrary-precision signed integer.
public struct BigInt {
    is_neg: bool,
    limbs: vec.Vec<u64>,
}

/// Zero constant.
public func BigInt.zero(): BigInt {
    return BigInt {
        is_neg: false,
        limbs: vec.Vec<u64>.new(),
    }
}

/// One constant.
public func BigInt.one(): BigInt {
    let mut v = vec.Vec<u64>.new()
    v.push(1 as u64)
    return BigInt {
        is_neg: false,
        limbs: v,
    }
}

/// Creates a `BigInt` from a standard 32-bit signed integer.
public func BigInt.fromInt(val: int): BigInt {
    if val == 0 {
        return BigInt.zero()
    }
    let mut v = vec.Vec<u64>.new()
    if val < 0 {
        let mag = (-(val + 1) as uint) + 1 as uint
        v.push(mag as u64)
        return BigInt { is_neg: true, limbs: v }
    }
    v.push(val as u64)
    return BigInt { is_neg: false, limbs: v }
}

/// Creates a `BigInt` from a 64-bit signed integer.
public func BigInt.fromI64(val: i64): BigInt {
    if val == 0 as i64 {
        return BigInt.zero()
    }
    let mut v = vec.Vec<u64>.new()
    if val < 0 as i64 {
        let mag = (-(val + 1 as i64) as u64) + 1 as u64
        v.push(mag)
        return BigInt { is_neg: true, limbs: v }
    }
    v.push(val as u64)
    return BigInt { is_neg: false, limbs: v }
}

/// Creates a `BigInt` from an unsigned 64-bit integer.
public func BigInt.fromU64(val: u64): BigInt {
    if val == 0 as u64 {
        return BigInt.zero()
    }
    let mut v = vec.Vec<u64>.new()
    v.push(val)
    return BigInt { is_neg: false, limbs: v }
}

/// Appends a 64-bit limb to the most significant position.
public func BigInt.pushLimb(self: mut ref BigInt, limb: u64): void {
    self.limbs.push(limb)
}

/// Trims leading zero limbs and normalizes zero.
public func BigInt.trim(self: mut ref BigInt): void {
    let mut i = self.limbs.len()
    while i > (0 as usize) {
        let idx = i - (1 as usize)
        if let Option.Some(word) = self.limbs.get(idx) {
            if *word != 0 as u64 { break }
        }
        let _ = self.limbs.pop()
        i = idx
    }
    if self.limbs.len() == (0 as usize) {
        self.is_neg = false
    }
}

/// Returns the number of 64-bit limbs currently used.
public func BigInt.limbCount(self: ref BigInt): usize {
    return self.limbs.len()
}

/// Returns the 64-bit limb at `index` (little-endian: 0 is least significant).
public func BigInt.getLimb(self: ref BigInt, index: usize): u64 {
    match self.limbs.get(index) {
        Option.Some(w) => { return *w }
        Option.None => { return 0 as u64 }
    }
}


/// Returns `true` if this number is zero.
public func BigInt.isZero(self: ref BigInt): bool {
    let count = self.limbs.len()
    if count == (0 as usize) { return true }
    let mut i = 0 as usize
    while i < count {
        if let Option.Some(word) = self.limbs.get(i) {
            if *word != 0 as u64 { return false }
        }
        i = i + (1 as usize)
    }
    return true
}

/// Returns `true` if this number is negative.
public func BigInt.isNegative(self: ref BigInt): bool {
    return self.is_neg
}

/// Negates this `BigInt` in-place.
public func BigInt.negate(self: mut ref BigInt): void {
    if !self.isZero() {
        self.is_neg = !self.is_neg
    }
}

/// Returns a clone of this `BigInt`.
public func BigInt.clone(self: ref BigInt): BigInt {
    let mut limbs = vec.Vec<u64>.withCapacity(self.limbs.len())
    let s = self.limbs.asSlice()
    let mut i: usize = 0
    while i < slice.len(s) {
        limbs.push(s[i])
        i = i + (1 as usize)
    }
    return BigInt {
        is_neg: self.is_neg,
        limbs: limbs,
    }
}

/// Compares two `BigInt`s taking signs into account.
public func BigInt.cmp(self: ref BigInt, other: ref BigInt): cmp.Ordering {
    if self.isZero() && other.isZero() {
        return cmp.Ordering.Equal
    }
    if self.is_neg && !other.is_neg { return cmp.Ordering.Less }
    if !self.is_neg && other.is_neg { return cmp.Ordering.Greater }

    let ord = cmpMagnitude(self, other)
    if self.is_neg {
        match ord {
            Less => { return cmp.Ordering.Greater }
            Greater => { return cmp.Ordering.Less }
            Equal => { return cmp.Ordering.Equal }
        }
    }
    return ord
}

/// Compares magnitudes of two `BigInt`s (ignoring signs).
func cmpMagnitude(a: ref BigInt, b: ref BigInt): cmp.Ordering {
    let la = a.limbs.len()
    let lb = b.limbs.len()
    if la < lb { return cmp.Ordering.Less }
    if la > lb { return cmp.Ordering.Greater }
    let aSlice = a.limbs.asSlice()
    let bSlice = b.limbs.asSlice()
    let mut i = la
    while i > (0 as usize) {
        let idx = i - (1 as usize)
        let wa = aSlice[idx]
        let wb = bSlice[idx]
        if wa < wb { return cmp.Ordering.Less }
        if wa > wb { return cmp.Ordering.Greater }
        i = idx
    }
    return cmp.Ordering.Equal
}

/// Adds two unsigned limb vectors: a + b.
func addLimbs(a: ref BigInt, b: ref BigInt): BigInt {
    let la = a.limbs.len()
    let lb = b.limbs.len()
    let maxLen = if la > lb { la } else { lb }
    let mut resultLimbs = vec.Vec<u64>.withCapacity(maxLen + (1 as usize))

    let aSlice = a.limbs.asSlice()
    let bSlice = b.limbs.asSlice()
    let mut carry = 0 as u64
    let mut i = 0 as usize
    while i < maxLen || carry > 0 as u64 {
        let wa = if i < la { aSlice[i] } else { 0 as u64 }
        let wb = if i < lb { bSlice[i] } else { 0 as u64 }
        let sum1 = wa + wb
        let carry1 = if sum1 < wa { 1 as u64 } else { 0 as u64 }
        let sum2 = sum1 + carry
        let carry2 = if sum2 < sum1 { 1 as u64 } else { 0 as u64 }
        carry = carry1 + carry2
        resultLimbs.push(sum2)
        i = i + (1 as usize)
    }

    let mut res = BigInt { is_neg: false, limbs: resultLimbs }
    res.trim()
    return res
}

/// Subtracts unsigned limb vectors (assumes a >= b): a - b.
func subLimbs(a: ref BigInt, b: ref BigInt): BigInt {
    let la = a.limbs.len()
    let lb = b.limbs.len()
    let mut resultLimbs = vec.Vec<u64>.withCapacity(la)
    let aSlice = a.limbs.asSlice()
    let bSlice = b.limbs.asSlice()

    let mut borrow = 0 as u64
    let mut i = 0 as usize
    while i < la {
        let wa = aSlice[i]
        let wb = if i < lb { bSlice[i] } else { 0 as u64 }
        let diff1 = wa - borrow
        let borrow1 = if wa < borrow { 1 as u64 } else { 0 as u64 }
        let diff2 = diff1 - wb
        let borrow2 = if diff1 < wb { 1 as u64 } else { 0 as u64 }
        borrow = borrow1 + borrow2
        resultLimbs.push(diff2)
        i = i + (1 as usize)
    }

    let mut res = BigInt { is_neg: false, limbs: resultLimbs }
    res.trim()
    return res
}

/// Adds two `BigInt`s.
public func BigInt.add(self: ref BigInt, other: ref BigInt): BigInt {
    if self.is_neg == other.is_neg {
        let mut sum = addLimbs(self, other)
        sum.is_neg = self.is_neg
        return sum
    }
    // Signs differ: subtraction of magnitudes
    let ord = cmpMagnitude(self, other)
    match ord {
        Equal => {
            return BigInt.zero()
        }
        Greater => {
            let mut diff = subLimbs(self, other)
            diff.is_neg = self.is_neg
            return diff
        }
        Less => {
            let mut diff = subLimbs(other, self)
            diff.is_neg = other.is_neg
            return diff
        }
    }
}

/// Subtracts `other` from `self`.
public func BigInt.sub(self: ref BigInt, other: ref BigInt): BigInt {
    if self.is_neg != other.is_neg {
        // Signs differ: magnitude addition keeps this sign.
        let mut sum = addLimbs(self, other)
        sum.is_neg = self.is_neg
        return sum
    }
    match cmpMagnitude(self, other) {
        Equal => {
            return BigInt.zero()
        }
        Greater => {
            let mut diff = subLimbs(self, other)
            diff.is_neg = self.is_neg
            return diff
        }
        Less => {
            let mut diff = subLimbs(other, self)
            diff.is_neg = !self.is_neg
            return diff
        }
    }
}

/// Multiplies two `BigInt`s.
public func BigInt.mul(self: ref BigInt, other: ref BigInt): BigInt {
    if self.isZero() || other.isZero() {
        return BigInt.zero()
    }
    let la = self.limbs.len()
    let lb = other.limbs.len()
    let mut resultLimbs = vec.Vec<u64>.withCapacity(la + lb)

    // Pre-fill with zero
    let mut k = 0 as usize
    while k < (la + lb) {
        resultLimbs.push(0 as u64)
        k = k + (1 as usize)
    }

    let aSlice = self.limbs.asSlice()
    let bSlice = other.limbs.asSlice()

    let mut i = 0 as usize
    while i < la {
        let wa = aSlice[i]
        let mut carry = 0 as u64
        let mut j = 0 as usize
        while j < lb || carry > 0 as u64 {
            let wb = if j < lb { bSlice[j] } else { 0 as u64 }
            let idx = i + j
            let current = match resultLimbs.get(idx) {
                Option.Some(w) => *w
                Option.None => 0 as u64
            }

            // 64x64 -> 128 bit multiplication decomposed into 32-bit halves
            let a_lo = (wa & 0xFFFFFFFF as u64)
            let a_hi = (wa >> (32 as u64))
            let b_lo = (wb & 0xFFFFFFFF as u64)
            let b_hi = (wb >> (32 as u64))

            let p0 = a_lo * b_lo
            let p1 = a_lo * b_hi
            let p2 = a_hi * b_lo
            let p3 = a_hi * b_hi

            let cy0 = (p0 >> (32 as u64)) + (p1 & 0xFFFFFFFF as u64) + (p2 & 0xFFFFFFFF as u64)
            let lo = (p0 & 0xFFFFFFFF as u64) | (cy0 << (32 as u64))
            let hi = p3 + (p1 >> (32 as u64)) + (p2 >> (32 as u64)) + (cy0 >> (32 as u64))

            let sum1 = current + lo
            let c1 = if sum1 < current { 1 as u64 } else { 0 as u64 }
            let sum2 = sum1 + carry
            let c2 = if sum2 < sum1 { 1 as u64 } else { 0 as u64 }
            carry = hi + c1 + c2

            resultLimbs.set(idx, sum2)
            j = j + (1 as usize)
        }
        i = i + (1 as usize)
    }

    let mut res = BigInt {
        is_neg: self.is_neg != other.is_neg,
        limbs: resultLimbs,
    }
    res.trim()
    return res
}

/// Adds `other` into `self` in-place.
public func BigInt.addAssign(self: mut ref BigInt, other: ref BigInt): void {
    let sum = self.add(other)
    self.is_neg = sum.is_neg
    self.limbs = sum.limbs
}

/// Subtracts `other` from `self` in-place.
public func BigInt.subAssign(self: mut ref BigInt, other: ref BigInt): void {
    let diff = self.sub(other)
    self.is_neg = diff.is_neg
    self.limbs = diff.limbs
}

/// Multiplies `self` by `other` in-place.
public func BigInt.mulAssign(self: mut ref BigInt, other: ref BigInt): void {
    let prod = self.mul(other)
    self.is_neg = prod.is_neg
    self.limbs = prod.limbs
}

func bitsInU64(val: u64): usize {
    let mut bits: usize = 0
    let mut v = val
    while v > (0 as u64) {
        bits = bits + (1 as usize)
        v = v >> (1 as u64)
    }
    return bits
}

/// Returns the number of bits in the magnitude of this `BigInt`.
public func BigInt.bitLength(self: ref BigInt): usize {
    let count = self.limbs.len()
    if count == (0 as usize) { return 0 as usize }
    let topLimb = match self.limbs.get(count - (1 as usize)) {
        Option.Some(w) => *w
        Option.None => 0 as u64
    }
    if topLimb == (0 as u64) { return 0 as usize }
    return (count - (1 as usize)) * (64 as usize) + bitsInU64(topLimb)
}

/// Returns `true` if the bit at `bitIndex` is 1 (0 is least significant bit).
public func BigInt.testBit(self: ref BigInt, bitIndex: usize): bool {
    let limbIndex = bitIndex / (64 as usize)
    if limbIndex >= self.limbs.len() { return false }
    let bitInLimb = (bitIndex % (64 as usize)) as u64
    let word = match self.limbs.get(limbIndex) {
        Option.Some(w) => *w
        Option.None => 0 as u64
    }
    return ((word >> bitInLimb) & (1 as u64)) != (0 as u64)
}

/// Shifts the magnitude left by 1 bit in-place.
func BigInt.shl1(self: mut ref BigInt): void {
    if self.isZero() { return }
    let count = self.limbs.len()
    let mut carry = 0 as u64
    let mut i = 0 as usize
    while i < count {
        let current = match self.limbs.get(i) {
            Option.Some(w) => *w
            Option.None => 0 as u64
        }
        let nextCarry = current >> (63 as u64)
        let shifted = (current << (1 as u64)) | carry
        self.limbs.set(i, shifted)
        carry = nextCarry
        i = i + (1 as usize)
    }
    if carry > (0 as u64) {
        self.limbs.push(carry)
    }
}

/// Sets bit 0 of the magnitude to 1.
func BigInt.setBit0(self: mut ref BigInt): void {
    if self.limbs.len() == (0 as usize) {
        self.limbs.push(1 as u64)
        return
    }
    let current = match self.limbs.get(0 as usize) {
        Option.Some(w) => *w
        Option.None => 0 as u64
    }
    let _ = self.limbs.set(0 as usize, current | (1 as u64))
}

/// Sets the bit at `bitIndex` of the magnitude to 1.
func BigInt.setBit(self: mut ref BigInt, bitIndex: usize): void {
    let limbIndex = bitIndex / (64 as usize)
    let bitInLimb = (bitIndex % (64 as usize)) as u64
    while self.limbs.len() <= limbIndex {
        self.limbs.push(0 as u64)
    }
    let current = match self.limbs.get(limbIndex) {
        Option.Some(w) => *w
        Option.None => 0 as u64
    }
    let _ = self.limbs.set(limbIndex, current | ((1 as u64) << bitInLimb))
}

/// The quotient and remainder resulting from integer division.
public struct BigIntDivResult {
    public quotient: BigInt,
    public remainder: BigInt,
}

/// Computes unsigned magnitude division: a / b and a % b.
func divRemMagnitude(a: ref BigInt, b: ref BigInt): BigIntDivResult {
    let cmpOrd = cmpMagnitude(a, b)
    match cmpOrd {
        Less => {
            return BigIntDivResult {
                quotient: BigInt.zero(),
                remainder: a.clone(),
            }
        }
        Equal => {
            return BigIntDivResult {
                quotient: BigInt.one(),
                remainder: BigInt.zero(),
            }
        }
        Greater => {}
    }

    let mut rem = BigInt.zero()
    let mut quot = BigInt.zero()
    let totalBits = a.bitLength()
    let mut bit = totalBits
    while bit > (0 as usize) {
        let bitIdx = bit - (1 as usize)
        rem.shl1()
        if a.testBit(bitIdx) {
            rem.setBit0()
        }
        match cmpMagnitude(ref rem, b) {
            Less => {}
            _ => {
                rem = subLimbs(ref rem, b)
                quot.setBit(bitIdx)
            }
        }
        bit = bitIdx
    }
    rem.trim()
    quot.trim()
    return BigIntDivResult {
        quotient: quot,
        remainder: rem,
    }
}

/// Divides `self` by `other`, returning both quotient and remainder.
/// Aborts if `other` is zero.
public func BigInt.divRem(self: ref BigInt, other: ref BigInt): BigIntDivResult {
    if other.isZero() {
        unsafe { intrinsics.abort() }
    }
    if self.isZero() {
        return BigIntDivResult {
            quotient: BigInt.zero(),
            remainder: BigInt.zero(),
        }
    }
    let mut res = divRemMagnitude(self, other)
    if !res.quotient.isZero() {
        res.quotient.is_neg = self.is_neg != other.is_neg
    }
    if !res.remainder.isZero() {
        res.remainder.is_neg = self.is_neg
    }
    return res
}

/// Integer division: returns the quotient of `self` divided by `other`.
public func BigInt.div(self: ref BigInt, other: ref BigInt): BigInt {
    let res = self.divRem(other)
    return res.quotient.clone()
}

/// Integer remainder: returns `self % other`.
public func BigInt.rem(self: ref BigInt, other: ref BigInt): BigInt {
    let res = self.divRem(other)
    return res.remainder.clone()
}

/// Divides `self` by `other` in-place.
public func BigInt.divAssign(self: mut ref BigInt, other: ref BigInt): void {
    let q = self.div(other)
    self.is_neg = q.is_neg
    self.limbs = q.limbs
}

/// Replaces `self` with `self % other` in-place.
public func BigInt.remAssign(self: mut ref BigInt, other: ref BigInt): void {
    let r = self.rem(other)
    self.is_neg = r.is_neg
    self.limbs = r.limbs
}


// ── BigDecimal (RFC 0037 Layer 3) ───────────────────────────────────────────

/// An arbitrary-precision decimal number with dynamic limb storage.
public struct BigDecimal {
    mantissa: BigInt,
    scale: i64,
}

/// Creates a `BigDecimal` with the given mantissa and decimal scale.
public func BigDecimal.new(mantissa: BigInt, scale: i64): BigDecimal {
    return BigDecimal {
        mantissa: mantissa,
        scale: scale,
    }
}

/// Returns the unscaled integer mantissa.
public func BigDecimal.mantissa(self: ref BigDecimal): ref BigInt {
    return ref self.mantissa
}

/// Returns the decimal scale.
public func BigDecimal.scale(self: ref BigDecimal): i64 {
    return self.scale
}

/// Zero constant.
public func BigDecimal.zero(): BigDecimal {
    return BigDecimal.new(BigInt.zero(), 0 as i64)
}

/// Returns `true` if this decimal is negative.
public func BigDecimal.isNegative(self: ref BigDecimal): bool {
    return self.mantissa.isNegative()
}

/// Returns a clone of this `BigDecimal`.
public func BigDecimal.clone(self: ref BigDecimal): BigDecimal {
    return BigDecimal.new(self.mantissa.clone(), self.scale)
}

/// Adds two decimals with automatic decimal scale alignment.
public func BigDecimal.add(self: ref BigDecimal, other: ref BigDecimal): BigDecimal {
    if self.scale == other.scale {
        return BigDecimal.new(self.mantissa.add(ref other.mantissa), self.scale)
    }
    if self.scale > other.scale {
        let diff = (self.scale - other.scale) as u32
        let mut scaledOther = other.mantissa.clone()
        let mut step: u32 = 0 as u32
        let ten = BigInt.fromInt(10)
        while step < diff {
            scaledOther = scaledOther.mul(ref ten)
            step = step + 1 as u32
        }
        return BigDecimal.new(self.mantissa.add(ref scaledOther), self.scale)
    } else {
        let diff = (other.scale - self.scale) as u32
        let mut scaledSelf = self.mantissa.clone()
        let mut step: u32 = 0 as u32
        let ten = BigInt.fromInt(10)
        while step < diff {
            scaledSelf = scaledSelf.mul(ref ten)
            step = step + 1 as u32
        }
        return BigDecimal.new(scaledSelf.add(ref other.mantissa), other.scale)
    }
}

/// Subtracts `other` from `self` with automatic decimal scale alignment.
public func BigDecimal.sub(self: ref BigDecimal, other: ref BigDecimal): BigDecimal {
    let mut negOther = other.clone()
    negOther.mantissa.is_neg = !negOther.mantissa.is_neg
    return self.add(ref negOther)
}

/// Negates this `BigDecimal` in-place.
public func BigDecimal.negate(self: mut ref BigDecimal): void {
    self.mantissa.negate()
}

/// Adds `other` into `self` in-place with automatic scale alignment.
public func BigDecimal.addAssign(self: mut ref BigDecimal, other: ref BigDecimal): void {
    let sum = self.add(other)
    self.scale = sum.scale
    self.mantissa = sum.mantissa
}

/// Subtracts `other` from `self` in-place with automatic scale alignment.
public func BigDecimal.subAssign(self: mut ref BigDecimal, other: ref BigDecimal): void {
    let diff = self.sub(other)
    self.scale = diff.scale
    self.mantissa = diff.mantissa
}

/// Multiplies two decimals.
public func BigDecimal.mul(self: ref BigDecimal, other: ref BigDecimal): BigDecimal {
    let prod = self.mantissa.mul(ref other.mantissa)
    return BigDecimal.new(prod, self.scale + other.scale)
}

/// Multiplies `self` by `other` in-place.
public func BigDecimal.mulAssign(self: mut ref BigDecimal, other: ref BigDecimal): void {
    let prod = self.mul(other)
    self.scale = prod.scale
    self.mantissa = prod.mantissa
}
