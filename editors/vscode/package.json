{
    "name": "arandu-lang",
    "displayName": "Arandu Language Support",
    "description": "VS Code support for the Arandu Programming Language",
    "version": "0.1.0",
    "publisher": "arandu",
    "license": "MIT",
    "preview": true,
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#071638",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/arandu-lang/arandu.git"
    },
    "homepage": "https://github.com/arandu-lang/arandu#readme",
    "bugs": {
        "url": "https://github.com/arandu-lang/arandu/issues"
    },
    "keywords": [
        "arandu",
        "language-server",
        "lsp",
        "compiler"
    ],
    "engines": {
        "vscode": "^1.92.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:arandu"
    ],
    "contributes": {
        "languages": [
            {
                "id": "arandu",
                "aliases": [
                    "Arandu",
                    "arandu"
                ],
                "extensions": [
                    ".aru"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./images/icon.png",
                    "dark": "./images/icon.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "arandu",
                "path": "./syntaxes/arandu.tmLanguage.json",
                "scopeName": "source.arandu"
            }
        ],
        "snippets": [
            {
                "language": "arandu",
                "path": "./snippets/arandu.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Arandu",
            "properties": {
                "arandu.server.path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "description": "Absolute path to the arandu-lsp executable. When null, the extension checks the workspace/repository target build, the arandu-lsp server bundled in this VSIX, and finally the PATH."
                },
                "arandu.cli.path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "description": "Absolute path to the arandu executable used by the Testing view and benchmark commands. If null, the extension discovers it beside arandu-lsp, in the workspace target directory, or in PATH."
                },
                "arandu.trace.server": {
                    "type": "string",
                    "scope": "window",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Log level (trace) for the Arandu Language Server."
                }
            }
        },
        "configurationDefaults": {
            "[arandu]": {
                "editor.defaultFormatter": "arandu.arandu-lang",
                "editor.formatOnSave": false
            }
        },
        "commands": [
            {
                "command": "arandu.restartServer",
                "title": "Arandu: Restart Language Server"
            },
            {
                "command": "arandu.showServerLogs",
                "title": "Arandu: Show Language Server Logs"
            },
            {
                "command": "arandu.refreshTests",
                "title": "Arandu: Refresh Tests"
            },
            {
                "command": "arandu.runProject",
                "title": "Arandu: Run Project"
            },
            {
                "command": "arandu.checkProject",
                "title": "Arandu: Check Project"
            },
            {
                "command": "arandu.runBenchmark",
                "title": "Arandu: Run Benchmark"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "arandu",
                "scopes": {
                    "keyword": [
                        "keyword.control.arandu"
                    ],
                    "function": [
                        "entity.name.function.arandu"
                    ],
                    "variable": [
                        "variable.other.arandu"
                    ],
                    "parameter": [
                        "variable.parameter.arandu"
                    ],
                    "type": [
                        "entity.name.type.arandu"
                    ],
                    "struct": [
                        "entity.name.type.struct.arandu"
                    ],
                    "enum": [
                        "entity.name.type.enum.arandu"
                    ],
                    "interface": [
                        "entity.name.type.interface.arandu"
                    ],
                    "namespace": [
                        "entity.name.type.module.arandu"
                    ],
                    "number": [
                        "constant.numeric.arandu"
                    ],
                    "string": [
                        "string.quoted.double.arandu"
                    ],
                    "comment": [
                        "comment.line.double-slash.arandu"
                    ],
                    "operator": [
                        "keyword.operator.arandu"
                    ],
                    "property": [
                        "variable.other.property.arandu"
                    ],
                    "enumMember": [
                        "constant.other.enum-member.arandu"
                    ],
                    "decorator": [
                        "entity.name.tag.annotation.arandu"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run lint && node esbuild.js --production",
        "compile": "tsc -p ./ && node esbuild.js",
        "watch": "node esbuild.js --watch",
        "lint": "eslint src --max-warnings=0",
        "pretest": "npm run compile && npm run lint",
        "test": "npm run test:unit && npm run test:extension",
        "test:unit": "node --test out/test/unit/*.test.js",
        "test:extension": "node ./out/test/runTest.js",
        "test:installed": "npm run package:vsix && node ./out/test/runInstalledTest.js",
        "package:check": "vsce ls",
        "prepackage:vsix": "node -e \"require('node:fs').mkdirSync('.vscode-test', { recursive: true })\"",
        "package:vsix": "vsce package --no-dependencies --out .vscode-test/arandu-lang.vsix"
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "^20.14.9",
        "@types/vscode": "1.92.0",
        "@vscode/test-electron": "3.1.0",
        "@vscode/vsce": "3.9.2",
        "esbuild": "0.28.2",
        "eslint": "10.9.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.67.0"
    }
}
