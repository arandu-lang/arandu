/// Broadcasts a boolean mask without exposing arbitrary mask bits.
public func Mask8x16.splat(value: bool): Mask8x16 {
    return Mask8x16 { bits: U8x16.splat(if value { 255 as u8 } else { 0 as u8 }) }
}
/// Builds a mask from individual lane booleans.
public func Mask8x16.new(v0: bool, v1: bool, v2: bool, v3: bool, v4: bool, v5: bool, v6: bool, v7: bool, v8: bool, v9: bool, v10: bool, v11: bool, v12: bool, v13: bool, v14: bool, v15: bool): Mask8x16 {
