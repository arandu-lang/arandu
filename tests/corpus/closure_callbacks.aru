module closureCallbacks

// Non-escaping callbacks (RFC 0032, L1): each `(A) -> R` parameter is an
// implicit type parameter, and each closure argument a struct whose `call`
// the callee invokes directly.

struct Point {
    x: int,
    y: int,
}

func apply(x: int, f: (int) -> int): int {
    return f(x)
}

func applyTwice(x: int, f: (int) -> int): int {
    return f(f(x))
}

func fold(n: int, initial: int, f: (int, int) -> int): int {
    let mut acc = initial
    let mut i = 0
    while i < n {
        acc = f(acc, i)
        i = i + 1
    }
    return acc
}

func each(n: int, f: (int) -> void): void {
    let mut i = 0
    while i < n {
        f(i)
        i = i + 1
    }
}

func pick(flag: bool, f: () -> int): int {
    if flag { return f() }
    return 0
}

// The callback is passed on to another callback parameter.
func forward(x: int, f: (int) -> int): int {
    return applyTwice(x, f) + apply(x, f)
}

func ignore(value: int): void {
}

func copyCaptures(): int {
    let k: int = 10
    let origin = Point { x: 3, y: 4 }
    if applyTwice(1, (x: int) => x + k) != 21 { return 1 }
    if apply(2, (x) => x * origin.x + origin.y) != 10 { return 2 }
    // The caller keeps its own copy.
    if k != 10 { return 3 }
    return 0
}

func blockBodies(): int {
    let scale: int = 3
    let total = fold(4, 0, (acc, i) => {
        if i == 0 { return acc + 100 }
        let step = i * scale
        acc + step
    })
    if total != 118 { return 1 }
    if pick(true, () => { return scale * 14 }) != 42 { return 2 }
    if pick(false, () => scale) != 0 { return 3 }
    return 0
}

func voidAndForwarded(): int {
    each(3, (i) => ignore(i))
    let base: int = 5
    if forward(2, (x) => x * base) != 60 { return 1 }
    return 0
}

func nestedClosures(): int {
    let k: int = 7
    let r = apply(1, (x) => apply(x + 1, (y) => y * k + x))
    if r != 15 { return 1 }
    return 0
}

// Assigned captures are real mutable borrows of the caller's locals; a
// `let mut` local that is only read is a shared borrow and sees every write.
func borrowedCaptures(): int {
    let mut total = 0
    each(4, (x) => { total = total + x })
    if total != 6 { return 1 }
    let mut live = 1
    each(3, (x) => { live = live * 2 })
    let mut reads = 0
    each(3, (x) => { reads = reads + live })
    if reads != 24 { return 2 }
    let mut count = 0
    let r = fold(3, 0, (acc, i) => {
        count = count + 1
        acc + i
    })
    if r != 3 || count != 3 { return 3 }
    return 0
}

func double(x: int): int {
    return x * 2
}

func add(a: int, b: int): int {
    return a + b
}

// A named function is passed as a callback through an adapter; `own` and
// `move` arrow lambdas move their captures; a `mut ref` is captured uniquely.
func namedAndOwning(): int {
    if apply(21, double) != 42 { return 1 }
    if fold(4, 0, add) != 6 { return 2 }
    let k: int = 3
    if apply(1, own (x: int) => x + k) != 4 { return 3 }
    if apply(1, move (x) => x * k) != 3 { return 4 }
    let mut c = 1
    bumpTwice(mut ref c, 5)
    if c != 11 { return 5 }
    return 0
}

func bumpTwice(counter: mut ref int, by: int): void {
    each(2, (i) => {
        *counter = *counter + by
    })
}

struct Bag {
    a: int,
    b: int,
    c: int,
}

func Bag.forEach(self: ref Bag, f: (int) -> void): void {
    f(self.a)
    f(self.b)
    f(self.c)
}

func Bag.fold(self: ref Bag, init: int, f: (int, int) -> int): int {
    return f(f(f(init, self.a), self.b), self.c)
}

func Bag.mapSum(self: ref Bag, f: (int) -> int): int {
    return f(self.a) + f(self.b) + f(self.c)
}

struct Pair<T> {
    first: T,
    second: T,
}

func Pair.each<T>(self: ref Pair<T>, f: (T) -> void): void {
    f(self.first)
    f(self.second)
}

func Pair.combine<T>(self: ref Pair<T>, f: (T, T) -> T): T {
    return f(self.first, self.second)
}

func tripleIt(x: int): int { return x * 3 }

// Methods take callbacks too, including on a generic receiver whose type
// arguments flow into the callback's parameters.
func methodCallbacks(): int {
    let bag = Bag { a: 1, b: 2, c: 3 }
    let mut total = 0
    bag.forEach((x) => { total = total + x })
    if total != 6 { return 1 }
    if bag.fold(10, (acc, x) => acc + x) != 16 { return 2 }
    if bag.mapSum(tripleIt) != 18 { return 3 }
    let p = Pair<int> { first: 20, second: 22 }
    let mut seen = 0
    p.each((x) => { seen = seen + x })
    if seen != 42 { return 4 }
    if p.combine((a, b) => a * b) != 440 { return 5 }
    let q = Pair<bool> { first: true, second: false }
    if q.combine((a, b) => a && b) { return 6 }
    return 0
}

func main(): int {
    let copied = copyCaptures()
    if copied != 0 { return 10 + copied }
    let blocks = blockBodies()
    if blocks != 0 { return 20 + blocks }
    let forwarded = voidAndForwarded()
    if forwarded != 0 { return 30 + forwarded }
    let nested = nestedClosures()
    if nested != 0 { return 40 + nested }
    let borrowed = borrowedCaptures()
    if borrowed != 0 { return 50 + borrowed }
    let named = namedAndOwning()
    if named != 0 { return 60 + named }
    let methods = methodCallbacks()
    if methods != 0 { return 70 + methods }
    return 0
}
