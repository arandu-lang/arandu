module hashVectors

import std.crypto.hash as hash

import std.core.intrinsics as intrinsics

import std.core.slice as slice

func same(a: [32]u8, b: [32]u8): bool {
    let mut i: usize = 0
    while i < 32 { if a[i] != b[i] { return false }; i = i + 1 }
    return true
}

func streaming(data: []u8, step: usize, sha: [32]u8, blake: [32]u8): int {
    let mut s = hash.Sha256.new()
    let mut b = hash.Blake3.new()
    let mut position: usize = 0
    let length = slice.len<u8>(data)
    while position < length {
        let mut count = step
        if count > length - position { count = length - position }
        let part = unsafe { intrinsics.sliceSubslice<u8>(data, position, count) }
        if !s.update(part) || !b.update(part) { return 1 }
        // Snapshotting an unfinished state must not affect subsequent updates.
        s.finish()
        b.finish()
        position = position + count
    }
    if !same(s.finish(), sha) { return 2 }
    if !same(b.finish(), blake) { return 3 }
    if !same(s.finish(), sha) || !same(b.finish(), blake) { return 4 }
    return 0
}

func probe(data: []u8, sha: [32]u8, blake: [32]u8): int {
    match hash.sha256(data) {
        Option.Some(digest) => { if !same(digest, sha) { return 1 } }
        Option.None => { return 2 }
    }
    if !same(hash.blake3(data), blake) { return 3 }
    if streaming(data, 1, sha, blake) != 0 { return 4 }
    if streaming(data, 7, sha, blake) != 0 { return 5 }
    if streaming(data, 64, sha, blake) != 0 { return 6 }
    if streaming(data, 513, sha, blake) != 0 { return 7 }
    return 0
}

