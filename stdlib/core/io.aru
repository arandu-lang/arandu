module std.core.io

import std.core.result as result
import std.core.option as option
import std.core.slice as slice
import std.core.intrinsics as intrinsics

/// Error kinds for freestanding in-memory I/O operations (RFC 0017 / SL_S-Core.4).
public enum CoreIoErrorKind {
    UnexpectedEof,
    WriteZero,
    InvalidInput,
    Other,
}

/// Structured error for core I/O operations without OS dependencies.
public struct CoreIoError {
    kind: CoreIoErrorKind
}

/// Creates a new `CoreIoError`.
public func newCoreIoError(kind: CoreIoErrorKind): CoreIoError {
    return CoreIoError { kind: kind }
}

/// Enumeration of possible methods to seek within an I/O stream.
public enum SeekFrom {
    Start(uint),
    Current(int),
    End(int),
}

/// Interface for reading bytes into a borrowed mutable buffer.
public interface Reader {
    func read(self: mut ref Self, buf: mut ref []u8): Result<uint, CoreIoError>
}

/// Interface for writing bytes from a borrowed buffer.
public interface Writer {
    func write(self: mut ref Self, buf: []u8): Result<uint, CoreIoError>
    func flush(self: mut ref Self): Result<bool, CoreIoError>
}

/// Interface for seeking within a byte stream.
public interface Seeker {
    func seek(self: mut ref Self, pos: SeekFrom): Result<uint, CoreIoError>
}

/// An in-memory reader over a contiguous slice of bytes (`[]u8`).
public struct SliceReader {
    data: []u8
    pos: uint
}

/// Creates a new `SliceReader` over `data`.
public func newSliceReader(data: []u8): SliceReader {
    return SliceReader {
        data: data,
        pos: 0,
    }
}

/// Returns the remaining unread bytes count.
public func SliceReader.remaining(self: ref SliceReader): uint {
    let total = slice.len<u8>(self.data)
    if self.pos >= total {
        return 0
    }
    return total - self.pos
}

/// Reads up to `buf.len` bytes from the internal slice.
public func SliceReader.read(self: mut ref SliceReader, buf: mut ref []u8): Result<uint, CoreIoError> {
    let avail = self.remaining()
    if avail == 0 {
        return Result.Ok(0)
    }
    let buf_len = slice.len<u8>(*buf)
    let mut to_read = avail
    if to_read > buf_len {
        to_read = buf_len
    }

    unsafe {
        let src = slice.asPtr<u8>(self.data)
        let dst = slice.asPtr<u8>(*buf)
        intrinsics.copyNonoverlapping<u8>(src, dst, to_read)
    }

    self.pos = self.pos + to_read
    return Result.Ok(to_read)
}

/// Seeks to an offset in bytes in the underlying slice.
public func SliceReader.seek(self: mut ref SliceReader, pos: SeekFrom): Result<uint, CoreIoError> {
    let total = slice.len<u8>(self.data)
    let mut new_pos: uint = 0

    match pos {
        SeekFrom.Start(offset) => {
            new_pos = offset
        }
        SeekFrom.Current(delta) => {
            let cur = self.pos as int
            let target = cur + delta
            if target < 0 {
                return Result.Err(newCoreIoError(CoreIoErrorKind.InvalidInput))
            }
            new_pos = target as uint
        }
        SeekFrom.End(delta) => {
            let end = total as int
            let target = end + delta
            if target < 0 {
                return Result.Err(newCoreIoError(CoreIoErrorKind.InvalidInput))
            }
            new_pos = target as uint
        }
    }

    if new_pos > total {
        return Result.Err(newCoreIoError(CoreIoErrorKind.InvalidInput))
    }

    self.pos = new_pos
    return Result.Ok(new_pos)
}
