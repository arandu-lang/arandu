    let b0 = if v0 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(0, b0)
    let b1 = if v1 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(1, b1)
    let b2 = if v2 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(2, b2)
    let b3 = if v3 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(3, b3)
    let b4 = if v4 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(4, b4)
    let b5 = if v5 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(5, b5)
    let b6 = if v6 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(6, b6)
    let b7 = if v7 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(7, b7)
    let b8 = if v8 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(8, b8)
    let b9 = if v9 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(9, b9)
    let b10 = if v10 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(10, b10)
    let b11 = if v11 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(11, b11)
    let b12 = if v12 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(12, b12)
    let b13 = if v13 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(13, b13)
    let b14 = if v14 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(14, b14)
    let b15 = if v15 { 255 as u8 } else { 0 as u8 }
    bits = bits.replaceLane(15, b15)
    return Mask8x16 { bits: bits }
}
/// Boolean lane-wise and.
public func Mask8x16.bitAnd(self: Mask8x16, other: Mask8x16): Mask8x16 {
    return Mask8x16 { bits: self.bits.bitAnd(other.bits) }
}
/// Boolean lane-wise or.
public func Mask8x16.bitOr(self: Mask8x16, other: Mask8x16): Mask8x16 {
    return Mask8x16 { bits: self.bits.bitOr(other.bits) }
