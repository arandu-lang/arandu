//! Growable contiguous arrays.
//!
//! ## Overview
//!
//! `Vec<T>` owns a heap buffer with separate length and capacity. Use its fallible `try*` operations when allocation failure must be handled explicitly.
//!
//! ## Example
//!
//! ```arandu
//! import std.alloc.vec as vec
//!
//! let mut values = vec.new<int>()
//! values.push(3)
//! let first = values.get(0)
//! ```
//!
//! ## Safety
//! A slice returned by `asSlice` borrows the vector's storage. Growth,
//! clear, or destroy can invalidate that view.
//!
//! ## Allocations
//! `new` does not allocate. `tryPush` and `tryReserve` return `false` on
//! allocation failure; `push` and `reserve` may abort on failure.
//!
//! ## Platform
//! `native` · `wasm32`

module std.alloc.vec

/// Minimal 0.1 — growable array (`Vec<T>`).
///
/// # Design
/// Contiguous pure-buffer storage: host raw allocators
/// (`ar_vec_malloc` / `ar_vec_realloc` / `ar_vec_buf_free`) + typed access via
/// mem intrinsics (`sizeOf` / `ptrOffset` / `ptrRead` / `ptrWrite`).
///
/// Growth: geometric factor 2, minimum capacity 8 (amortised O(1) append).

import std.core.mem as mem
import std.core.intrinsics as intrinsics

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: uint): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: uint): void
    /// Host allocator that resizes a raw byte buffer.
    func ar_vec_realloc(p: ptr[u8], oldSize: uint, newSize: uint): ptr[u8]
}

/// Growable contiguous buffer of `T`.
public struct Vec<T> {
    /// Pointer to the owned element buffer.
    data: ptr[T]
    /// Number of initialized elements.
    len: uint
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: uint
}

/// Creates a new empty `Vec<T>` without heap allocation.
///
/// # Examples
/// ```arandu
/// let v = vec.new<int>()
/// vec.len<int>(v) // 0
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func new<T>(): Vec<T> {
    return Vec<T> {
        data: nil,
        len: 0,
        capacity: 0,
    }
}

/// Creates an empty `Vec<T>` preallocated with room for at least `cap` elements.
///
/// # Examples
/// ```arandu
/// let v = vec.withCapacity<int>(16)
/// vec.capacity<int>(v) // >= 16
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(cap)
public func withCapacity<T>(cap: uint): Vec<T> {
    let mut v = new<T>()
    ensureCapacity<T>(v, cap)
    return v
}

/// Attempts to ensure absolute capacity ≥ `minCap`.
///
/// Returns `true` on success. On failure (such as capacity overflow or
/// allocation failure), returns `false` and leaves `v` completely unmodified.
public func tryEnsureCapacity<T>(v: mut ref Vec<T>, minCap: uint): bool {
    if v.capacity >= minCap {
        return true
    }
    let maxCap: uint = 2147483647
    if minCap > maxCap {
        return false
    }
    let mut newCap: uint = v.capacity
    if newCap == 0 {
        newCap = 8
    }
    while newCap < minCap {
        if newCap > maxCap / 2 {
            newCap = maxCap
        } else {
            newCap = newCap * 2
        }
    }
    let elem = mem.sizeOf<T>()
    if elem > 0 && newCap > (maxCap / elem) {
        return false
    }
    let oldBytes = v.capacity * elem
    let newBytes = newCap * elem
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_realloc(v.data as ptr[u8], oldBytes, newBytes)
        if p == nullp {
            return false
        }
        v.data = p as ptr[T]
        v.capacity = newCap
    }
    return true
}

/// Ensure absolute capacity ≥ `minCap`. Aborts if reallocation fails.
func ensureCapacity<T>(v: mut ref Vec<T>, minCap: uint): void {
    if !tryEnsureCapacity<T>(v, minCap) {
        unsafe {
            intrinsics.abort()
        }
    }
}

/// Fallible capacity reservation.
///
/// Reserves capacity for at least `additional` more elements beyond current `len`.
/// Returns `true` on success, or `false` on OOM without aborting and preserving
/// existing vector contents.
public func tryReserve<T>(v: mut ref Vec<T>, additional: uint): bool {
    let maxCap: uint = 2147483647
    if additional > maxCap - v.len {
        return false
    }
    let need = v.len + additional
    return tryEnsureCapacity<T>(v, need)
}

/// Reserves capacity for at least `additional` more elements beyond current `len`.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.reserve<int>(v, 10)
/// vec.capacity<int>(v) // >= 10
/// ```
///
/// # Complexity
/// Time: O(n) reallocation | Space: O(capacity)
public func reserve<T>(v: mut ref Vec<T>, additional: uint): void {
    if !tryReserve<T>(v, additional) {
        unsafe {
            intrinsics.abort()
        }
    }
}

/// Fallible element append.
///
/// Appends `value` to the end of the vector. Returns `true` on success.
/// On allocation failure, returns `false` and leaves the vector intact.
public func tryPush<T>(v: mut ref Vec<T>, value: T): bool {
    let maxCap: uint = 2147483647
    if v.len >= maxCap {
        return false
    }
    let need = v.len + 1
    if v.capacity < need {
        if !tryEnsureCapacity<T>(v, need) {
            return false
        }
    }
    unsafe {
        let dest = mem.ptrOffset<T>(v.data, v.len as i32)
        mem.ptrWrite<T>(dest, value)
    }
    v.len = v.len + 1
    return true
}

/// Appends `value` to the end of the vector.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 42)
/// vec.len<int>(v) // 1
/// ```
///
/// # Complexity
/// Time: Amortized O(1) | Space: O(1)
public func push<T>(v: mut ref Vec<T>, value: T): void {
    if !tryPush<T>(v, value) {
        unsafe {
            intrinsics.abort()
        }
    }
}

/// Removes and returns the last element, or `Option.None` if the vector is empty.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 10)
/// vec.pop<int>(v) // Some(10)
/// vec.pop<int>(v) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func pop<T>(v: mut ref Vec<T>): Option<T> {
    if v.len == 0 {
        return Option.None
    }
    v.len = v.len - 1
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, v.len as i32)
        return Option.Some(mem.ptrRead<T>(elemPtr))
    }
}

/// Returns a copy of the element at `index`, or `Option.None` if out of bounds.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 100)
/// vec.get<int>(v, 0) // Some(100)
/// vec.get<int>(v, 5) // None
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func get<T>(v: ref Vec<T>, index: uint): Option<T> {
    let maxCap: uint = 2147483647
    if index >= v.len || index > maxCap {
        return Option.None
    }
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, index as i32)
        return Option.Some(mem.ptrRead<T>(elemPtr))
    }
}

/// Overwrites the element at `index` with `value`, returning `false` if out of bounds.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 10)
/// vec.put<int>(v, 0, 20) // true
/// vec.put<int>(v, 5, 20) // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func put<T>(v: mut ref Vec<T>, index: uint, value: T): bool {
    let maxCap: uint = 2147483647
    if index >= v.len || index > maxCap {
        return false
    }
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, index as i32)
        mem.ptrWrite<T>(elemPtr, value)
    }
    return true
}

/// Returns the number of elements contained in the vector.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.len<int>(v) // 0
/// vec.push<int>(v, 1)
/// vec.len<int>(v) // 1
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func len<T>(v: ref Vec<T>): uint {
    return v.len
}

/// Returns the total number of elements the vector can hold without reallocating.
///
/// # Examples
/// ```arandu
/// let v = vec.withCapacity<int>(32)
/// vec.capacity<int>(v) // >= 32
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func capacity<T>(v: ref Vec<T>): uint {
    return v.capacity
}

/// Returns `true` if the vector contains no elements (`len == 0`).
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.isEmpty<int>(v) // true
/// vec.push<int>(v, 1)
/// vec.isEmpty<int>(v) // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isEmpty<T>(v: ref Vec<T>): bool {
    return v.len == 0
}

/// Returns a shared borrowed view `[]T` of the initialized elements.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 10)
/// let s = vec.asSlice<int>(v)
/// slice.len<int>(s) // 1
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func asSlice<T>(v: ref Vec<T>): []T {
    unsafe {
        return intrinsics.sliceFromRaw<Vec<T>, T>(v, v.data, v.len)
    }
}

/// Clears the vector, removing all values but retaining allocated capacity.
///
/// # Examples
/// ```arandu
/// let mut v = vec.new<int>()
/// vec.push<int>(v, 10)
/// vec.clear<int>(v)
/// vec.len<int>(v) // 0
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func clear<T>(v: mut ref Vec<T>): void {
    v.len = 0
}

/// Deallocates the heap buffer and resets the vector to empty.
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func destroy<T>(v: mut ref Vec<T>): void {
    if v.capacity > 0 {
        let size = v.capacity * mem.sizeOf<T>()
        unsafe {
            ar_vec_buf_free(v.data as ptr[u8], size)
        }
        v.data = nil
        v.capacity = 0
        v.len = 0
    }
}

// ── Method-style surface ───────────────────────────────────────────────────

/// Appends `value`, growing the buffer when full.
///
/// This delegates to `push`; allocation failure aborts. Use `tryPush` when
/// the caller must handle failure.
public func Vec.push<T>(self: mut ref Vec<T>, value: T): void {
    push(self, value)
}

/// Removes and returns the last element, or `None` if empty.
///
/// Capacity remains allocated for reuse; this operation is O(1).
public func Vec.pop<T>(self: mut ref Vec<T>): Option<T> {
    return pop(self)
}

/// Returns a copy of the indexed element as `Some`, or `None` out of bounds.
///
/// The vector is unchanged and no allocation occurs.
public func Vec.get<T>(self: ref Vec<T>, index: uint): Option<T> {
    return get(self, index)
}

/// Replaces an in-range element and returns `true`.
///
/// An out-of-range index returns `false` without changing the vector.
public func Vec.put<T>(self: mut ref Vec<T>, index: uint, value: T): bool {
    return put(self, index, value)
}

/// Returns the number of elements in the vector.
public func Vec.len<T>(self: ref Vec<T>): uint {
    return len(self)
}

/// Returns the allocated capacity of the vector.
public func Vec.capacity<T>(self: ref Vec<T>): uint {
    return capacity(self)
}

/// Returns `true` if the vector contains no elements.
public func Vec.isEmpty<T>(self: ref Vec<T>): bool {
    return isEmpty(self)
}

/// Borrows the initialized elements as a slice without copying.
///
/// The view becomes invalid if the vector is destroyed or reallocated.
public func Vec.asSlice<T>(self: ref Vec<T>): []T {
    return asSlice<T>(self)
}

/// Ensures room for `additional` elements beyond the current length.
///
/// Growth may reallocate and invalidate borrowed slices; failure aborts.
public func Vec.reserve<T>(self: mut ref Vec<T>, additional: uint): void {
    reserve(self, additional)
}

/// Attempts to reserve room for `additional` elements beyond the length.
///
/// Returns `false` on allocation failure or capacity overflow, leaving
/// existing contents intact.
public func Vec.tryReserve<T>(self: mut ref Vec<T>, additional: uint): bool {
    return tryReserve(self, additional)
}

/// Attempts to append one element without aborting on allocation failure.
///
/// Returns `false` and leaves the vector intact if growth fails.
public func Vec.tryPush<T>(self: mut ref Vec<T>, value: T): bool {
    return tryPush(self, value)
}

/// Sets the length to zero while retaining allocated capacity.
///
/// This does not release the buffer or visit each former element.
public func Vec.clear<T>(self: mut ref Vec<T>): void {
    clear(self)
}

/// Releases the owned buffer and resets the vector to empty.
///
/// Borrowed slices into that buffer become invalid. The destructor consumes
/// this `Vec` value.
@Destructor
public func Vec.destroy<T>(self: own Vec<T>): void {
    destroy(self)
}
