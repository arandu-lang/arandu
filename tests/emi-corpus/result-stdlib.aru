import std.core.result as result

func main(): int {
    let success: result.Result<int, str> = Result.Ok(31)
    if !success.isOk() {
        return 1
    }
    if success.isErr() {
        return 2
    }
    let success_value = success.unwrapOr(0)
    if success_value != 31 {
        return 3
    }

    let failure: result.Result<int, str> = Result.Err("failure")
    if !failure.isErr() {
        return 4
    }
    if failure.isOk() {
        return 5
    }
    let fallback = failure.unwrapOr(29)
    if fallback != 29 {
        return 6
    }
    return 0
}
