}
/// Reads one mask lane; invalid indices trap.
public func Mask8x16.testLane(self: Mask8x16, index: int): bool {
    if index < 0 || index >= 16 { unsafe { intrinsics.abort() } return false }
    return self.bits.extractLane(index * 1) != (0 as u8)
}
/// True if every lane is true.
