/// Parses an unsigned 64-bit decimal integer from a UTF-8 string view.
/// Returns `Option.None` if `s` is empty, contains non-digit characters, or overflows `u64`.
public func parseU64(s: str): Option<u64> {
    let bytes = intrinsics.strBytes(s)
    let n = bytes.len
    if n == 0 {
        return Option.None
    }
    let mut i: usize = 0
    if bytes[0] == b'+' {
        i = 1
    }
    if i >= n {
        return Option.None
    }
    let mut acc: u64 = 0
    let maxDiv10: u64 = 1844674407370955161 as u64
    while i < n {
        let ch = bytes[i]
        if ch < b'0' || ch > b'9' {
            return Option.None
        }
        let digit = (ch - b'0') as u64
        if acc > maxDiv10 || (acc == maxDiv10 && digit > (5 as u64)) {
            return Option.None
        }
        acc = acc * (10 as u64) + digit
        i += 1
    }
    return Option.Some(acc)
}

/// Parses an unsigned 64-bit decimal integer (`u64.parse(s)`).
public func u64.parse(s: str): Option<u64> {
    return parseU64(s)
}

/// Parses an unsigned pointer-sized decimal integer from a UTF-8 string view.
public func parseUsize(s: str): Option<usize> {
    let .Some(val) = parseU64(s) else {
        return Option.None
    }
    return Option.Some(val as usize)
}

/// Parses an unsigned pointer-sized decimal integer (`usize.parse(s)`).
public func usize.parse(s: str): Option<usize> {
    return parseUsize(s)
}
