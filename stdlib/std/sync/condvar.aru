//! Native condition variable paired with a std.sync.mutex guard.
//!
//! Sample the predicate while holding the mutex and wait in a loop. wait
//! exclusively borrows the guard, releases its native admission and always
//! reacquires it before returning. Sequence validation under the ParkingLot
//! bucket prevents a notification between unlock and enqueue from being lost.
//! Notifications have no persistent token; spurious wakeups remain permitted.
//! Platform: native. Not a coroutine executor wait and not standalone Wasm.
module std.sync.condvar

import std.core.cell as cell
import std.core.intrinsics as intrinsics
import std.sync.mutex as mutex

extern "C" {
    func ar_rt_condvar_wait(key: ptr[u8], seq: usize): void
    func ar_rt_condvar_notify_one(key: ptr[u8]): void
    func ar_rt_condvar_notify_all(key: ptr[u8]): void
    func ar_rt_condvar_wait_timeout(key: ptr[u8], seq: usize, timeoutMs: u64): i32
}

/// An atomic sequence event with safe guard-based waiting.
public struct Condvar {
    private sequence: cell.UnsafeCell<usize>,
}

/// Creates a new condition variable. No notification is initially pending.
public func Condvar.new(): Condvar {
    return Condvar { sequence: cell.UnsafeCell.new(0 as usize) }
}

/// Waits with the native mutex released, returning with it reacquired.
/// Always recheck the predicate after return.
public func Condvar.wait<T>(self: ref Condvar, guard: mut ref mutex.MutexGuard<T>): void {
    unsafe {
        let sequence = self.sequence.get()
        let current = intrinsics.atomicLoadUsize(ref *sequence)
        guard.waitOnSequence(sequence as ptr[u8], current)
    }
}

/// Waits at most timeoutMs for notification, then reacquires the mutex.
/// The total call can take longer while waiting to reacquire the mutex.
/// Returns true for notification/changed sequence; recheck the predicate.
public func Condvar.waitTimeout<T>(self: ref Condvar, guard: mut ref mutex.MutexGuard<T>, timeoutMs: u64): bool {
    unsafe {
        let sequence = self.sequence.get()
        let current = intrinsics.atomicLoadUsize(ref *sequence)
        return guard.waitOnSequenceTimeout(sequence as ptr[u8], current, timeoutMs)
    }
}

// Abort before sequence reuse instead of admitting an ABA lost notification.
// Unsigned arithmetic is wrapping; zero detects exhaustion on every target.
@Unsafe
func advanceSequence(sequence: ptr[usize]): void {
    unsafe {
        let mut current = intrinsics.atomicLoadUsize(ref *sequence)
        while true {
            let next = current + (1 as usize)
            if next == (0 as usize) { intrinsics.abort() }
            let observed = intrinsics.atomicCompareExchangeUsize(mut ref *sequence, current, next)
            if observed == current { return }
            current = observed
        }
    }
}

/// Wakes the oldest waiter registered at exactly this condition's address.
public func Condvar.notifyOne(self: ref Condvar): void {
    unsafe {
        let sequence = self.sequence.get()
        advanceSequence(sequence)
        ar_rt_condvar_notify_one(sequence as ptr[u8])
    }
}

/// Wakes all waiters registered at exactly this condition's address.
public func Condvar.notifyAll(self: ref Condvar): void {
    unsafe {
        let sequence = self.sequence.get()
        advanceSequence(sequence)
        ar_rt_condvar_notify_all(sequence as ptr[u8])
    }
}

/// Low-level sequence-event wait without releasing a mutex.
/// Prefer wait(guard) for predicate synchronization; notifications can be lost
/// before this call samples the sequence, as with any condition variable.
public func Condvar.waitNotification(self: ref Condvar): void {
    unsafe {
        let sequence = self.sequence.get()
        let current = intrinsics.atomicLoadUsize(ref *sequence)
        ar_rt_condvar_wait(sequence as ptr[u8], current)
    }
}

/// Low-level sequence wait with a monotonic notification timeout.
public func Condvar.waitNotificationTimeout(self: ref Condvar, timeoutMs: u64): bool {
    unsafe {
        let sequence = self.sequence.get()
        let current = intrinsics.atomicLoadUsize(ref *sequence)
        return ar_rt_condvar_wait_timeout(sequence as ptr[u8], current, timeoutMs) == (1 as i32)
    }
}
