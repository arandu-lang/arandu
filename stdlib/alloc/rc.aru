//! Single-threaded reference-counting pointer.
//!
//! ## Overview
//!
//! `Rc<T>` provides shared ownership of a heap-allocated value. Multiple `Rc`
//! handles can point to the same allocation. The inner value is destroyed when
//! the last strong reference is dropped.
//!
//! To prevent reference cycles that cause memory leaks, `Rc` provides non-owning
//! `Weak<T>` pointers via `downgrade`. A `Weak` handle does not keep the value alive,
//! but can attempt to upgrade to a full `Rc` if the value has not yet been dropped.
//!
//! ## Thread Safety
//!
//! `Rc<T>` is strictly thread-local. It uses non-atomic reference counts for
//! maximum execution speed. For cross-thread shared ownership, use `std.alloc.arc.Arc<T>`.
//!
//! ## Examples
//!
//! ```arandu
//! import std.alloc.rc as rc
//!
//! let five = rc.Rc.new(5)
//! let copy = five.clone()
//! assert(five.get() == 5)
//! assert(copy.get() == 5)
//! assert(five.strongCount() == 2)
//! ```
//!
//! ## Platform
//! `native` · `wasm32`
module std.alloc.rc

import std.alloc.allocator_api as alloc
import std.core.intrinsics as intrinsics
import std.core.mem as mem
import std.core.option as option

extern "C" {
    func ar_rt_alloc_aligned(size: usize, align: usize): ptr[u8]
    func ar_rt_free_aligned(data: ptr[u8], size: usize, align: usize): void
}

struct RcBox<T> {
    strong: usize
    weak: usize
    value: T
}

func boxSize<T>(): usize {
    let size = mem.sizeOf<RcBox<T>>()
    if size == (0 as usize) { return 1 as usize }
    return size
}

func boxAlign<T>(): usize {
    return mem.alignOf<RcBox<T>>()
}

/// A single-threaded reference-counting pointer.
public struct Rc<T> {
    private ptr: ptr[RcBox<T>]
}

/// A non-owning weak handle to an `Rc`-managed allocation.
public struct Weak<T> {
    private ptr: ptr[RcBox<T>]
}

/// Allocates a new `Rc<T>` holding `value` on the heap.
public func Rc.new<T>(value: T): Rc<T> {
    let size = boxSize<T>()
    let align = boxAlign<T>()
    unsafe {
        let raw = ar_rt_alloc_aligned(size, align)
        let nullp: ptr[u8] = nil
        if raw == nullp {
            intrinsics.abort()
        }
        let typed = raw as ptr[RcBox<T>]
        let initial = RcBox<T> {
            strong: 1 as usize,
            weak: 1 as usize,
            value: value,
        }
        mem.ptrWrite<RcBox<T>>(typed, initial)
        return Rc<T> { ptr: typed }
    }
}

/// Borrows the contained value.
public func Rc.get<T>(self: ref Rc<T>): ref T {
    unsafe {
        return ref (*self.ptr).value
    }
}

/// Creates a new strong reference to the same allocation.
public func Rc.clone<T>(self: ref Rc<T>): Rc<T> {
    unsafe {
        (*self.ptr).strong = (*self.ptr).strong + (1 as usize)
        return Rc<T> { ptr: self.ptr }
    }
}

/// Returns the number of active strong references.
public func Rc.strongCount<T>(self: ref Rc<T>): usize {
    unsafe {
        return (*self.ptr).strong
    }
}

/// Returns the number of active weak references.
public func Rc.weakCount<T>(self: ref Rc<T>): usize {
    unsafe {
        // Subtract the implicit weak count owned by the strong references
        let w = (*self.ptr).weak
        if w > (0 as usize) {
            return w - (1 as usize)
        }
        return 0 as usize
    }
}

/// Returns `true` if there are no other strong or weak references.
public func Rc.isUnique<T>(self: ref Rc<T>): bool {
    unsafe {
        return (*self.ptr).strong == (1 as usize) && (*self.ptr).weak == (1 as usize)
    }
}

/// Creates a non-owning `Weak<T>` pointer to this allocation.
public func Rc.downgrade<T>(self: ref Rc<T>): Weak<T> {
    unsafe {
        (*self.ptr).weak = (*self.ptr).weak + (1 as usize)
        return Weak<T> { ptr: self.ptr }
    }
}

/// Destroys a strong reference. Destroys value when strong count reaches zero.
@Destructor
func Rc.destroy<T>(self: own Rc<T>): void {
    let nullp: ptr[RcBox<T>] = nil
    if self.ptr == nullp { return }

    unsafe {
        let strong = (*self.ptr).strong - (1 as usize)
        (*self.ptr).strong = strong

        if strong == (0 as usize) {
            // Drop inner value
            mem.dropInPlace<T>(&(*self.ptr).value)

            // Decrement the implicit weak reference owned by the strong count
            let weak = (*self.ptr).weak - (1 as usize)
            (*self.ptr).weak = weak

            if weak == (0 as usize) {
                // No more weak references remain: free control block
                ar_rt_free_aligned(self.ptr as ptr[u8], boxSize<T>(), boxAlign<T>())
            }
        }
    }
}

// ── Weak Pointer Implementation ─────────────────────────────────────────────

/// Clones a weak handle, incrementing the weak reference count.
public func Weak.clone<T>(self: ref Weak<T>): Weak<T> {
    unsafe {
        (*self.ptr).weak = (*self.ptr).weak + (1 as usize)
        return Weak<T> { ptr: self.ptr }
    }
}

/// Attempts to upgrade to a strong `Rc<T>`. Returns `None` if the value was dropped.
public func Weak.upgrade<T>(self: ref Weak<T>): Option<Rc<T>> {
    let nullp: ptr[RcBox<T>] = nil
    if self.ptr == nullp { return Option.None }

    unsafe {
        let strong = (*self.ptr).strong
        if strong == (0 as usize) {
            return Option.None
        }
        (*self.ptr).strong = strong + (1 as usize)
        return Option.Some(Rc<T> { ptr: self.ptr })
    }
}

/// Destroys a weak handle. Frees the control block if no references remain.
@Destructor
func Weak.destroy<T>(self: own Weak<T>): void {
    let nullp: ptr[RcBox<T>] = nil
    if self.ptr == nullp { return }

    unsafe {
        let weak = (*self.ptr).weak - (1 as usize)
        (*self.ptr).weak = weak

        if weak == (0 as usize) && (*self.ptr).strong == (0 as usize) {
            ar_rt_free_aligned(self.ptr as ptr[u8], boxSize<T>(), boxAlign<T>())
        }
    }
}
