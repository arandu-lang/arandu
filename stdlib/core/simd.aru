/// Constructs lanes in ascending index order.
public func F32x4.new(v0: f32, v1: f32, v2: f32, v3: f32): F32x4 {
    let mut value = F32x4.splat(v0)
    unsafe {
        value = simdF32x4Insert1(value, v1)
        value = simdF32x4Insert2(value, v2)
        value = simdF32x4Insert3(value, v3)
    }
    return value
}

/// Broadcasts a scalar to every lane.
public func F32x4.splat(value: f32): F32x4 {
    unsafe { return simdF32x4Splat(value) }
}
/// Native lane-wise add; integer results wrap.
public func F32x4.add(self: F32x4, other: F32x4): F32x4 {
    unsafe { return simdF32x4Add(self, other) }
}
/// Native lane-wise sub; integer results wrap.
public func F32x4.sub(self: F32x4, other: F32x4): F32x4 {
    unsafe { return simdF32x4Sub(self, other) }
}
/// Native lane-wise mul; integer results wrap.
public func F32x4.mul(self: F32x4, other: F32x4): F32x4 {
    unsafe { return simdF32x4Mul(self, other) }
}
/// Native lane-wise div; integer results wrap.
public func F32x4.div(self: F32x4, other: F32x4): F32x4 {
    unsafe { return simdF32x4Div(self, other) }
}
/// Lane-wise eq comparison with canonical all-ones/all-zero masks.
public func F32x4.eq(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Eq(self, other)) }
}
/// Lane-wise ne comparison with canonical all-ones/all-zero masks.
public func F32x4.ne(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Ne(self, other)) }
}
/// Lane-wise lt comparison with canonical all-ones/all-zero masks.
public func F32x4.lt(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Lt(self, other)) }
}
/// Lane-wise le comparison with canonical all-ones/all-zero masks.
public func F32x4.le(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Le(self, other)) }
}
/// Lane-wise gt comparison with canonical all-ones/all-zero masks.
public func F32x4.gt(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Gt(self, other)) }
}
/// Lane-wise ge comparison with canonical all-ones/all-zero masks.
public func F32x4.ge(self: F32x4, other: F32x4): Mask32x4 {
    unsafe { return Mask32x4.fromBits(simdF32x4Ge(self, other)) }
}
/// Selects each lane from `yes` where the mask is true, otherwise from `no`.
public func F32x4.select(mask: Mask32x4, yes: F32x4, no: F32x4): F32x4 {
    unsafe { return simdF32x4Select(mask.rawBits(), yes, no) }
}
/// Extracts a lane. Traps for negative or out-of-range indices.
public func F32x4.extractLane(self: F32x4, index: int): f32 {
    unsafe {
        if index == 0 { return simdF32x4Extract0(self) }
        if index == 1 { return simdF32x4Extract1(self) }
        if index == 2 { return simdF32x4Extract2(self) }
        if index == 3 { return simdF32x4Extract3(self) }
        intrinsics.abort()
    }
    return 0 as f32
}
/// Replaces a lane. Traps for negative or out-of-range indices.
public func F32x4.replaceLane(self: F32x4, index: int, value: f32): F32x4 {
    unsafe {
        if index == 0 { return simdF32x4Insert0(self, value) }
        if index == 1 { return simdF32x4Insert1(self, value) }
        if index == 2 { return simdF32x4Insert2(self, value) }
        if index == 3 { return simdF32x4Insert3(self, value) }
        intrinsics.abort()
    }
    return self
}
/// Reads the first 4 lanes; a short slice returns None without reading data.
/// Only `f32` alignment is required. Scalar accesses avoid aligned vector UB.
public func F32x4.loadUnaligned(source: []f32): Option<F32x4> {
    if intrinsics.sliceLen<f32>(source) < (4 as usize) { return Option.None }
    return Option.Some(F32x4.new(source[0], source[1], source[2], source[3]))
}
/// Writes the first 4 lanes through an exclusive borrowed view.
/// A short destination returns false without writes; scalar alignment suffices.
public func F32x4.storeUnaligned<Owner>(self: F32x4, destination: mut ref slice.MutableSlice<Owner, f32>): bool {
    if destination.len() < (4 as usize) { return false }
    destination.set(0 as usize, self.extractLane(0))
    destination.set(1 as usize, self.extractLane(1))
    destination.set(2 as usize, self.extractLane(2))
    destination.set(3 as usize, self.extractLane(3))
    return true
}

/// Low-level slice descriptor store. Safety: the complete destination data
/// range must be exclusively accessible for this call; mut ref to a shared
/// Writes the first 4 lanes through an exclusive mutable slice view.
/// A short destination returns false without writes.
public func F32x4.storeUnalignedSlice(self: F32x4, destination: mut []f32): bool {
    if intrinsics.mutSliceLen<f32>(destination) < (4 as usize) { return false }
    destination[0] = self.extractLane(0)
    destination[1] = self.extractLane(1)
    destination[2] = self.extractLane(2)
    destination[3] = self.extractLane(3)
    return true
}

/// Constructs lanes in ascending index order.
public func F64x2.new(v0: f64, v1: f64): F64x2 {
    let mut value = F64x2.splat(v0)
    unsafe {
        value = simdF64x2Insert1(value, v1)
    }
    return value
}

/// Broadcasts a scalar to every lane.
public func F64x2.splat(value: f64): F64x2 {
    unsafe { return simdF64x2Splat(value) }
}
/// Native lane-wise add; integer results wrap.
public func F64x2.add(self: F64x2, other: F64x2): F64x2 {
    unsafe { return simdF64x2Add(self, other) }
}
/// Native lane-wise sub; integer results wrap.
public func F64x2.sub(self: F64x2, other: F64x2): F64x2 {
    unsafe { return simdF64x2Sub(self, other) }
}
/// Native lane-wise mul; integer results wrap.
public func F64x2.mul(self: F64x2, other: F64x2): F64x2 {
    unsafe { return simdF64x2Mul(self, other) }
}
/// Native lane-wise div; integer results wrap.
public func F64x2.div(self: F64x2, other: F64x2): F64x2 {
    unsafe { return simdF64x2Div(self, other) }
}
/// Lane-wise eq comparison with canonical all-ones/all-zero masks.
public func F64x2.eq(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Eq(self, other)) }
}
/// Lane-wise ne comparison with canonical all-ones/all-zero masks.
public func F64x2.ne(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Ne(self, other)) }
}
/// Lane-wise lt comparison with canonical all-ones/all-zero masks.
public func F64x2.lt(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Lt(self, other)) }
}
/// Lane-wise le comparison with canonical all-ones/all-zero masks.
public func F64x2.le(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Le(self, other)) }
}
/// Lane-wise gt comparison with canonical all-ones/all-zero masks.
public func F64x2.gt(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Gt(self, other)) }
}
/// Lane-wise ge comparison with canonical all-ones/all-zero masks.
public func F64x2.ge(self: F64x2, other: F64x2): Mask64x2 {
    unsafe { return Mask64x2.fromBits(simdF64x2Ge(self, other)) }
}
/// Selects each lane from `yes` where the mask is true, otherwise from `no`.
public func F64x2.select(mask: Mask64x2, yes: F64x2, no: F64x2): F64x2 {
    unsafe { return simdF64x2Select(mask.rawBits(), yes, no) }
}
/// Extracts a lane. Traps for negative or out-of-range indices.
public func F64x2.extractLane(self: F64x2, index: int): f64 {
    unsafe {
        if index == 0 { return simdF64x2Extract0(self) }
        if index == 1 { return simdF64x2Extract1(self) }
        intrinsics.abort()
    }
    return 0 as f64
}
/// Replaces a lane. Traps for negative or out-of-range indices.
public func F64x2.replaceLane(self: F64x2, index: int, value: f64): F64x2 {
    unsafe {
        if index == 0 { return simdF64x2Insert0(self, value) }
        if index == 1 { return simdF64x2Insert1(self, value) }
        intrinsics.abort()
    }
    return self
}
/// Reads the first 2 lanes; a short slice returns None without reading data.
/// Only `f64` alignment is required. Scalar accesses avoid aligned vector UB.
public func F64x2.loadUnaligned(source: []f64): Option<F64x2> {
    if intrinsics.sliceLen<f64>(source) < (2 as usize) { return Option.None }
    return Option.Some(F64x2.new(source[0], source[1]))
}
/// Writes the first 2 lanes through an exclusive borrowed view.
/// A short destination returns false without writes; scalar alignment suffices.
public func F64x2.storeUnaligned<Owner>(self: F64x2, destination: mut ref slice.MutableSlice<Owner, f64>): bool {
    if destination.len() < (2 as usize) { return false }
    destination.set(0 as usize, self.extractLane(0))
    destination.set(1 as usize, self.extractLane(1))
    return true
}

/// Low-level slice descriptor store. Safety: the complete destination data
/// range must be exclusively accessible for this call; mut ref to a shared
/// Writes the first 2 lanes through an exclusive mutable slice view.
/// A short destination returns false without writes.
public func F64x2.storeUnalignedSlice(self: F64x2, destination: mut []f64): bool {
    if intrinsics.mutSliceLen<f64>(destination) < (2 as usize) { return false }
    destination[0] = self.extractLane(0)
    destination[1] = self.extractLane(1)
    return true
