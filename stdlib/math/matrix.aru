//! Fixed-shape and heap-backed matrix storage.
//!
//! ## Overview
//!
//! `StaticMatrix` uses compile-time dimensions. `Matrix<T>` owns dynamic storage and exposes borrowed views for numerical kernels.
//!
//! ## Safety
//! Fixed matrices have compile-time shape. Dynamic matrix construction is
//! fallible and returns `Option`; views borrow the matrix's storage and must
//! not outlive it or remain in use after `free`.
//!
//! ## Allocations
//! `StaticMatrix` stores elements inline. `Matrix<T>` obtains heap storage.
//!
//! ## Platform
//! `native` · `wasm32`

module std.math.matrix

/// Fixed-shape matrices backed by const-generic arrays and dynamic heap matrices
/// (RFC 0012).
///
/// Features:
/// - StaticMatrix<T, M, N>: one representation for every compile-time shape.
/// - Destination-passing kernels with no hidden result allocation.
/// - Shape-safe rectangular multiplication: (M x K) * (K x N).
/// - Dynamic Matrix<T>: Heap-allocated matrix with explicit deallocation and ArrayView interoperability.

import std.core.mem as mem
import std.math.view as view

extern "C" {
    /// Host allocator for a raw byte buffer.
    func ar_vec_malloc(size: usize): ptr[u8]
    /// Host deallocator for a raw byte buffer.
    func ar_vec_buf_free(p: ptr[u8], size: usize): void
}

// ── Const-Generic Fixed Matrix ───────────────────────────────────────────────

/// Fixed-shape matrix with dimensions encoded in the type.
public struct StaticMatrix<T, const M: uint, const N: uint> {
    /// Elements stored inline in the fixed matrix.
    data: [M][N]T
}

/// Returns the compile-time row count.
public func StaticMatrix.rows<T, const M: uint, const N: uint>(self: ref StaticMatrix<T, M, N>): uint {
    return M
}

/// Returns the compile-time column count.
public func StaticMatrix.cols<T, const M: uint, const N: uint>(self: ref StaticMatrix<T, M, N>): uint {
    return N
}

/// Reads the element at `(r, c)` from inline matrix storage.
///
/// Both coordinates must be within the compile-time shape; this method does
/// not return an `Option` for out-of-range indexes.
public func StaticMatrix.get<T, const M: uint, const N: uint>(self: ref StaticMatrix<T, M, N>, r: uint, c: uint): T {
    return self.data[r][c]
}

/// Replaces the inline element at `(r, c)`.
///
/// Both coordinates must be within the compile-time shape.
public func StaticMatrix.set<T, const M: uint, const N: uint>(self: mut ref StaticMatrix<T, M, N>, r: uint, c: uint, value: T): void {
    self.data[r][c] = value
}

/// Writes `value` to every cell of an existing M × N float matrix.
///
/// The shape is fixed by the destination type. This visits M × N elements
/// and does not allocate a result.
public func StaticMatrix.fill<const M: uint, const N: uint>(self: mut ref StaticMatrix<float, M, N>, value: float): void {
    let mut r: uint = 0
    while r < M {
        let mut c: uint = 0
        while c < N {
            self.set(r, c, value)
            c = c + 1
        }
        r = r + 1
    }
}

/// Writes ones on the diagonal and zeros elsewhere in an N × N matrix.
///
/// The caller provides destination storage; work is O(N²) with no result
/// allocation.
public func StaticMatrix.identityInto<const N: uint>(self: mut ref StaticMatrix<float, N, N>): void {
    let mut r: uint = 0
    while r < N {
        let mut c: uint = 0
        while c < N {
            if r == c {
                self.set(r, c, 1.0)
            } else {
                self.set(r, c, 0.0)
            }
            c = c + 1
        }
        r = r + 1
    }
}

/// Writes the elementwise sum of two M × N matrices into `out`.
///
/// The shared shape is enforced by the types. This visits M × N cells and
/// does not allocate a result.
public func StaticMatrix.addInto<const M: uint, const N: uint>(
    self: ref StaticMatrix<float, M, N>,
    right: ref StaticMatrix<float, M, N>,
    out: mut ref StaticMatrix<float, M, N>
): void {
    let mut r: uint = 0
    while r < M {
        let mut c: uint = 0
        while c < N {
            out.set(r, c, self.get(r, c) + right.get(r, c))
            c = c + 1
        }
        r = r + 1
    }
}

/// Multiplies M × K by K × N and writes the M × N result into `out`.
///
/// The type parameters enforce compatible shapes. Work is O(M × K × N)
/// using scalar loops; no result buffer is allocated internally.
public func StaticMatrix.mulInto<const M: uint, const K: uint, const N: uint>(
    self: ref StaticMatrix<float, M, K>,
    right: ref StaticMatrix<float, K, N>,
    out: mut ref StaticMatrix<float, M, N>
): void {
    let mut r: uint = 0
    while r < M {
        let mut c: uint = 0
        while c < N {
            let mut sum: float = 0.0
            let mut k: uint = 0
            while k < K {
                sum = sum + self.get(r, k) * right.get(k, c)
                k = k + 1
            }
            out.set(r, c, sum)
            c = c + 1
        }
        r = r + 1
    }
}

/// Copies the M × N input into a caller-owned N × M transposed destination.
///
/// This moves each element to `(column, row)` in O(M × N) time; it does not
/// allocate a result buffer.
public func StaticMatrix.transposeInto<const M: uint, const N: uint>(
    self: ref StaticMatrix<float, M, N>,
    out: mut ref StaticMatrix<float, N, M>
): void {
    let mut r: uint = 0
    while r < M {
        let mut c: uint = 0
        while c < N {
            out.set(c, r, self.get(r, c))
            c = c + 1
        }
        r = r + 1
    }
}

/// Returns `a₀₀ × a₁₁ - a₀₁ × a₁₀` for a 2 × 2 float matrix.
///
/// This is constant-time scalar arithmetic without allocation.
public func StaticMatrix.det2(self: ref StaticMatrix<float, 2, 2>): float {
    return self.get(0, 0) * self.get(1, 1) - self.get(0, 1) * self.get(1, 0)
}

// ── Dynamic Heap Matrix<T> ───────────────────────────────────────────────────

/// Dynamic row-major matrix allocated on the heap.
public struct Matrix<T> {
    /// Pointer to the owned matrix elements.
    data: ptr[T]
    /// Number of rows.
    rows: uint
    /// Number of columns.
    cols: uint
    /// Allocated capacity in elements or bytes, as defined by this type.
    capacity: uint
}

/// Allocates a row-major `rows × cols` matrix filled with `initial`.
///
/// Returns `None` when the host allocation fails. On success, the caller
/// owns the buffer and its destructor releases it automatically when the
/// `Matrix` value goes out of scope. Initialization visits every element.
public func Matrix.tryNew<T>(rows: uint, cols: uint, initial: T): Option<Matrix<T>> {
    // Pointer offsets are represented as i32 throughout the stdlib. Keep the
    // element count and byte allocation within that addressable range.
    let maxElements: uint = 2147483647
    if rows > maxElements || cols > maxElements {
        return Option.None
    }
    if rows != 0 && cols > maxElements / rows {
        return Option.None
    }
    let total = rows * cols
    let elemSize = mem.sizeOf<T>()
    let maxElemUsize = maxElements as usize
    if elemSize == (0 as usize) || elemSize > maxElemUsize || (total as usize) > maxElemUsize / elemSize {
        return Option.None
    }
    let totalBytes = (total as usize) * elemSize
    unsafe {
        let nullp: ptr[u8] = nil
        let raw = ar_vec_malloc(totalBytes)
        if raw == nullp {
            return Option.None
        }
        let p = raw as ptr[T]
        let mut i: uint = 0
        while i < total {
            let elemPtr = mem.ptrOffset<T>(p, i as isize)
            mem.ptrWrite<T>(elemPtr, initial)
            i = i + 1
        }
        return Option.Some(Matrix<T> {
            data: p,
            rows: rows,
            cols: cols,
            capacity: total,
        })
    }
}

/// Canonical constructor for `Matrix<T>`; delegates to `Matrix.tryNew`.
public func Matrix.new<T>(rows: uint, cols: uint, initial: T): Option<Matrix<T>> {
    return Matrix.tryNew<T>(rows, cols, initial)
}

/// Allocates a `float` matrix of the given shape with every element zero.
///
/// Returns `None` if allocation fails.
public func Matrix.zeros(rows: uint, cols: uint): Option<Matrix<float>> {
    return Matrix.tryNew<float>(rows, cols, 0.0)
}

/// Returns the number of rows.
public func Matrix.rows<T>(self: ref Matrix<T>): uint {
    return self.rows
}

/// Returns the number of columns.
public func Matrix.cols<T>(self: ref Matrix<T>): uint {
    return self.cols
}

/// Borrows all elements as a shared row-major `ArrayView<T>`.
///
/// This does not copy or allocate. The view borrows the matrix's backing buffer.
public func Matrix.asView<T>(self: ref Matrix<T>): view.ArrayView<T> {
    return unsafe { view.ArrayView.fromRaw<T>(self.data, self.rows, self.cols, self.cols as int, 1) }
}

/// Borrows all elements as an exclusive row-major `ArrayViewMut<T>`.
///
/// This does not copy or allocate. The view borrows the matrix's backing buffer.
public func Matrix.asViewMut<T>(self: mut ref Matrix<T>): view.ArrayViewMut<T> {
    return unsafe { view.ArrayViewMut.fromRaw<T>(self.data, self.rows, self.cols, self.cols as int, 1) }
}

/// Releases the owned buffer automatically when the `Matrix` value is dropped.
@Destructor
func Matrix.destroy<T>(self: own Matrix<T>): void {
    let nullp: ptr[T] = nil
    if self.data != nullp {
        let elemSize = mem.sizeOf<T>()
        let totalBytes = (self.capacity as usize) * elemSize
        unsafe {
            ar_vec_buf_free(self.data as ptr[u8], totalBytes)
        }
    }
}
