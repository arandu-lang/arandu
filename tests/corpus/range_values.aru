module rangeValues

from std.core.range import { Range, RangeInclusive }

// `a..b` and `a..=b` are values: `Range<T>` and `RangeInclusive<T>`, structs
// with `start` and `end`. A loop and a slice index take the literal or a
// value; a literal they use directly is never materialized.

func middle(xs: []int, r: Range<usize>): []int {
    return xs[r]
}

func total(r: RangeInclusive<int>): int {
    let mut sum = 0
    for i in r {
        sum += i
    }
    return sum
}

func window(from: usize): Range<usize> {
    return from..from + 2
}

func main(): int {
    let r = 1..4
    if r.end - r.start != 3 { return 1 }
    let mut sum = 0
    for i in r {
        sum += i
    }
    if sum != 6 { return 2 }
    if total(1..=4) != 10 { return 3 }
    let closed = 2..=3
    if total(closed) != 5 { return 4 }
    let xs = [10, 20, 30, 40, 50]
    let w = window(1)
    let part = xs[w]
    if part.len() != 2 || part[0] != 20 || part[1] != 30 { return 5 }
    if middle(xs, 3..5)[1] != 50 { return 6 }
    // A range value that is not a plain name is evaluated once.
    if xs[window(2)][0] != 30 { return 7 }
    let mut count = 0
    for i in window(7) {
        count += i as int
    }
    if count != 15 { return 8 }
    let inner = xs[1..=3]
    if inner.len() != 3 { return 9 }
    let mut positions: usize = 0
    for i, v in r {
        positions += i + v as usize
    }
    if positions != 9 { return 10 }
    return 0
}
