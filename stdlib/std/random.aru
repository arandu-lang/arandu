//! Fast pseudorandom number generation and operating system entropy.
//!
//! ## Overview
//!
//! `std.random` provides:
//! - `Xoshiro256PlusPlus`: xoshiro256++ seeded with SplitMix64.
//!   Algorithm reference: https://prng.di.unimi.it/xoshiro256plusplus.c
//! - Unbiased integer range sampling using Lemire's method (eliminates modulo bias).
//! - Fallible access to operating system entropy (`fillEntropy`).
//!
//! ## Security
//!
//! `Xoshiro256PlusPlus` is designed for simulations, games, algorithms, and fuzzing;
//! it is **not** a cryptographically secure PRNG (CSPRNG). For cryptographic key
//! generation, use OS entropy directly via `fillEntropy`.
//!
//! ## Examples
//!
//! ```arandu
//! import std.random as random
//!
//! let mut rng = random.Xoshiro256PlusPlus.fromSeed(42 as u64)
//! let n = rng.nextU64()
//! let dice = rng.genRange(1, 6) // [1, 6] inclusive without bias
//! let f = rng.nextFloat()       // [0.0, 1.0)
//! ```
//!
//! ## Platform
//! Native entropy: Unix /dev/urandom and Windows BCryptGenRandom.
//! Wasm host entropy imports are not wired; pure PRNG arithmetic is freestanding.
module std.random

import std.core.intrinsics as intrinsics

import std.core.mem as mem

import std.core.slice as slice

extern "C" {
    func ar_rt_alloc_aligned(size: usize, align: usize): ptr[u8]
    func ar_rt_free_aligned(data: ptr[u8], size: usize, align: usize): void
    /// Fills buffer with hardware entropy from the host OS (/dev/urandom or BCryptGenRandom).
    func ar_rt_get_entropy(buf: ptr[u8], len: usize): int
}

func rotl64(x: u64, k: u64): u64 {
    return (x << k) | (x >> ((64 as u64) - k))
}

/// 64-bit generator used to expand seeds into 256-bit generator state.
struct SplitMix64 {
    state: u64,
}

func SplitMix64.next(self: mut ref SplitMix64): u64 {
    self.state = self.state + (0x9e3779b97f4a7c15 as u64)
    let mut z = self.state
    z = (z ^ (z >> (30 as u64))) * (0xbf58476d1ce4e5b9 as u64)
    z = (z ^ (z >> (27 as u64))) * (0x94d049bb133111eb as u64)
    return z ^ (z >> (31 as u64))
}

/// A general-purpose pseudorandom generator (xoshiro256++).
public struct Xoshiro256PlusPlus {
    s0: u64,
    s1: u64,
    s2: u64,
    s3: u64,
}

/// Creates a generator initialized with a 64-bit seed expanded via SplitMix64.
public func Xoshiro256PlusPlus.fromSeed(seed: u64): Xoshiro256PlusPlus {
    let mut sm = SplitMix64 {
        state: seed,
    }
    let s0 = sm.next()
    let s1 = sm.next()
    let s2 = sm.next()
    let s3 = sm.next()
    return Xoshiro256PlusPlus {
        s0: s0,
        s1: s1,
        s2: s2,
        s3: s3,
    }
}

/// Returns the next pseudorandom 64-bit unsigned integer.
public func Xoshiro256PlusPlus.nextU64(self: mut ref Xoshiro256PlusPlus): u64 {
    let result = rotl64(self.s0 + self.s3, 23 as u64) + self.s0

    let t = self.s1 << (17 as u64)

    self.s2 = self.s2 ^ self.s0
    self.s3 = self.s3 ^ self.s1
    self.s1 = self.s1 ^ self.s2
    self.s0 = self.s0 ^ self.s3

    self.s2 = self.s2 ^ t
    self.s3 = rotl64(self.s3, 45 as u64)

    return result
}

/// Returns the next pseudorandom 32-bit unsigned integer.
public func Xoshiro256PlusPlus.nextU32(self: mut ref Xoshiro256PlusPlus): u32 {
    return (self.nextU64() >> (32 as u64)) as u32
}

/// Returns a float uniformly distributed in `[0.0, 1.0)`.
public func Xoshiro256PlusPlus.nextFloat(self: mut ref Xoshiro256PlusPlus): float {
    // Take the 53 most significant bits of u64 and scale by 2^-53
    let bits = self.nextU64() >> (11 as u64)
    return (bits as float) * (1.0 / 9007199254740992.0)
}

/// Failure to initialize a PRNG from operating system entropy.
public enum EntropyError {
    AllocationFailed,
    Unavailable,
    InvalidState,
}

/// Creates a generator from OS entropy, aborting if initialization fails.
/// Use `tryFromEntropy` to handle failures explicitly.
public func Xoshiro256PlusPlus.fromEntropy(): Xoshiro256PlusPlus {
    match Xoshiro256PlusPlus.tryFromEntropy() {
        Result.Ok(generator) => { return generator }
        Result.Err(_) => { unsafe { intrinsics.abort() } }
    }
    return Xoshiro256PlusPlus.fromSeed(0 as u64)
}

/// Attempts to initialize a generator exclusively from OS entropy.
public func Xoshiro256PlusPlus.tryFromEntropy(): Result<Xoshiro256PlusPlus, EntropyError> {
    unsafe {
        let raw = ar_rt_alloc_aligned(32 as usize, 1 as usize)
        let nullp: ptr[u8] = nil
        if raw != nullp {
            let ret = ar_rt_get_entropy(raw, 32 as usize)
            if ret == 0 {
                let mut s0: u64 = 0 as u64
                let mut s1: u64 = 0 as u64
                let mut s2: u64 = 0 as u64
                let mut s3: u64 = 0 as u64
                let mut i: usize = 0
                while i < 8 {
                    let b0 = mem.ptrRead<u8>(mem.ptrOffset<u8>(raw, i as isize)) as u64
                    let b1 = mem.ptrRead<u8>(mem.ptrOffset<u8>(raw, (i + 8) as isize)) as u64
                    let b2 = mem.ptrRead<u8>(mem.ptrOffset<u8>(raw, (i + 16) as isize)) as u64
                    let b3 = mem.ptrRead<u8>(mem.ptrOffset<u8>(raw, (i + 24) as isize)) as u64
                    let shift = (i * 8) as u64
                    s0 = s0 | (b0 << shift)
                    s1 = s1 | (b1 << shift)
                    s2 = s2 | (b2 << shift)
                    s3 = s3 | (b3 << shift)
                    i = i + 1
                }
                ar_rt_free_aligned(raw, 32 as usize, 1 as usize)
                if s0 != (0 as u64) || s1 != (0 as u64) || s2 != (0 as u64) || s3 != (0 as u64) {
                    return Result.Ok(Xoshiro256PlusPlus { s0: s0, s1: s1, s2: s2, s3: s3 })
                }
                return Result.Err(EntropyError.InvalidState)
            }
            ar_rt_free_aligned(raw, 32 as usize, 1 as usize)
            return Result.Err(EntropyError.Unavailable)
        }
    }
    return Result.Err(EntropyError.AllocationFailed)
}

/// Returns the next pseudorandom boolean value with equal 50% probability.
public func Xoshiro256PlusPlus.nextBool(self: mut ref Xoshiro256PlusPlus): bool {
    return (self.nextU64() & (1 as u64)) == (1 as u64)
}

/// Returns a float uniformly distributed in `[minVal, maxVal)`.
public func Xoshiro256PlusPlus.genRangeFloat(self: mut ref Xoshiro256PlusPlus, minVal: float, maxVal: float): float {
    if minVal >= maxVal {
        return minVal
    }
    return minVal + self.nextFloat() * (maxVal - minVal)
}

/// Fills `dest` with pseudorandom bytes.
public func Xoshiro256PlusPlus.nextBytes(self: mut ref Xoshiro256PlusPlus, dest: mut []u8): void {
    let len = slice.len<u8>(dest)
    let mut i: usize = 0
    while i < len {
        let chunk = self.nextU64()
        let mut b: usize = 0
        while b < 8 && i < len {
            dest[i] = ((chunk >> (((b * 8) as u64))) & (0xff as u64)) as u8
            i = i + 1
            b = b + 1
        }
    }
}

/// Returns a random integer in `[minVal, maxVal]` inclusive, free of modulo bias.
public func Xoshiro256PlusPlus.genRange(self: mut ref Xoshiro256PlusPlus, minVal: int, maxVal: int): int {
    if minVal >= maxVal {
        return minVal
    }
    // Unsigned arithmetic avoids signed overflow, including the full int range.
    let range = (maxVal as u32) - (minVal as u32) + (1 as u32)
    if range == (0 as u32) { return self.nextU32() as int }
    // Lemire's nearly division-free unbiased sampling
    let mut x = self.nextU32()
    let mut m = (x as u64) * (range as u64)
    let mut l = m as u32
    if l < range {
        let threshold = ((0 as u32) - range) % range
        while l < threshold {
            x = self.nextU32()
            m = (x as u64) * (range as u64)
            l = m as u32
        }
    }
    let offset = (m >> (32 as u64)) as u32
    return ((minVal as u32) + offset) as int
}

/// Fills `dest` with operating system entropy from the operating system.
///
/// Returns `true` on success, or `false` if the system entropy source fails.
public func fillEntropy(dest: []u8): bool {
    let len = slice.len<u8>(dest)
    if len == (0 as usize) { return true }
    unsafe {
        let p = slice.asPtr<u8>(dest)
        let ret = ar_rt_get_entropy(p, len)
        return ret == 0
    }
}
